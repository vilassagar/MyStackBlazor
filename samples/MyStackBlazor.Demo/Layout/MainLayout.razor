@namespace MyStackBlazor.Demo.Layout
@inherits LayoutComponentBase
@inject NavigationManager Nav

<StackThemeProvider>
    <!-- Top bar -->
    <header class="fixed top-0 left-0 right-0 z-40 h-14 border-b bg-background/95 backdrop-blur flex items-center px-4 gap-4">
        <button type="button" class="md:hidden p-2 rounded-md hover:bg-accent" @onclick="ToggleSidebar" aria-label="Toggle menu">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
        <a href="" class="flex items-center gap-2 font-bold text-lg">
            <span class="text-primary">MyStack</span><span>Blazor</span>
        </a>
        <div class="flex-1"></div>
        <a href="https://github.com/vilassagar/MyStackBlazor" target="_blank" rel="noopener"
           class="hidden sm:flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
        </a>
        <span class="hidden sm:block text-xs text-muted-foreground bg-muted px-2 py-1 rounded-full">v1.0.1</span>
        <StackThemeToggle />
    </header>

    <!-- Sidebar overlay (mobile) -->
    @if (_sidebarOpen)
    {
        <div class="fixed inset-0 z-30 bg-black/40 md:hidden" @onclick="ToggleSidebar"></div>
    }

    <!-- Sidebar -->
    <aside class="@SidebarClass">
        <NavMenu OnNavigate="CloseSidebar" />
    </aside>

    <!-- Main content -->
    <main class="pt-14 md:pl-60 min-h-screen">
        <div class="max-w-4xl mx-auto px-6 py-8">
            @Body
        </div>
    </main>

    <!-- Toast host -->
    <StackToaster />

    <!-- Confirm dialog host -->
    <StackConfirmDialogHost />
</StackThemeProvider>

@code {
    private bool _sidebarOpen;

    private string SidebarClass =>
        "sidebar fixed left-0 top-14 bottom-0 z-30 w-60 border-r bg-background overflow-y-auto " +
        (_sidebarOpen ? "block" : "hidden md:block");

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;
}
