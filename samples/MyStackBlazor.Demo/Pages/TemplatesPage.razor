@page "/templates"
@inject ToastService Toast

<PageTitle>Templates — MyStackBlazor Demo</PageTitle>

<h1 class="text-3xl font-bold mb-1">Templates</h1>
<p class="text-muted-foreground mb-8">Ready-made Dashboard and E-commerce listing UI blocks — compose them to build full screens.</p>

<!-- ─── DASHBOARD ─────────────────────────────────────────────── -->
<StackTypography Variant="h2" Class="mt-2 mb-4">Dashboard</StackTypography>

<!-- TopNavbar -->
<DemoSection Title="Top Navbar"
             Description="Sticky dashboard header with brand, breadcrumbs, search bar, notification bell, and user avatar."
             Code="@_topNavCode">
    <div class="w-full rounded-xl border overflow-hidden">
        <StackTopNavbar Brand="MyDashboard"
                   ShowSearch
                   UserName="Vilas Sagar"
                   UserInitials="VS"
                   NotificationCount="3"
                   Breadcrumbs="@(new List<NavBreadcrumb>
                   {
                       new("Home",      "#"),
                       new("Analytics", "#"),
                       new("Overview"),
                   })" />
        <div class="px-6 py-4 text-sm text-muted-foreground bg-muted/30">Page content area</div>
    </div>
</DemoSection>

<!-- DashboardSidebar -->
<DemoSection Title="Dashboard Sidebar"
             Description="Fixed-width sidebar with grouped navigation items, active-state highlighting, and a footer slot."
             Code="@_sidebarCode">
    <div class="w-64 rounded-xl border overflow-hidden" style="height:420px">
        <StackDashboardSidebar Brand="MyApp"
                          Groups="@(new Dictionary<string, IList<DashboardNavItem>>
                          {
                              ["Main"] = new List<DashboardNavItem>
                              {
                                  new("Dashboard", "#", IsActive: true),
                                  new("Analytics",  "#"),
                                  new("Reports",    "#"),
                              },
                              ["Settings"] = new List<DashboardNavItem>
                              {
                                  new("Team",     "#"),
                                  new("Billing",  "#"),
                                  new("Security", "#"),
                              }
                          })">
            <FooterContent>
                <div class="px-3 py-2 border-t">
                    <div class="flex items-center gap-2">
                        <StackAvatar Initials="VS" Size="sm" />
                        <div class="text-xs"><p class="font-medium">Vilas Sagar</p><p class="text-muted-foreground">Admin</p></div>
                    </div>
                </div>
            </FooterContent>
        </StackDashboardSidebar>
    </div>
</DemoSection>

<!-- CompactCard -->
<DemoSection Title="Compact Card"
             Description="Small metric card with an icon, value, trend, and optional description."
             Code="@_compactCardCode">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full">
        <StackCompactCard Label="Total revenue"   Value="$45 231"  Trend="+20.1% from last month"  TrendUp />
        <StackCompactCard Label="Subscriptions"   Value="+2 350"   Trend="+180 this week"           TrendUp />
        <StackCompactCard Label="Bounce rate"     Value="24.8%"    Trend="-3.2% this month"         TrendUp="false" />
        <StackCompactCard Label="Active users"    Value="1 284"    Trend="+12% vs last week"         TrendUp />
    </div>
</DemoSection>

<!-- DashboardCard -->
<DemoSection Title="Dashboard Card"
             Description="Larger card with header (title/description/actions), value, trend, and a body slot for charts or tables."
             Code="@_dashCardCode">
    <div class="grid md:grid-cols-2 gap-4 w-full">
        <StackDashboardCard Title="Monthly revenue"
                       Value="$12 450"
                       Description="Recurring subscription income"
                       Trend="+8.2%"
                       TrendUp>
            <BodyContent>
                <div class="h-32 rounded-md bg-muted/40 flex items-center justify-center text-xs text-muted-foreground">[Chart placeholder]</div>
            </BodyContent>
        </StackDashboardCard>
        <StackDashboardCard Title="New sign-ups"
                       Value="348"
                       Description="Accounts created this month"
                       Trend="-4 from last month"
                       TrendUp="false">
            <BodyContent>
                <div class="space-y-2">
                    @foreach (var (label, pct) in new[] { ("Organic", 58), ("Referral", 27), ("Paid", 15) })
                    {
                        <div class="flex items-center gap-2 text-sm">
                            <span class="w-16 text-muted-foreground">@label</span>
                            <StackProgress Value="@pct" Class="flex-1" />
                            <span class="w-8 text-right text-muted-foreground">@pct%</span>
                        </div>
                    }
                </div>
            </BodyContent>
        </StackDashboardCard>
    </div>
</DemoSection>

<!-- ─── LISTING / E-COMMERCE ──────────────────────────────────── -->
<StackSeparator Class="my-8" />
<StackTypography Variant="h2" Class="mb-4">E-Commerce Listing</StackTypography>

<!-- SortBar -->
<DemoSection Title="Sort Bar"
             Description="Result count display, sort dropdown, and grid/list view toggle."
             Code="@_sortBarCode">
    <div class="w-full max-w-2xl">
        <StackSortBar ResultCount="124"
                 SelectedSort="_sortBy"
                 OnSortChanged="s => _sortBy = s"
                 ViewMode="_viewMode"
                 OnViewModeChanged="m => _viewMode = m"
                 ShowViewToggle />
        <p class="text-xs text-muted-foreground mt-2">Sort: <strong>@_sortBy</strong> · View: <strong>@_viewMode</strong></p>
    </div>
</DemoSection>

<!-- FilterPanel -->
<DemoSection Title="Filter Panel"
             Description="Collapsible filter categories with multi-select checkboxes and a clear-all button."
             Code="@_filterCode">
    <div class="w-full max-w-xs">
        <StackFilterPanel Title="Filters"
                     OnFilterChange="HandleFilterChange"
                     Categories="@(new List<FilterCategory>
                     {
                         new("Category", new List<FilterOption>
                         {
                             new("Electronics", "electronics"),
                             new("Clothing",    "clothing"),
                             new("Books",       "books"),
                             new("Sports",      "sports"),
                         }),
                         new("Price range", new List<FilterOption>
                         {
                             new("Under $25",   "under-25"),
                             new("$25 – $100",  "25-100"),
                             new("$100 – $500", "100-500"),
                             new("Over $500",   "over-500"),
                         }),
                         new("Rating", new List<FilterOption>
                         {
                             new("4★ and above", "4plus"),
                             new("3★ and above", "3plus"),
                         }),
                     })" />
        @if (_activeFilters.Count > 0)
        {
            <p class="mt-3 text-xs text-muted-foreground">
                Active: @string.Join(", ", _activeFilters.SelectMany(kv => kv.Value))
            </p>
        }
    </div>
</DemoSection>

<!-- ProductCard -->
<DemoSection Title="Product Card"
             Description="Product tile with image placeholder, star rating, price, stock badge, and Add to Cart callback."
             Code="@_productCardCode">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 w-full max-w-2xl">
        <StackProductCard Item="@(new ProductItem("Wireless Headphones Pro", "$149.99", BadgeText: "New", Rating: 4.7m, ReviewCount: 312, IsInStock: true))"
                     OnAddToCart="@(p => Toast.Show($"{p.Title} added to cart!", "Added", "success"))" />
        <StackProductCard Item="@(new ProductItem("Ergonomic Office Chair", "$349.00", Rating: 4.2m, ReviewCount: 87, IsInStock: true))"
                     OnAddToCart="@(p => Toast.Show($"{p.Title} added to cart!", "Added", "success"))" />
        <StackProductCard Item="@(new ProductItem("Mechanical Keyboard", "$89.00", BadgeText: "Sale", Rating: 4.5m, ReviewCount: 524, IsInStock: false))"
                     OnAddToCart="@(p => Toast.Show($"{p.Title} added to cart!"))" />
    </div>
</DemoSection>

<!-- LoginForm -->
<DemoSection Title="Login Form"
             Description="Full-page login with email/password, forgot password link, and sign-up link."
             Code="@_loginCode">
    <div class="w-full max-w-md mx-auto rounded-xl border overflow-hidden shadow-sm">
        <StackLoginForm Title="Welcome back"
                   Subtitle="Sign in to your MyStackBlazor account"
                   Brand="MyStackBlazor"
                   ButtonText="Sign in"
                   ForgotPasswordHref="#"
                   SignUpHref="#"
                   OnSubmit="@(data => Toast.Show($"Login: {data.Email}", "Signed in!", "success"))" />
    </div>
</DemoSection>

<!-- SignUpForm -->
<DemoSection Title="Sign Up Form"
             Description="Registration form with first/last name, email, password confirmation, and terms links."
             Code="@_signupCode">
    <div class="w-full max-w-md mx-auto rounded-xl border overflow-hidden shadow-sm">
        <StackSignUpForm Title="Create an account"
                    Subtitle="Start building with MyStackBlazor today"
                    Brand="MyStackBlazor"
                    ButtonText="Create account"
                    SuccessMessage="Account created! Check your inbox to verify your email."
                    LoginHref="#"
                    OnSubmit="@(data => Toast.Show($"Account created for {data.Email}!", "Welcome!", "success"))" />
    </div>
</DemoSection>

<!-- FlyoutNavigation -->
<DemoSection Title="Flyout Navigation"
             Description="Mobile drawer navigation with nested categories. Opens from the left."
             Code="@_flyoutCode">
    <StackButton Variant="outline" OnClick="@(() => _flyoutOpen = true)">Open flyout nav</StackButton>

    <StackFlyoutNavigation Brand="MyShop"
                      @bind-IsOpen="_flyoutOpen"
                      Categories="@(new List<NavCategory>
                      {
                          new("Home",    "#"),
                          new("Shop",    "#", new List<BlockLink>
                          {
                              new("Electronics", "#"),
                              new("Clothing",    "#"),
                              new("Books",       "#"),
                          }),
                          new("About",   "#"),
                          new("Contact", "#"),
                      })" />
</DemoSection>

@code {
    private string _sortBy = "featured";
    private string _viewMode = "grid";
    private bool _flyoutOpen;
    private Dictionary<string, HashSet<string>> _activeFilters = new();

    private void HandleFilterChange(Dictionary<string, HashSet<string>> filters)
        => _activeFilters = filters;

    private const string _topNavCode = """
        <StackTopNavbar Brand="MyDashboard"
                   ShowSearch
                   UserName="Vilas Sagar"
                   UserInitials="VS"
                   NotificationCount="3"
                   Breadcrumbs="@(new List<NavBreadcrumb> { new("Overview") })" />
        """;

    private const string _sidebarCode = """
        <StackDashboardSidebar Brand="MyApp"
                          Groups="@(new Dictionary<string, IList<DashboardNavItem>>
                          {
                              ["Main"] = new List<DashboardNavItem>
                              {
                                  new("Dashboard", "#", IsActive: true),
                                  new("Analytics",  "#"),
                              }
                          })" />
        """;

    private const string _compactCardCode = """
        <StackCompactCard Label="Total revenue"
                     Value="$45 231"
                     Trend="+20.1% from last month"
                     TrendUp />
        """;

    private const string _dashCardCode = """
        <StackDashboardCard Title="Monthly revenue"
                       Value="$12 450"
                       Description="Recurring income"
                       Trend="+8.2%"
                       TrendUp>
            <BodyContent><!-- chart or table --></BodyContent>
        </StackDashboardCard>
        """;

    private const string _sortBarCode = """
        <StackSortBar ResultCount="124"
                 SelectedSort="_sort"
                 OnSortChanged="s => _sort = s"
                 ViewMode="_view"
                 OnViewModeChanged="m => _view = m"
                 ShowViewToggle />
        """;

    private const string _filterCode = """
        <StackFilterPanel Title="Filters"
                     OnFilterChange="HandleFilterChange"
                     Categories="@(new List<FilterCategory>
                     {
                         new("Category", new List<FilterOption>
                         {
                             new("Electronics", "electronics"),
                             new("Clothing",    "clothing"),
                         }),
                     })" />
        """;

    private const string _productCardCode = """
        <StackProductCard Item="@(new ProductItem("Wireless Headphones Pro", "$149.99",
                         BadgeText: "New", Rating: 4.7m, ReviewCount: 312, IsInStock: true))"
                     OnAddToCart="p => Toast.Show($"{p.Title} added to cart!")" />
        """;

    private const string _loginCode = """
        <StackLoginForm Title="Welcome back"
                   Brand="MyApp"
                   ForgotPasswordHref="/forgot"
                   SignUpHref="/register"
                   OnSubmit="data => HandleLogin(data.Email, data.Password)" />
        """;

    private const string _signupCode = """
        <StackSignUpForm Title="Create an account"
                    Brand="MyApp"
                    SuccessMessage="Check your inbox to verify."
                    LoginHref="/login"
                    OnSubmit="data => HandleSignUp(data)" />
        """;

    private const string _flyoutCode = """
        <StackButton OnClick="@(() => _open = true)">Open menu</StackButton>
        <StackFlyoutNavigation Brand="MyShop"
                          @bind-IsOpen="_open"
                          Categories="@(new List<NavCategory>
                          {
                              new("Home", "#"),
                              new("Shop", "#", new List<BlockLink>
                              {
                                  new("Electronics", "#"),
                                  new("Clothing",    "#"),
                              }),
                          })" />
        """;
}
