@page "/"

<PageTitle>MyStackBlazor — Blazor Component Library</PageTitle>

<!-- Hero -->
<div class="mb-12">
    <div class="flex items-center gap-2 mb-4">
        <StackBadge>New</StackBadge>
        <span class="text-sm text-muted-foreground">v1.0.1 now available on NuGet</span>
    </div>
    <h1 class="text-4xl font-bold tracking-tight mb-4">
        Build beautiful Blazor apps<br />
        <span class="text-primary">faster than ever</span>
    </h1>
    <p class="text-lg text-muted-foreground max-w-2xl mb-6">
        70+ accessible, customizable components for Blazor WASM, Blazor Server, and .NET MAUI.
        Styled with Tailwind CSS v4, built for .NET 10.
    </p>
    <div class="demo-row">
        <StackButton Variant="default" OnClick="@(_ => {})">Get Started</StackButton>
        <StackButton Variant="outline" OnClick="@(_ => {})">View on GitHub</StackButton>
    </div>
</div>

<!-- Install -->
<StackCard Class="mb-10">
    <StackCardHeader>
        <StackCardTitle>Quick Install</StackCardTitle>
        <StackCardDescription>Add to your Blazor project in seconds.</StackCardDescription>
    </StackCardHeader>
    <StackCardContent>
        <pre class="bg-muted rounded-md px-4 py-3 text-sm overflow-x-auto"><code>dotnet add package MyStackBlazor</code></pre>
        <p class="text-sm text-muted-foreground mt-3">Then register services in <code class="bg-muted px-1 rounded">Program.cs</code>:</p>
        <pre class="bg-muted rounded-md px-4 py-3 text-sm overflow-x-auto mt-2"><code>builder.Services.AddMyStackBlazor();</code></pre>
        <p class="text-sm text-muted-foreground mt-3">Add the stylesheet to <code class="bg-muted px-1 rounded">index.html</code> / <code class="bg-muted px-1 rounded">App.razor</code>:</p>
        <pre class="bg-muted rounded-md px-4 py-3 text-sm overflow-x-auto mt-2"><code>&lt;link rel="stylesheet" href="_content/MyStackBlazor/css/mystackblazor.css" /&gt;
&lt;script src="_content/MyStackBlazor/js/mystackblazor.js"&gt;&lt;/script&gt;</code></pre>
    </StackCardContent>
</StackCard>

<!-- Feature grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
    @foreach (var f in _features)
    {
        <div class="rounded-lg border bg-card p-5">
            <div class="text-2xl mb-2">@f.Icon</div>
            <h3 class="font-semibold mb-1">@f.Title</h3>
            <p class="text-sm text-muted-foreground">@f.Body</p>
        </div>
    }
</div>

<!-- Component preview strip -->
<div class="mb-8">
    <h2 class="text-2xl font-bold mb-4">Component Preview</h2>
    <StackCard>
        <StackCardContent Class="pt-6">
            <div class="demo-row mb-4">
                <StackButton Variant="default">Default</StackButton>
                <StackButton Variant="secondary">Secondary</StackButton>
                <StackButton Variant="outline">Outline</StackButton>
                <StackButton Variant="destructive">Destructive</StackButton>
                <StackButton Variant="ghost">Ghost</StackButton>
            </div>
            <div class="demo-row mb-4">
                <StackBadge>Default</StackBadge>
                <StackBadge Variant="secondary">Secondary</StackBadge>
                <StackBadge Variant="destructive">Destructive</StackBadge>
                <StackBadge Variant="outline">Outline</StackBadge>
                <StackAvatar Initials="VS" Size="sm" />
                <StackAvatar Initials="AB" Size="sm" />
                <StackSpinner Size="sm" />
            </div>
            <div class="demo-row">
                <StackAlert Class="w-full">
                    <StackAlertTitle>Heads up!</StackAlertTitle>
                    <StackAlertDescription>You can explore all components using the sidebar navigation.</StackAlertDescription>
                </StackAlert>
            </div>
        </StackCardContent>
    </StackCard>
</div>

@code {
    private record Feature(string Icon, string Title, string Body);

    private readonly Feature[] _features =
    [
        new("🎨", "Tailwind CSS v4",     "All components styled with Tailwind CSS design tokens. Full light/dark/system theme support."),
        new("♿", "Accessible",          "ARIA roles, keyboard navigation, focus management, and screen reader support built in."),
        new("📦", "Multi-package",       "Install only what you need: Core, Security, DataGrid, Accessibility, Localization."),
        new("🚀", ".NET 10",             "Targets net10.0. Works with Blazor WASM, Blazor Server, and .NET MAUI Blazor Hybrid."),
        new("🔒", "Security",            "XSS sanitization, token providers, and secure component patterns via MyStackBlazor.Security."),
        new("📊", "Enterprise DataGrid", "Virtualized data grid with sort, filter, search, and Excel export via MyStackBlazor.DataGrid."),
    ];
}
