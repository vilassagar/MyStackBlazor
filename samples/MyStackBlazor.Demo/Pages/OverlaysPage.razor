@page "/overlays"
@inject ToastService Toast

<PageTitle>Overlays — MyStackBlazor Demo</PageTitle>

<h1 class="text-3xl font-bold mb-1">Overlays</h1>
<p class="text-muted-foreground mb-8">Sheet, drawer, popover, tooltip, hover card, window, and popup.</p>

<!-- Tooltip -->
<DemoSection Title="Tooltip"
             Description="Appears on hover. Use Text for simple labels, Content for rich markup. Side controls placement."
             Code="@_tooltipCode">
    <div class="flex flex-wrap gap-6">
        <StackTooltip Text="This is a tooltip" Side="top">
            <StackButton Variant="outline" Size="sm">Hover me (top)</StackButton>
        </StackTooltip>
        <StackTooltip Text="Appears below" Side="bottom">
            <StackButton Variant="outline" Size="sm">Hover me (bottom)</StackButton>
        </StackTooltip>
        <StackTooltip Side="right">
            <ChildContent>
                <StackButton Variant="outline" Size="sm">Rich tooltip →</StackButton>
            </ChildContent>
            <Content>
                <div class="space-y-1">
                    <p class="font-medium text-xs">Keyboard shortcut</p>
                    <p class="text-xs text-muted-foreground">Press <kbd class="bg-muted px-1 rounded text-xs">⌘K</kbd> to open command palette</p>
                </div>
            </Content>
        </StackTooltip>
    </div>
</DemoSection>

<!-- Popover -->
<DemoSection Title="Popover"
             Description="Click-triggered floating panel with arbitrary content. Closes when clicking outside."
             Code="@_popoverCode">
    <div class="flex flex-wrap gap-4">
        <StackPopover>
            <Trigger>
                <StackButton Variant="outline">Open popover</StackButton>
            </Trigger>
            <Content>
                <div class="space-y-3 p-1">
                    <p class="text-sm font-semibold">Notification settings</p>
                    <div class="space-y-2">
                        <StackSwitch Id="pop-email" Label="Email notifications" Checked />
                        <StackSwitch Id="pop-push" Label="Push notifications" />
                        <StackSwitch Id="pop-sms" Label="SMS alerts" />
                    </div>
                    <StackButton Size="sm" Class="w-full">Save</StackButton>
                </div>
            </Content>
        </StackPopover>

        <StackPopover Align="end">
            <Trigger>
                <StackButton Variant="ghost" Size="icon" AriaLabel="Filter options">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                    </svg>
                </StackButton>
            </Trigger>
            <Content>
                <div class="p-1 space-y-1 text-sm">
                    <p class="font-semibold mb-2">Filter by status</p>
                    <label class="flex items-center gap-2"><input type="checkbox" class="rounded" /> Active</label>
                    <label class="flex items-center gap-2"><input type="checkbox" class="rounded" /> Inactive</label>
                    <label class="flex items-center gap-2"><input type="checkbox" class="rounded" /> Pending</label>
                </div>
            </Content>
        </StackPopover>
    </div>
</DemoSection>

<!-- HoverCard -->
<DemoSection Title="Hover Card"
             Description="Richer preview card that appears on hover. Great for user/link previews."
             Code="@_hoverCardCode">
    <div class="flex flex-wrap gap-6">
        <StackHoverCard>
            <Trigger>
                <a href="#" class="text-sm font-medium underline underline-offset-4 text-primary" @onclick:preventDefault>
                    @@vilas_sagar
                </a>
            </Trigger>
            <Content>
                <div class="flex gap-3 p-1">
                    <StackAvatar Initials="VS" Size="lg" />
                    <div>
                        <p class="text-sm font-semibold">Vilas Sagar</p>
                        <p class="text-xs text-muted-foreground">Lead Engineer · MyStackBlazor</p>
                        <p class="text-xs text-muted-foreground mt-1">Building modern Blazor component libraries.</p>
                    </div>
                </div>
            </Content>
        </StackHoverCard>

        <StackHoverCard>
            <Trigger>
                <StackBadge Variant="outline" Class="cursor-default">MyStackBlazor v1.0</StackBadge>
            </Trigger>
            <Content>
                <div class="p-1 space-y-1">
                    <p class="text-sm font-semibold">Release notes</p>
                    <p class="text-xs text-muted-foreground">100+ components · Tailwind CSS v4 · .NET 10</p>
                    <StackBadge Variant="secondary" Class="text-xs">Stable</StackBadge>
                </div>
            </Content>
        </StackHoverCard>
    </div>
</DemoSection>

<!-- Sheet -->
<DemoSection Title="Sheet"
             Description="Slides in from a side of the screen. Use Side to control direction."
             Code="@_sheetCode">
    <div class="flex flex-wrap gap-3">
        <StackButton Variant="outline" OnClick="@(() => _sheetRight = true)">Open right sheet</StackButton>
        <StackButton Variant="outline" OnClick="@(() => _sheetLeft = true)">Open left sheet</StackButton>
        <StackButton Variant="outline" OnClick="@(() => _sheetBottom = true)">Open bottom sheet</StackButton>
    </div>

    <StackSheet @bind-IsOpen="_sheetRight" Side="right">
        <div class="p-6 space-y-4">
            <h3 class="text-lg font-semibold">Edit settings</h3>
            <p class="text-sm text-muted-foreground">Make changes to your account here.</p>
            <div class="space-y-3">
                <StackFormField Label="Display name" For="sh-name">
                    <StackInput Id="sh-name" Placeholder="Vilas Sagar" />
                </StackFormField>
                <StackFormField Label="Role" For="sh-role">
                    <StackSelect Id="sh-role" Placeholder="Select role">
                        <option value="admin">Admin</option>
                        <option value="editor">Editor</option>
                        <option value="viewer">Viewer</option>
                    </StackSelect>
                </StackFormField>
            </div>
            <StackButton Class="w-full" OnClick="@(() => { _sheetRight = false; Toast.Show("Settings saved."); })">Save changes</StackButton>
        </div>
    </StackSheet>

    <StackSheet @bind-IsOpen="_sheetLeft" Side="left">
        <div class="p-6 space-y-4">
            <h3 class="text-lg font-semibold">Navigation</h3>
            <nav class="space-y-1">
                @foreach (var item in new[] { "Dashboard", "Analytics", "Reports", "Settings" })
                {
                    <button class="w-full text-left px-3 py-2 text-sm rounded-md hover:bg-muted transition-colors"
                            @onclick="@(() => { _sheetLeft = false; Toast.Show($"{item} clicked"); })">
                        @item
                    </button>
                }
            </nav>
        </div>
    </StackSheet>

    <StackSheet @bind-IsOpen="_sheetBottom" Side="bottom">
        <div class="p-6 space-y-4">
            <h3 class="text-lg font-semibold">Share this item</h3>
            <div class="flex gap-3">
                <StackButton Variant="outline" Class="flex-1" OnClick="@(() => { _sheetBottom = false; Toast.Show("Copied to clipboard!"); })">Copy link</StackButton>
                <StackButton Class="flex-1" OnClick="@(() => { _sheetBottom = false; Toast.Show("Shared!"); })">Share</StackButton>
            </div>
        </div>
    </StackSheet>
</DemoSection>

<!-- Drawer -->
<DemoSection Title="Drawer"
             Description="Bottom drawer with a handle bar. Ideal for mobile action sheets."
             Code="@_drawerCode">
    <StackButton Variant="outline" OnClick="@(() => _drawerOpen = true)">Open drawer</StackButton>

    <StackDrawer @bind-IsOpen="_drawerOpen">
        <div class="p-6 space-y-4">
            <h3 class="text-lg font-semibold">Quick actions</h3>
            <div class="grid grid-cols-2 gap-3">
                @foreach (var action in new[] { ("New item", "default"), ("Duplicate", "outline"), ("Archive", "outline"), ("Delete", "destructive") })
                {
                    <StackButton Variant="@action.Item2"
                            OnClick="@(() => { _drawerOpen = false; Toast.Show($"{action.Item1} triggered."); })">
                        @action.Item1
                    </StackButton>
                }
            </div>
        </div>
    </StackDrawer>
</DemoSection>

<!-- Window -->
<DemoSection Title="Window"
             Description="Modal window with title bar, scrollable content, and footer. Use Width (sm/md/lg/xl/full)."
             Code="@_windowCode">
    <div class="flex flex-wrap gap-3">
        <StackButton OnClick="@(() => _windowOpen = true)">Open window</StackButton>
        <StackButton Variant="outline" OnClick="@(() => _windowLg = true)">Large window</StackButton>
    </div>

    <StackWindow @bind-IsOpen="_windowOpen"
            Title="Create new project"
            Width="md">
        <ChildContent>
            <div class="space-y-4">
                <StackFormField Label="Project name" For="win-name" Required>
                    <StackInput Id="win-name" Placeholder="my-blazor-app" />
                </StackFormField>
                <StackFormField Label="Template" For="win-tmpl">
                    <StackSelect Id="win-tmpl" Placeholder="Choose template">
                        <option value="blank">Blank</option>
                        <option value="wasm">Blazor WASM</option>
                        <option value="server">Blazor Server</option>
                    </StackSelect>
                </StackFormField>
                <StackSwitch Label="Initialize with git" Checked />
            </div>
        </ChildContent>
        <FooterContent>
            <div class="flex justify-end gap-2">
                <StackButton Variant="outline" OnClick="@(() => _windowOpen = false)">Cancel</StackButton>
                <StackButton OnClick="@(() => { _windowOpen = false; Toast.Show("Project created!", "Success", "success"); })">Create</StackButton>
            </div>
        </FooterContent>
    </StackWindow>

    <StackWindow @bind-IsOpen="_windowLg"
            Title="Data preview"
            Width="lg">
        <ChildContent>
            <StackScrollArea MaxHeight="300px">
                @for (int i = 1; i <= 30; i++)
                {
                    <div class="py-2 border-b border-border/50 text-sm">Row @i — sample data content</div>
                }
            </StackScrollArea>
        </ChildContent>
        <FooterContent>
            <div class="flex justify-end">
                <StackButton Variant="outline" OnClick="@(() => _windowLg = false)">Close</StackButton>
            </div>
        </FooterContent>
    </StackWindow>
</DemoSection>

<!-- Popup -->
<DemoSection Title="Popup"
             Description="Lightweight positioned popup relative to an anchor element."
             Code="@_popupCode">
    <div class="flex flex-wrap gap-4">
        <StackPopup Placement="bottom" Align="start">
            <Anchor>
                <StackButton Variant="outline">Bottom start</StackButton>
            </Anchor>
            <Content>
                <div class="p-3 text-sm space-y-1">
                    <p class="font-medium">Quick options</p>
                    <button class="block w-full text-left px-2 py-1 rounded hover:bg-muted text-sm" @onclick="@(() => Toast.Show("Edit"))">Edit</button>
                    <button class="block w-full text-left px-2 py-1 rounded hover:bg-muted text-sm" @onclick="@(() => Toast.Show("Duplicate"))">Duplicate</button>
                    <button class="block w-full text-left px-2 py-1 rounded hover:bg-muted text-sm text-destructive" @onclick="@(() => Toast.Show("Deleted"))">Delete</button>
                </div>
            </Content>
        </StackPopup>

        <StackPopup Placement="top" Align="center">
            <Anchor>
                <StackButton Variant="ghost">Top center</StackButton>
            </Anchor>
            <Content>
                <div class="p-2 text-xs text-muted-foreground">This popup appears above</div>
            </Content>
        </StackPopup>
    </div>
</DemoSection>

<!-- Command -->
<DemoSection Title="Command"
             Description="Searchable command palette. Type to filter items. Use CommandGroup to organise, CommandItem for actions, CommandEmpty as the no-results fallback."
             Code="@_commandCode">
    <div class="flex flex-wrap gap-8 items-start">
        <div>
            <p class="text-xs text-muted-foreground mb-2 font-medium">Small</p>
            <StackCommand Size="sm">
                <StackCommandInput Placeholder="Search..." />
                <StackCommandList>
                    <StackCommandGroup Heading="Files">
                        <StackCommandItem Value="readme" Label="README">README.md</StackCommandItem>
                        <StackCommandItem Value="index" Label="Index">index.html</StackCommandItem>
                    </StackCommandGroup>
                    <StackCommandEmpty />
                </StackCommandList>
            </StackCommand>
        </div>
        <div>
            <p class="text-xs text-muted-foreground mb-2 font-medium">Medium (default)</p>
            <StackCommand>
                <StackCommandInput Placeholder="Type a command or search..." />
                <StackCommandList>
                    <StackCommandGroup Heading="Suggestions">
                        <StackCommandItem Value="calendar" Label="Calendar" Shortcut="⌘C">Calendar</StackCommandItem>
                        <StackCommandItem Value="search" Label="Search Emoji" Shortcut="⌘E">Search Emoji</StackCommandItem>
                        <StackCommandItem Value="calculator" Label="Calculator" Shortcut="⌘R">Calculator</StackCommandItem>
                    </StackCommandGroup>
                    <StackCommandGroup Heading="Settings">
                        <StackCommandItem Value="profile" Label="Profile" Shortcut="⌘P">Profile</StackCommandItem>
                        <StackCommandItem Value="billing" Label="Billing" Shortcut="⌘B">Billing</StackCommandItem>
                        <StackCommandItem Value="settings" Label="Settings" Shortcut="⌘S">Settings</StackCommandItem>
                    </StackCommandGroup>
                    <StackCommandEmpty />
                </StackCommandList>
            </StackCommand>
        </div>
        <div>
            <p class="text-xs text-muted-foreground mb-2 font-medium">Large</p>
            <StackCommand Size="lg">
                <StackCommandInput Placeholder="Type a command or search..." />
                <StackCommandList>
                    <StackCommandGroup Heading="Actions">
                        <StackCommandItem Value="new-project" Label="New Project">New Project</StackCommandItem>
                        <StackCommandItem Value="open-repo" Label="Open Repository">Open Repository</StackCommandItem>
                        <StackCommandItem Value="deploy" Label="Deploy to production" Disabled>Deploy to production</StackCommandItem>
                    </StackCommandGroup>
                    <StackCommandEmpty>No commands matched your search.</StackCommandEmpty>
                </StackCommandList>
            </StackCommand>
        </div>
    </div>
</DemoSection>

@code {
    private bool _sheetRight;
    private bool _sheetLeft;
    private bool _sheetBottom;
    private bool _drawerOpen;
    private bool _windowOpen;
    private bool _windowLg;

    private const string _tooltipCode = """
        <StackTooltip Text="Simple label" Side="top">
            <StackButton>Hover me</StackButton>
        </StackTooltip>
        <StackTooltip Side="right">
            <StackButton>Rich tooltip</StackButton>
            <Content><p>Rich <strong>HTML</strong> content</p></Content>
        </StackTooltip>
        """;

    private const string _popoverCode = """
        <StackPopover>
            <Trigger><StackButton>Open popover</StackButton></Trigger>
            <Content>
                <StackSwitch Label="Email notifications" />
                <StackSwitch Label="Push notifications" />
                <StackButton Size="sm">Save</StackButton>
            </Content>
        </StackPopover>
        """;

    private const string _hoverCardCode = """
        <StackHoverCard>
            <Trigger><a href="#">@@username</a></Trigger>
            <Content>
                <StackAvatar Initials="VS" />
                <p>Vilas Sagar — Lead Engineer</p>
            </Content>
        </StackHoverCard>
        """;

    private const string _sheetCode = """
        <StackButton OnClick="@(() => _open = true)">Open sheet</StackButton>
        <StackSheet @bind-IsOpen="_open" Side="right">
            <div class="p-6">
                <h3>Edit settings</h3>
                <StackInput Placeholder="Name" />
                <StackButton OnClick="@(() => _open = false)">Save</StackButton>
            </div>
        </StackSheet>
        """;

    private const string _drawerCode = """
        <StackButton OnClick="@(() => _open = true)">Open drawer</StackButton>
        <StackDrawer @bind-IsOpen="_open">
            <div class="p-6">
                <h3>Quick actions</h3>
                <StackButton>New item</StackButton>
                <StackButton Variant="destructive">Delete</StackButton>
            </div>
        </StackDrawer>
        """;

    private const string _windowCode = """
        <StackWindow @bind-IsOpen="_open" Title="Create project" Width="md">
            <StackInput Placeholder="Project name" />
            <FooterContent>
                <StackButton OnClick="@(() => _open = false)">Cancel</StackButton>
                <StackButton>Create</StackButton>
            </FooterContent>
        </StackWindow>
        """;

    private const string _popupCode = """
        <StackPopup Placement="bottom" Align="start">
            <Anchor><StackButton>Trigger</StackButton></Anchor>
            <Content>
                <div class="p-2">
                    <button>Edit</button>
                    <button>Delete</button>
                </div>
            </Content>
        </StackPopup>
        """;

    private const string _commandCode = """
        <StackCommand>
            <StackCommandInput Placeholder="Type a command or search..." />
            <StackCommandList>
                <StackCommandGroup Heading="Suggestions">
                    <StackCommandItem Value="calendar" Label="Calendar" Shortcut="⌘C">Calendar</StackCommandItem>
                    <StackCommandItem Value="search"   Label="Search"   Shortcut="⌘E">Search Emoji</StackCommandItem>
                </StackCommandGroup>
                <StackCommandEmpty />
            </StackCommandList>
        </StackCommand>
        """;
}
