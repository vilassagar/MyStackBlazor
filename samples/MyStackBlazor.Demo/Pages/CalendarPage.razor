@page "/calendar"

<PageTitle>Calendar — MyStackBlazor Demo</PageTitle>

<h1 class="text-3xl font-bold mb-1">Calendar</h1>
<p class="text-muted-foreground mb-6">
    Full-featured personal calendar with Month, Week, and Day views. Click any day to add an event,
    click an event to view or edit details.
</p>

<!-- Feature chips -->
<div class="mb-6 flex flex-wrap gap-2">
    @foreach (var f in new[] { "Month / Week / Day views", "Drag-click to add", "Edit & delete events", "Multi-day spanning events", "All-day events", "9 event colors", "Mini calendar sidebar", "Current-time indicator" })
    {
        <span class="rounded-full border px-3 py-1 text-xs font-medium text-muted-foreground">@f</span>
    }
</div>

<!-- Calendar component -->
<div class="h-[780px] rounded-xl border overflow-hidden shadow-sm">
    <MsCalendar Events="_events"
                ShowMiniCalendar="true"
                AllowAdd="true"
                DefaultView="CalendarViewMode.Month"
                OnEventAdd="HandleAdd"
                OnEventEdit="HandleEdit"
                OnEventDelete="HandleDelete" />
</div>

<!-- Event log -->
@if (_log.Count > 0)
{
    <div class="mt-4 rounded-lg border bg-muted/30 p-4">
        <p class="mb-2 text-sm font-semibold">Recent actions</p>
        <div class="space-y-1">
            @foreach (var msg in _log.AsEnumerable().Reverse().Take(5))
            {
                <p class="text-xs text-muted-foreground">@msg</p>
            }
        </div>
    </div>
}

<!-- Code snippet -->
<DemoSection Title="Usage" Description="Basic setup — pass a list of CalendarEvent objects and handle callbacks." Code="@_code" Class="mt-8">
    <p class="text-sm text-muted-foreground">See the source of CalendarPage.razor for a full working example with sample events.</p>
</DemoSection>

