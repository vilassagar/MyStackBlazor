    private void AddEvent(string title, DateTime start, DateTime end,
        bool allDay = false, string color = "blue",
        string? category = null, string? location = null, string? description = null)
    {
        _events.Add(new CalendarEvent
        {
            Title       = title,
            Start       = start,
            End         = end,
            AllDay      = allDay,
            Color       = color,
            Category    = category,
            Location    = location,
            Description = description,
        });
    }

    private void HandleAdd(CalendarEvent e)
        => _log.Add($"Added \"{e.Title}\" on {e.Start:MMM d}");

    private void HandleEdit(CalendarEvent e)
        => _log.Add($"Updated \"{e.Title}\"");

    private void HandleDelete(CalendarEvent e)
        => _log.Add($"Deleted \"{e.Title}\"");

    private static DateTime ThisMonday(DateTime d)
    {
        var diff = ((int)d.DayOfWeek + 6) % 7;
        return d.AddDays(-diff).Date;
    }

    private static DateTime NextSaturday(DateTime d)
    {
        var daysUntil = ((int)DayOfWeek.Saturday - (int)d.DayOfWeek + 7) % 7;
        return d.AddDays(daysUntil == 0 ? 7 : daysUntil).Date;
    }

    private static DateTime FirstOfNextMonth(DateTime d)
        => new DateTime(d.Year, d.Month, 1).AddMonths(1);

    private const string _code = """
        <!-- Basic usage -->
        <div class="h-[700px] rounded-xl border overflow-hidden">
            <MsCalendar Events="_myEvents"
                        ShowMiniCalendar="true"
                        AllowAdd="true"
                        DefaultView="CalendarViewMode.Month"
                        OnEventAdd="e => _myEvents.Add(e)"
                        OnEventEdit="HandleEdit"
                        OnEventDelete="e => _myEvents.Remove(e)" />
        </div>

        @code {
            private List<CalendarEvent> _myEvents =
            [
                new CalendarEvent
                {
                    Title    = "Team Standup",
                    Start    = DateTime.Today.AddHours(9).AddMinutes(30),
