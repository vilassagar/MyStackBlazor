@page "/calendar"

<PageTitle>Calendar — MyStackBlazor Demo</PageTitle>

<h1 class="text-3xl font-bold mb-1">Calendar</h1>
<p class="text-muted-foreground mb-6">
    Full-featured calendar from the separate <code>MyStackBlazor.Calendar</code> package.
    Day, Week, <strong>Work Week</strong>, Month, Year, Agenda, and Timeline views.
    Recurring events, multi-person calendars, category filter, live search, and add/edit/delete.
</p>

<!-- Feature chips -->
<div class="mb-6 flex flex-wrap gap-2">
    @foreach (var f in new[]
    {
        "Day / Week / Work Week / Month / Year / Agenda / Timeline",
        "Individual & Department focus modes",
        "People/calendar checkboxes", "Category sidebar filter", "Live search",
        "Recurring events (Daily/Weekly/Monthly/Yearly)",
        "Multi-day spanning events", "All-day events",
        "Click to add", "Edit & delete",
        "Assignee calendar field", "Current-time indicator",
        "Separate NuGet package — install only what you need"
    })
    {
        <span class="rounded-full border px-3 py-1 text-xs font-medium text-muted-foreground">@f</span>
    }
</div>

<!-- Calendar component from MyStackBlazor.Calendar package -->
<div class="h-[860px] rounded-xl border overflow-hidden shadow-sm">
    <StackCalendar Events="_events"
                   People="_people"
                   ShowMiniCalendar="true"
                   AllowAdd="true"
                   DefaultView="MyStackBlazor.Calendar.Models.CalendarViewMode.Month"
                   DefaultFocus="MyStackBlazor.Calendar.Models.FocusMode.Department"
                   OnEventAdd="HandleAdd"
                   OnEventEdit="HandleEdit"
                   OnEventDelete="HandleDelete" />
</div>

<!-- Event log -->
@if (_log.Count > 0)
{
    <div class="mt-4 rounded-lg border bg-muted/30 p-4">
        <p class="mb-2 text-sm font-semibold">Recent actions</p>
        <div class="space-y-1">
            @foreach (var msg in _log.AsEnumerable().Reverse().Take(5))
            {
                <p class="text-xs text-muted-foreground">@msg</p>
            }
        </div>
    </div>
}

<!-- Code snippet -->
<DemoSection Title="Usage" Description="Install MyStackBlazor.Calendar from NuGet. Pass a list of CalendarEvent and optionally CalendarPerson for multi-calendar support." Code="@_code" Class="mt-8">
    <p class="text-sm text-muted-foreground">See CalendarPage.razor for the full working example.</p>
</DemoSection>

@code {
    // ── People (team calendars) ────────────────────────────────────────────
    private readonly MyStackBlazor.Calendar.Models.CalendarPerson _alice  = new() { Id = "alice",  Name = "Alice Chen",    Color = "blue"   };
    private readonly MyStackBlazor.Calendar.Models.CalendarPerson _bob    = new() { Id = "bob",    Name = "Sam Rivera",    Color = "green"  };
    private readonly MyStackBlazor.Calendar.Models.CalendarPerson _carol  = new() { Id = "carol",  Name = "Taylor Blake",  Color = "orange" };
    private readonly MyStackBlazor.Calendar.Models.CalendarPerson _dave   = new() { Id = "dave",   Name = "Casey Wright",  Color = "purple" };
    private readonly MyStackBlazor.Calendar.Models.CalendarPerson _eve    = new() { Id = "eve",    Name = "Jayce Li",      Color = "yellow" };

    private List<MyStackBlazor.Calendar.Models.CalendarPerson> _people = [];
    private List<MyStackBlazor.Calendar.Models.CalendarEvent>  _events = [];
    private readonly List<string> _log = [];

    private static readonly DateTime _today      = DateTime.Today;
    private static readonly DateTime _monday     = ThisMonday(DateTime.Today);
    private static readonly DateTime _nextSat    = NextSaturday(DateTime.Today);
    private static readonly DateTime _nextMonth1 = FirstOfNextMonth(DateTime.Today);

    protected override void OnInitialized()
    {
        _people = [_alice, _bob, _carol, _dave, _eve];

        // ── My Calendar (no PersonId) ──────────────────────────────────────
        AddEvent("Daily Stand-up",
            _monday.AddHours(9).AddMinutes(30), _monday.AddHours(9).AddMinutes(45),
            color: "blue", category: "Work", location: "Google Meet",
            recurrenceType: MyStackBlazor.Calendar.Models.RecurrenceType.Weekly, recurrenceInterval: 1,
            recurrenceEndDate: _today.AddMonths(3));

        AddEvent("Manager 1:1",
            new DateTime(_today.Year, _today.Month, 15).AddHours(14),
            new DateTime(_today.Year, _today.Month, 15).AddHours(15),
            color: "purple", category: "Work",
            description: "Monthly check-in.",
            recurrenceType: MyStackBlazor.Calendar.Models.RecurrenceType.Monthly, recurrenceInterval: 1,
            recurrenceEndDate: _today.AddYears(1));

        AddEvent("Gym Session",
            _today.Date.AddHours(7), _today.Date.AddHours(8).AddMinutes(30),
            color: "teal", category: "Health", location: "FitLife Gym",
            recurrenceType: MyStackBlazor.Calendar.Models.RecurrenceType.Daily, recurrenceInterval: 2,
            recurrenceEndDate: _today.AddMonths(3));

        AddEvent("Sprint Planning",
            _monday.AddHours(10), _monday.AddHours(12),
            color: "indigo", category: "Work",
            description: "Q3 sprint kick-off. Bring your backlog items.");

        AddEvent("Mom's Birthday",
            _today.AddDays(5).Date, _today.AddDays(5).Date,
            allDay: true, color: "pink", category: "Family",
            description: "Order cake from Bakery Town.");

        AddEvent("Weekend Getaway — Coorg",
            _nextSat, _nextSat.AddDays(1),
            allDay: true, color: "purple", category: "Personal",
            description: "2-day trip. Hotel: Rainforest Retreat.");

        AddEvent("Pay Rent",
            _nextMonth1, _nextMonth1,
            allDay: true, color: "yellow", category: "Reminder",
            description: "Transfer ₹25,000 to landlord before 5 PM.",
            recurrenceType: MyStackBlazor.Calendar.Models.RecurrenceType.Monthly, recurrenceInterval: 1);

        // ── Alice's events ─────────────────────────────────────────────────
        AddEvent("Annual Engineering Kickoff",
            _monday.AddDays(13).Date, _monday.AddDays(15).Date,
            allDay: true, color: "blue", category: "Work",
            personId: _alice.Id, description: "3-day company-wide kick-off.");

        AddEvent("Design System Summit",
            _monday.AddDays(3).AddHours(10), _monday.AddDays(3).AddHours(16),
            color: "blue", category: "Work", location: "HQ — Boardroom",
            personId: _alice.Id, description: "Review component library updates.");

        AddEvent("Alice: Code Review",
            _monday.AddDays(1).AddHours(14), _monday.AddDays(1).AddHours(15),
            color: "blue", category: "Work",
            personId: _alice.Id,
            recurrenceType: MyStackBlazor.Calendar.Models.RecurrenceType.Weekly, recurrenceInterval: 1,
            recurrenceEndDate: _today.AddMonths(2));

        // ── Sam's events ───────────────────────────────────────────────────
        AddEvent("Holiday",
            _monday.AddDays(1).Date, _monday.AddDays(1).Date,
            allDay: true, color: "green", category: "Holiday",
            personId: _bob.Id);

        AddEvent("Packaging Workshop",
            _monday.AddDays(5).AddHours(11), _monday.AddDays(5).AddHours(13),
            color: "green", category: "Work", location: "Lab 3",
            personId: _bob.Id);

        // ── Taylor's events ────────────────────────────────────────────────
        AddEvent("Release Stabilization",
            _monday.AddDays(6).Date, _monday.AddDays(9).Date,
            allDay: true, color: "orange", category: "Work",
            personId: _carol.Id, description: "Code freeze and regression testing.");

        AddEvent("Interaction Policy Review",
            _monday.AddDays(19).AddHours(13), _monday.AddDays(19).AddHours(15),
            color: "orange", category: "Work",
            personId: _carol.Id);

        AddEvent("Obstruction Planning",
            _monday.AddDays(2).Date, _monday.AddDays(2).Date,
            allDay: true, color: "orange", category: "Work",
            personId: _carol.Id);

        // ── Casey's events ─────────────────────────────────────────────────
        AddEvent("Experience Planning",
            _monday.AddDays(10).AddHours(9), _monday.AddDays(10).AddHours(11),
            color: "purple", category: "Work",
            personId: _dave.Id);

        AddEvent("Obstruction Review",
            _monday.AddDays(14).Date, _monday.AddDays(14).Date,
            allDay: true, color: "purple", category: "Work",
            personId: _dave.Id);

        // ── Jayce's events ─────────────────────────────────────────────────
        AddEvent("Project Exploration",
            _monday.AddDays(1).AddHours(9), _monday.AddDays(1).AddHours(11),
            color: "yellow", category: "Work",
            personId: _eve.Id);

        AddEvent(".NET Conf Live Stream",
            _today.AddDays(7).Date.AddHours(9), _today.AddDays(7).Date.AddHours(17),
            color: "yellow", category: "Work",
            location: "Online (YouTube)", personId: _eve.Id,
            description: "Microsoft .NET annual conference.");
    }

    private void AddEvent(string title, DateTime start, DateTime end,
        bool allDay = false, string color = "blue",
        string? category = null, string? location = null, string? description = null,
        string? personId = null,
        MyStackBlazor.Calendar.Models.RecurrenceType recurrenceType = MyStackBlazor.Calendar.Models.RecurrenceType.None,
        int recurrenceInterval = 1,
        DateTime? recurrenceEndDate = null)
    {
        _events.Add(new MyStackBlazor.Calendar.Models.CalendarEvent
        {
            Title              = title,
            Start              = start,
            End                = end,
            AllDay             = allDay,
            Color              = color,
            Category           = category,
            Location           = location,
            Description        = description,
            PersonId           = personId,
            RecurrenceType     = recurrenceType,
            RecurrenceInterval = recurrenceInterval,
            RecurrenceEndDate  = recurrenceEndDate,
        });
    }

    private void HandleAdd(MyStackBlazor.Calendar.Models.CalendarEvent e)
        => _log.Add($"Added \"{e.Title}\" on {e.Start:MMM d}");

    private void HandleEdit(MyStackBlazor.Calendar.Models.CalendarEvent e)
        => _log.Add($"Updated \"{e.Title}\"");

    private void HandleDelete(MyStackBlazor.Calendar.Models.CalendarEvent e)
        => _log.Add($"Deleted \"{e.Title}\"");

    private static DateTime ThisMonday(DateTime d)
        => d.AddDays(-(((int)d.DayOfWeek + 6) % 7)).Date;

    private static DateTime NextSaturday(DateTime d)
    {
        var n = ((int)DayOfWeek.Saturday - (int)d.DayOfWeek + 7) % 7;
        return d.AddDays(n == 0 ? 7 : n).Date;
    }

    private static DateTime FirstOfNextMonth(DateTime d)
        => new DateTime(d.Year, d.Month, 1).AddMonths(1);

    private const string _code = """
        <!-- Install: dotnet add package MyStackBlazor.Calendar -->
        <!-- Program.cs: builder.Services.AddMyStackBlazorCalendar() -->

        @using MyStackBlazor.Calendar
        @using MyStackBlazor.Calendar.Models

        <div class="h-[800px] rounded-xl border overflow-hidden">
            <StackCalendar Events="_events"
                           People="_people"
                           ShowMiniCalendar="true"
                           AllowAdd="true"
                           DefaultView="CalendarViewMode.WorkWeek"
                           DefaultFocus="FocusMode.Department"
                           OnEventAdd="HandleAdd"
                           OnEventEdit="HandleEdit"
                           OnEventDelete="HandleDelete" />
        </div>

        @code {
            private List<CalendarPerson> _people =
            [
                new() { Id = "alice", Name = "Alice Chen",   Color = "blue"   },
                new() { Id = "bob",   Name = "Sam Rivera",   Color = "green"  },
            ];

            private List<CalendarEvent> _events =
            [
                new() { Title = "Team Standup",  Start = DateTime.Today.AddHours(9),  End = DateTime.Today.AddHours(9).AddMinutes(30), Color = "blue",   Category = "Work" },
                new() { Title = "Design Review", Start = DateTime.Today.AddHours(14), End = DateTime.Today.AddHours(15),               Color = "blue",   PersonId = "alice" },
                new() { Title = "Weekly Retro",  Start = DateTime.Today.AddHours(16), End = DateTime.Today.AddHours(17),               Color = "indigo",
                        RecurrenceType = RecurrenceType.Weekly, RecurrenceInterval = 1, RecurrenceEndDate = DateTime.Today.AddMonths(3) },
            ];
        }
        """;
}
