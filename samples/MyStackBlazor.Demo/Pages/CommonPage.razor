@page "/common"

<PageTitle>Buttons &amp; Badges — MyStackBlazor Demo</PageTitle>

<h1 class="text-3xl font-bold mb-1">Buttons &amp; Badges</h1>
<p class="text-muted-foreground mb-8">Core UI atoms: buttons, badges, chips, avatars, and loading indicators.</p>

<!-- Button Variants -->
<DemoSection Title="Button Variants"
             Description="Use Variant to control the visual style."
             Code="@_btnVariants">
    <Button Variant="default">Default</Button>
    <Button Variant="secondary">Secondary</Button>
    <Button Variant="outline">Outline</Button>
    <Button Variant="destructive">Destructive</Button>
    <Button Variant="ghost">Ghost</Button>
    <Button Variant="link">Link</Button>
</DemoSection>

<!-- Button Sizes -->
<DemoSection Title="Button Sizes"
             Description="Use Size to control the button dimensions."
             Code="@_btnSizes">
    <Button Size="sm">Small</Button>
    <Button Size="default">Default</Button>
    <Button Size="lg">Large</Button>
    <Button Size="icon" AriaLabel="Settings">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
    </Button>
</DemoSection>

<!-- Loading & Disabled -->
<DemoSection Title="Loading &amp; Disabled States" Code="@_btnStates">
    <Button IsLoading="_loading" OnClick="SimulateLoad">
        @(_loading ? "Saving..." : "Save Changes")
    </Button>
    <Button Variant="outline" Disabled>Disabled</Button>
    <Button Variant="secondary" IsLoading>Always Loading</Button>
</DemoSection>

<!-- Badge Variants -->
<DemoSection Title="Badge Variants" Code="@_badges">
    <Badge>Default</Badge>
    <Badge Variant="secondary">Secondary</Badge>
    <Badge Variant="destructive">Destructive</Badge>
    <Badge Variant="outline">Outline</Badge>
</DemoSection>

<!-- Chips -->
<DemoSection Title="Chips" Description="Use OnRemove to make chips removable." Code="@_chips">
    @foreach (var tag in _tags)
    {
        <Chip OnRemove="@(() => RemoveTag(tag))" RemoveLabel="@($"Remove {tag}")">@tag</Chip>
    }
    <Chip Variant="secondary">React</Chip>
    <Chip Variant="success">Success</Chip>
    <Chip Variant="warning">Warning</Chip>
    <Chip Variant="outline">Outline</Chip>
    @if (_tags.Count == 0)
    {
        <span class="text-xs text-muted-foreground">All tags removed — refresh to reset.</span>
    }
</DemoSection>

<!-- Avatar -->
<DemoSection Title="Avatar" Description="Shows initials as fallback when no image source is set." Code="@_avatars">
    <Avatar Initials="VS" Size="xs" />
    <Avatar Initials="AB" Size="sm" />
    <Avatar Initials="CD" />
    <Avatar Initials="EF" Size="lg" />
    <Avatar Initials="GH" Size="xl" />
    <Avatar />
</DemoSection>

<!-- Spinner -->
<DemoSection Title="Spinner" Description="Use for loading states. Size mirrors button sizes." Code="@_spinners">
    <Spinner Size="xs" />
    <Spinner Size="sm" />
    <Spinner />
    <Spinner Size="lg" />
    <Spinner Size="xl" />
</DemoSection>

<!-- Skeleton -->
<DemoSection Title="Skeleton" Description="Pulse placeholder while content loads." Code="@_skeleton">
    <div class="w-full space-y-3">
        <div class="flex items-center gap-3">
            <Skeleton Class="h-10 w-10 rounded-full" />
            <div class="flex-1 space-y-2">
                <Skeleton Class="h-4 w-1/3" />
                <Skeleton Class="h-3 w-1/2" />
            </div>
        </div>
        <Skeleton Class="h-4 w-full" />
        <Skeleton Class="h-4 w-4/5" />
        <Skeleton Class="h-4 w-2/3" />
    </div>
</DemoSection>

<!-- Typography -->
<DemoSection Title="Typography"
             Description="Semantic text elements. Use Variant to switch between h1–h6, p, lead, large, small, muted, blockquote, and code."
             Code="@_typographyCode">
    <div class="w-full space-y-2">
        <Typography Variant="h1">Heading 1</Typography>
        <Typography Variant="h2">Heading 2</Typography>
        <Typography Variant="h3">Heading 3</Typography>
        <Typography Variant="h4">Heading 4</Typography>
        <Typography Variant="lead">Lead paragraph — larger introductory text.</Typography>
        <Typography Variant="p">Body paragraph — the default text style for content.</Typography>
        <Typography Variant="large">Large text</Typography>
        <Typography Variant="small">Small text</Typography>
        <Typography Variant="muted">Muted / secondary text</Typography>
        <Typography Variant="blockquote">"Great components are composed, not configured." — someone wise</Typography>
        <Typography Variant="code">npm install mystack-blazor</Typography>
    </div>
</DemoSection>

<!-- Label -->
<DemoSection Title="Label"
             Description="Associates with an input via For. Styled to match the design system."
             Code="@_labelCode">
    <div class="w-full max-w-xs space-y-1">
        <Label For="lbl-demo">Your email address</Label>
        <Input Id="lbl-demo" Type="email" Placeholder="you@example.com" />
    </div>
</DemoSection>

<!-- ButtonGroup -->
<DemoSection Title="Button Group"
             Description="Groups related buttons together, removing gaps between them."
             Code="@_btnGroupCode">
    <div class="space-y-3">
        <ButtonGroup>
            <Button Variant="outline" Size="sm">Left</Button>
            <Button Variant="outline" Size="sm">Center</Button>
            <Button Variant="outline" Size="sm">Right</Button>
        </ButtonGroup>
        <ButtonGroup>
            <Button Size="sm">Save</Button>
            <Button Variant="outline" Size="sm">Preview</Button>
            <Button Variant="outline" Size="sm">Discard</Button>
        </ButtonGroup>
    </div>
</DemoSection>

<!-- ToggleButton -->
<DemoSection Title="Toggle Button"
             Description="Stateful button that tracks a pressed/active state via IsPressed / IsPressedChanged."
             Code="@_toggleCode">
    <div class="flex flex-wrap gap-3">
        <ToggleButton @bind-IsPressed="_boldOn">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 4h8a4 4 0 010 8H6zM6 12h9a4 4 0 010 8H6z" />
            </svg>
            Bold
        </ToggleButton>
        <ToggleButton @bind-IsPressed="_italicOn">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 4h-9M14 20H5M15 4L9 20" />
            </svg>
            Italic
        </ToggleButton>
        <ToggleButton @bind-IsPressed="_underlineOn">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v8a5 5 0 0010 0V4M5 20h14" />
            </svg>
            Underline
        </ToggleButton>
        <p class="text-sm text-muted-foreground w-full">
            Active: @(string.Join(", ", new[] {
                _boldOn ? "Bold" : null,
                _italicOn ? "Italic" : null,
                _underlineOn ? "Underline" : null
            }.Where(x => x is not null)) is "" ? "none" : string.Join(", ", new[] {
                _boldOn ? "Bold" : null,
                _italicOn ? "Italic" : null,
                _underlineOn ? "Underline" : null
            }.Where(x => x is not null)))
        </p>
    </div>
</DemoSection>

@code {
    private bool _loading;
    private List<string> _tags = ["Blazor", ".NET", "Tailwind"];
    private bool _boldOn;
    private bool _italicOn;
    private bool _underlineOn;

    private async Task SimulateLoad()
    {
        _loading = true;
        await Task.Delay(1500);
        _loading = false;
    }

    private void RemoveTag(string tag) => _tags.Remove(tag);

    private const string _btnVariants = """
        <Button Variant="default">Default</Button>
        <Button Variant="secondary">Secondary</Button>
        <Button Variant="outline">Outline</Button>
        <Button Variant="destructive">Destructive</Button>
        <Button Variant="ghost">Ghost</Button>
        <Button Variant="link">Link</Button>
        """;

    private const string _btnSizes = """
        <Button Size="sm">Small</Button>
        <Button Size="default">Default</Button>
        <Button Size="lg">Large</Button>
        <Button Size="icon" AriaLabel="Settings">...</Button>
        """;

    private const string _btnStates = """
        <Button IsLoading="_loading" OnClick="SimulateLoad">
            @(_loading ? "Saving..." : "Save Changes")
        </Button>
        <Button Variant="outline" Disabled>Disabled</Button>
        """;

    private const string _badges = """
        <Badge>Default</Badge>
        <Badge Variant="secondary">Secondary</Badge>
        <Badge Variant="destructive">Destructive</Badge>
        <Badge Variant="outline">Outline</Badge>
        """;

    private const string _chips = """
        <Chip OnRemove="@(() => RemoveTag(tag))" RemoveLabel="@($"Remove {tag}")">@tag</Chip>
        <Chip Variant="success">Success</Chip>
        <Chip Variant="warning">Warning</Chip>
        """;

    private const string _avatars = """
        <Avatar Initials="VS" Size="xs" />
        <Avatar Initials="AB" Size="sm" />
        <Avatar Initials="CD" />
        <Avatar Initials="EF" Size="lg" />
        <Avatar />
        """;

    private const string _spinners = """
        <Spinner Size="xs" />
        <Spinner Size="sm" />
        <Spinner />
        <Spinner Size="lg" />
        """;

    private const string _skeleton = """
        <Skeleton Class="h-10 w-10 rounded-full" />
        <Skeleton Class="h-4 w-full" />
        <Skeleton Class="h-4 w-4/5" />
        """;

    private const string _typographyCode = """
        <Typography Variant="h1">Heading 1</Typography>
        <Typography Variant="h2">Heading 2</Typography>
        <Typography Variant="lead">Lead paragraph</Typography>
        <Typography Variant="p">Body paragraph</Typography>
        <Typography Variant="muted">Muted text</Typography>
        <Typography Variant="blockquote">"A quote."</Typography>
        <Typography Variant="code">dotnet add package MyStackBlazor</Typography>
        """;

    private const string _labelCode = """
        <Label For="email">Your email address</Label>
        <Input Id="email" Type="email" Placeholder="you@example.com" />
        """;

    private const string _btnGroupCode = """
        <ButtonGroup>
            <Button Variant="outline" Size="sm">Left</Button>
            <Button Variant="outline" Size="sm">Center</Button>
            <Button Variant="outline" Size="sm">Right</Button>
        </ButtonGroup>
        """;

    private const string _toggleCode = """
        <ToggleButton @bind-IsPressed="_bold">Bold</ToggleButton>
        <ToggleButton @bind-IsPressed="_italic">Italic</ToggleButton>
        """;
}
