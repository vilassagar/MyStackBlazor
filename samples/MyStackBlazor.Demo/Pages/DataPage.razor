@page "/data"

<PageTitle>Data Controls — MyStackBlazor Demo</PageTitle>

<h1 class="text-3xl font-bold mb-1">Data Controls</h1>
<p class="text-muted-foreground mb-8">Table, DataTable, ListView, TreeView, and VirtualList.</p>

<!-- Static Table -->
<DemoSection Title="Table"
             Description="Composable table primitives. Use TableHeader, TableBody, TableRow, TableHead, TableCell."
             Code="@_tableCode">
    <div class="w-full overflow-x-auto">
        <StackTable>
            <StackTableHeader>
                <StackTableRow>
                    <StackTableHead>Name</StackTableHead>
                    <StackTableHead>Role</StackTableHead>
                    <StackTableHead>Status</StackTableHead>
                    <StackTableHead Class="text-right">Joined</StackTableHead>
                </StackTableRow>
            </StackTableHeader>
            <StackTableBody>
                @foreach (var p in _people)
                {
                    <StackTableRow>
                        <StackTableCell Class="font-medium">@p.Name</StackTableCell>
                        <StackTableCell>@p.Role</StackTableCell>
                        <StackTableCell>
                            <StackBadge Variant="@(p.Active ? "default" : "secondary")">
                                @(p.Active ? "Active" : "Inactive")
                            </StackBadge>
                        </StackTableCell>
                        <StackTableCell Class="text-right text-muted-foreground">@p.Joined.ToString("MMM yyyy")</StackTableCell>
                    </StackTableRow>
                }
            </StackTableBody>
        </StackTable>
    </div>
</DemoSection>

<!-- DataTable — search + sort + filter + pagination -->
<DemoSection Title="DataTable"
             Description="Built-in search, column sort, per-column filter, and pagination. Pass ShowSearch, ShowPagination, PageSize."
             Code="@_dataTableCode">
    <div class="w-full">
        <StackDataTable TItem="Person"
                   Items="_people"
                   PageSize="4"
                   Columns="_columns" />
    </div>
</DemoSection>

<!-- ListView -->
<DemoSection Title="ListView"
             Description="Generic list with ItemTemplate, selection highlight, and click callback."
             Code="@_listViewCode">
    <div class="w-full max-w-sm">
        <StackListView TItem="Person"
                  Items="_people"
                  SelectedItem="_selectedPerson"
                  OnItemClick="p => _selectedPerson = p"
                  Height="220px">
            <ItemTemplate Context="person">
                <div class="flex items-center gap-3 px-4 py-3">
                    <StackAvatar Initials="@person.Initials" Size="sm" />
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium truncate">@person.Name</p>
                        <p class="text-xs text-muted-foreground truncate">@person.Role</p>
                    </div>
                    <StackBadge Variant="@(person.Active ? "default" : "secondary")" >
                        @(person.Active ? "Active" : "Inactive")
                    </StackBadge>
                </div>
            </ItemTemplate>
        </StackListView>
        @if (_selectedPerson is not null)
        {
            <p class="text-sm text-muted-foreground mt-2">
                Selected: <strong>@_selectedPerson.Name</strong> — @_selectedPerson.Role
            </p>
        }
    </div>
</DemoSection>

<!-- TreeView -->
<DemoSection Title="TreeView"
             Description="Recursive tree with expand/collapse, keyboard-accessible selection."
             Code="@_treeCode">
    <div class="w-full max-w-xs rounded-md border p-2">
        <StackTreeView TItem="TreeNode"
                  Items="_treeRoots"
                  GetChildren="n => n.Children"
                  GetLabel="n => n.Label"
                  @bind-SelectedItem="_selectedNode" />
    </div>
    @if (_selectedNode is not null)
    {
        <p class="text-sm text-muted-foreground mt-2 ml-1">
            Selected: <strong>@_selectedNode.Label</strong>
        </p>
    }
</DemoSection>

<!-- MsDataGrid: infinite-scroll virtualized server-side grid -->
<DemoSection Title="MsDataGrid"
             Description="Infinite-scroll, server-side data grid. Virtualized rows via &lt;Virtualize&gt; — only visible rows are rendered. Supports sortable/filterable columns, global search, row selection, and Excel export."
             Code="@_gridCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products data grid"
                    BodyHeight="460px"
                    OverscanCount="8"
                    SelectedItem="_selectedProduct"
                    SelectedItemChanged="p => _selectedProduct = p"
                    OnExported="HandleExport">
            <MsDataGridColumn Field="Id" Title="ID" Width="72px" Sortable="true" />
            <MsDataGridColumn Field="Name" Title="Product Name" Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Width="160px" Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Price" Title="Price" Width="110px" Sortable="true">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
            <MsDataGridColumn Field="InStock" Title="Stock" Width="100px" Sortable="true">
                <CellTemplate Context="p">
                    <StackBadge Variant="@(p.InStock ? "default" : "secondary")">
                        @(p.InStock ? "In Stock" : "Out")
                    </StackBadge>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        @if (_selectedProduct is not null)
        {
            <p class="mt-2 text-sm text-muted-foreground">
                Selected: <strong>@_selectedProduct.Name</strong> — @_selectedProduct.Category
            </p>
        }
        @if (_exportMessage is not null)
        {
            <p class="mt-1 text-xs text-muted-foreground">@_exportMessage</p>
        }
    </div>
</DemoSection>

<!-- MsVirtualList -->
<DemoSection Title="MsVirtualList"
             Description="Blazor Virtualize wrapper for large flat lists. Renders only visible rows."
             Code="@_virtualCode">
    <div class="w-full max-w-sm">
        <StackMsVirtualList TItem="string"
                       Items="_virtualItems"
                       ItemHeight="44"
                       Height="220px">
            <ItemTemplate Context="item">
                <div class="flex items-center gap-3 px-4 border-b hover:bg-muted/50 transition-colors"
                     style="height:44px">
                    <span class="h-2 w-2 rounded-full bg-primary flex-shrink-0"></span>
                    <span class="text-sm truncate">@item</span>
                </div>
            </ItemTemplate>
        </StackMsVirtualList>
        <p class="text-xs text-muted-foreground mt-1">@_virtualItems.Count items — only visible rows rendered.</p>
    </div>
</DemoSection>

@code {
    // ── Sample data ──────────────────────────────────────────────────────────

