@namespace MyStackBlazor.Localization
@using System.Globalization

<div dir="@Direction" lang="@_culture.TwoLetterISOLanguageName" class="@Class">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Override the culture. Defaults to CultureInfo.CurrentUICulture when null.
    /// </summary>
    [Parameter] public CultureInfo? Culture { get; set; }

    private CultureInfo _culture => Culture ?? CultureInfo.CurrentUICulture;

    private string Direction => _culture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
