<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>MyStackBlazor.Security</PackageId>
    <Description>Security utilities for MyStackBlazor: HTML sanitization, token providers, and auth abstractions. Supports CSP-compliant rendering.</Description>
    <PackageTags>blazor;security;xss;sanitizer;auth;csp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyStackBlazor.Core\MyStackBlazor.Core.csproj" />
  </ItemGroup>

</Project>
