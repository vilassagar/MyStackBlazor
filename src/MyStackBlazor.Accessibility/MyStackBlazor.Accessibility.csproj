<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>MyStackBlazor.Accessibility</PackageId>
    <Description>WCAG 2.2 accessibility helpers for MyStackBlazor: ARIA binding base class, focus management, keyboard navigation utilities.</Description>
    <PackageTags>blazor;accessibility;wcag;aria;a11y</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyStackBlazor.Core\MyStackBlazor.Core.csproj" />
  </ItemGroup>

</Project>
