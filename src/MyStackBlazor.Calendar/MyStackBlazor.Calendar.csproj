<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>MyStackBlazor.Calendar</PackageId>
    <Product>MyStackBlazor Calendar</Product>
    <Description>Full-featured calendar and scheduler component for MyStackBlazor. Supports Day, Week, WorkWeek, Month, Year, Agenda, and Timeline views. Includes recurring events, multi-person calendars, category filtering, mini-calendar sidebar, and add/edit/delete dialogs. Works with Blazor WASM, Blazor Server, and .NET MAUI Blazor Hybrid.</Description>
    <PackageTags>blazor;calendar;scheduler;fullcalendar;recurring;agenda;timeline;workweek;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyStackBlazor.Core\MyStackBlazor.Core.csproj" />
  </ItemGroup>

</Project>
