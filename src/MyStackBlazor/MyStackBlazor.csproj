<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>MyStackBlazor</PackageId>
    <Product>MyStackBlazor Component Library</Product>
    <Description>A modern Blazor component library styled with Tailwind CSS v4. Includes reusable components: buttons, forms, navigation, overlays, data display, theme support (light/dark/system), and more. Works with Blazor WASM, Blazor Server, and .NET MAUI Blazor Hybrid.</Description>
    <PackageTags>blazor;blazor-components;component-library;ui;tailwindcss;razor;dark-mode;maui;blazor-wasm;blazor-server;datagrid;charts;forms</PackageTags>
  </PropertyGroup>

  <!-- Exclude Node.js tooling files from the package -->
  <ItemGroup>
    <Content Remove="package.json" />
    <Content Remove="package-lock.json" />
    <None   Remove="package.json" />
    <None   Remove="package-lock.json" />
    <Content Remove="node_modules\**" />
    <None   Remove="node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyStackBlazor.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyStackBlazor.Core\MyStackBlazor.Core.csproj" />
    <ProjectReference Include="..\MyStackBlazor.Accessibility\MyStackBlazor.Accessibility.csproj" />
  </ItemGroup>

  <!--
    Tailwind CSS: tailwind/input.css -> wwwroot/css/mystackblazor.css (the built CSS is committed).
    Runs only when node_modules exists (run `npm ci` once in this folder) and something it scans has changed.
    Skip explicitly with /p:SkipTailwind=true. CI builds the CSS in its own step and sets CI=true.
  -->
  <ItemGroup>
    <TailwindInput Include="tailwind/**/*.css;tailwind.config.js;Components/**/*.razor;Components/**/*.cs" />
  </ItemGroup>

  <Target Name="BuildTailwind"
          BeforeTargets="BeforeBuild"
          Condition="'$(CI)' != 'true' and '$(SkipTailwind)' != 'true'"
          Inputs="@(TailwindInput)"
          Outputs="wwwroot/css/mystackblazor.css">
    <Message Importance="high" Condition="!Exists('$(MSBuildProjectDirectory)/node_modules')"
             Text="MyStackBlazor: node_modules not found - using the committed mystackblazor.css. Run 'npm ci' in src/MyStackBlazor to rebuild it." />
    <Exec Condition="Exists('$(MSBuildProjectDirectory)/node_modules')"
          Command="npm run build:css"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- Tailwind skips the write when the CSS is unchanged; touch it so the next build is incremental. -->
    <Touch Condition="Exists('$(MSBuildProjectDirectory)/node_modules')" Files="wwwroot/css/mystackblazor.css" />
  </Target>

</Project>
