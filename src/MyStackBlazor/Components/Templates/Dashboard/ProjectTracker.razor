@namespace MyStackBlazor.Components.Templates.Dashboard
@using MyStackBlazor.Components.Blocks
@using MyStackBlazor.Components.Blocks.Dashboard

<div class="flex h-screen overflow-hidden bg-background">
    <DashboardSidebar Brand="TaskFlow" Items="@_nav" />

    <div class="flex flex-1 flex-col overflow-hidden">
        <TopNavbar Brand="TaskFlow"
                   UserName="Alex Morgan"
                   UserInitials="AM"
                   NotificationCount="4"
                   Breadcrumbs="@_breadcrumbs" />

        <main class="flex-1 overflow-y-auto p-6">
            <div class="mb-6 flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold text-foreground">Q2 2026 Projects</h2>
                    <p class="text-sm text-muted-foreground">6 active projects · 142 open tasks</p>
                </div>
                <button class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">
                    + New project
                </button>
            </div>

            <!-- KPIs -->
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <CompactCard Label="Active Projects"    Value="6"      Trend="2 due this week"    TrendUp="false" IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>' />
                <CompactCard Label="Tasks Completed"   Value="284"    Trend="+42 this week"      TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>' />
                <CompactCard Label="Completion Rate"   Value="72%"    Trend="+5% vs last sprint"  TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>' />
                <CompactCard Label="Overdue Tasks"     Value="18"     Trend="-7 since Monday"    TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' />
            </div>

            <!-- Charts -->
            <div class="mt-6 grid gap-6 lg:grid-cols-3">
                <div class="lg:col-span-2">
                    <DashboardCard Title="Task Completion" Description="Last 8 weeks" Trend="+5%" TrendUp="true">
                        <BodyContent>
                            <div class="flex h-32 items-end gap-2">
                                @foreach (var (wk, done, total) in new[] { ("W9",18,30), ("W10",22,35), ("W11",15,28), ("W12",32,40), ("W13",28,38), ("W14",35,42), ("W15",40,48), ("W16",42,50) })
                                {
                                    <div class="flex flex-1 flex-col items-center gap-1">
                                        <div class="relative w-full" style="height:80px">
                                            <div class="absolute bottom-0 w-full rounded-t bg-muted" style="height:@(total * 2)px"></div>
                                            <div class="absolute bottom-0 w-full rounded-t bg-primary/60" style="height:@(done * 2)px"></div>
                                        </div>
                                        <span class="text-[9px] text-muted-foreground">@wk</span>
                                    </div>
                                }
                            </div>
                            <div class="mt-3 flex gap-4 text-xs text-muted-foreground">
                                <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-primary/60"></span>Completed</span>
                                <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-muted"></span>Total planned</span>
                            </div>
                        </BodyContent>
                    </DashboardCard>
                </div>

                <DashboardCard Title="By Priority" Description="Open tasks">
                    <BodyContent>
                        <div class="space-y-3">
                            @foreach (var (priority, count, color) in new[] { ("Critical","12","bg-red-400"), ("High","38","bg-orange-400"), ("Medium","64","bg-yellow-400"), ("Low","28","bg-green-400") })
                            {
                                var pct = int.Parse(count) * 100 / 142;
                                <div>
                                    <div class="mb-1 flex justify-between text-xs">
                                        <span class="text-muted-foreground">@priority</span>
                                        <span class="font-medium text-foreground">@count tasks</span>
                                    </div>
                                    <div class="h-2 overflow-hidden rounded-full bg-muted">
                                        <div class="h-full rounded-full @color" style="width:@(pct)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </BodyContent>
                </DashboardCard>
            </div>

            <!-- Projects table -->
            <div class="mt-6 rounded-xl border bg-card shadow-sm">
                <div class="flex items-center justify-between border-b px-6 py-4">
                    <h3 class="text-sm font-semibold text-foreground">Projects</h3>
                    <a href="#" class="text-xs font-medium text-primary hover:underline">View board</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="border-b bg-muted/30">
                            <tr>
                                @foreach (var h in new[] { "Project", "Owner", "Tasks", "Progress", "Due Date", "Status" })
                                {
                                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">@h</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            @foreach (var proj in _projects)
                            {
                                <tr class="hover:bg-muted/30 transition-colors">
                                    <td class="px-5 py-3 font-semibold text-foreground">@proj.Name</td>
                                    <td class="px-5 py-3 text-muted-foreground">@proj.Owner</td>
                                    <td class="px-5 py-3 text-muted-foreground">@proj.Tasks open</td>
                                    <td class="px-5 py-3">
                                        <div class="flex items-center gap-2">
                                            <div class="h-1.5 w-24 overflow-hidden rounded-full bg-muted">
                                                <div class="h-full rounded-full bg-primary" style="width:@(proj.Progress)%"></div>
                                            </div>
                                            <span class="text-xs text-muted-foreground">@(proj.Progress)%</span>
                                        </div>
                                    </td>
                                    <td class="px-5 py-3 text-muted-foreground">@proj.Due</td>
                                    <td class="px-5 py-3">
                                        <span class="rounded-full px-2 py-0.5 text-xs font-semibold
                                            @(proj.Status == "On Track" ? "bg-green-500/10 text-green-600" :
                                              proj.Status == "At Risk" ? "bg-yellow-500/10 text-yellow-600" :
                                              "bg-red-500/10 text-red-500")">
                                            @proj.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

@code {
    private static readonly IList<DashboardNavItem> _nav =
    [
        new("Dashboard",  "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/></svg>", true),
        new("Projects",   "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><rect x='2' y='7' width='20' height='14' rx='2' ry='2'/><path d='M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16'/></svg>"),
        new("My Tasks",   "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><polyline points='9 11 12 14 22 4'/><path d='M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11'/></svg>"),
        new("Calendar",   "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><rect x='3' y='4' width='18' height='18' rx='2' ry='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/></svg>"),
        new("Team",       "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/></svg>"),
        new("Reports",    "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/></svg>"),
        new("Settings",   "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><circle cx='12' cy='12' r='3'/></svg>"),
    ];

    private IList<NavBreadcrumb> _breadcrumbs = [new("Workspace"), new("Q2 Projects")];

    private record ProjectRow(string Name, string Owner, string Tasks, int Progress, string Due, string Status);
    private static readonly IList<ProjectRow> _projects =
    [
        new("Website Redesign",       "Alex Morgan",  "24 open",  78, "31 May",  "On Track"),
        new("Mobile App v2",          "Priya Nair",   "41 open",  55, "15 Jun",  "At Risk"),
        new("API Integration Layer",  "Ben Carroll",  "18 open",  90, "24 May",  "On Track"),
        new("Data Migration",         "Sam Liu",      "32 open",  38, "10 Jun",  "At Risk"),
        new("Marketing Campaign",     "Asha Mehta",   "15 open",  62, "28 May",  "On Track"),
        new("Security Audit",         "Tom Evans",    "12 open",  20, "5 Jun",   "Delayed"),
    ];
}
