@namespace MyStackBlazor.Components.Templates.Dashboard
@using MyStackBlazor.Components.Blocks
@using MyStackBlazor.Components.Blocks.Dashboard

<div class="flex h-screen overflow-hidden bg-background">
    <DashboardSidebar Brand="OpsView" Items="@_nav" />

    <div class="flex flex-1 flex-col overflow-hidden">
        <TopNavbar Brand="OpsView"
                   UserName="Plant Manager"
                   UserInitials="PM"
                   NotificationCount="2"
                   Breadcrumbs="@[new("Dashboard"), new("Plant Floor")]" />

        <main class="flex-1 overflow-y-auto p-6">
            <div class="mb-6 flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold text-foreground">Plant Floor — Line A</h2>
                    <p class="text-sm text-muted-foreground">Shift: Day · 06:00 – 18:00 · 16 May 2026</p>
                </div>
                <div class="flex items-center gap-2 rounded-full border border-green-500/30 bg-green-500/10 px-3 py-1.5">
                    <span class="h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
                    <span class="text-xs font-medium text-green-600">All systems operational</span>
                </div>
            </div>

            <!-- KPIs -->
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <CompactCard Label="Units Produced"   Value="4,821"  Trend="+3.2% vs target" TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>' />
                <CompactCard Label="OEE"              Value="88.4%"  Trend="+1.8pts this week" TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>' />
                <CompactCard Label="Downtime Today"   Value="22 min" Trend="-48 min vs avg"   TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' />
                <CompactCard Label="Defect Rate"      Value="0.4%"   Trend="-0.1% vs target"  TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' />
            </div>

            <!-- Charts -->
            <div class="mt-6 grid gap-6 lg:grid-cols-2">
                <DashboardCard Title="Hourly Output" Description="Units produced per hour today" Trend="+3.2%" TrendUp="true">
                    <BodyContent>
                        <div class="flex h-32 items-end gap-1.5">
                            @foreach (var (hr, h) in new[] { ("6",65), ("7",70), ("8",75), ("9",80), ("10",72), ("11",88), ("12",60), ("13",82), ("14",90), ("15",85), ("16",92), ("17",78) })
                            {
                                <div class="flex flex-1 flex-col items-center gap-1">
                                    <div class="w-full rounded-t bg-primary/30 hover:bg-primary/60 transition-colors" style="height:@(h)%"></div>
                                    <span class="text-[9px] text-muted-foreground">@hr</span>
                                </div>
                            }
                        </div>
                    </BodyContent>
                </DashboardCard>

                <DashboardCard Title="Machine Status" Description="Live · 12 machines">
                    <BodyContent>
                        <div class="grid grid-cols-3 gap-2">
                            @foreach (var (name, status) in new[] { ("M-01","Running"), ("M-02","Running"), ("M-03","Idle"), ("M-04","Running"), ("M-05","Running"), ("M-06","Maintenance"), ("M-07","Running"), ("M-08","Running"), ("M-09","Running"), ("M-10","Running"), ("M-11","Idle"), ("M-12","Running") })
                            {
                                <div class="flex items-center gap-1.5 rounded-md border px-2 py-1.5">
                                    <span class="h-2 w-2 rounded-full flex-shrink-0 @(status == "Running" ? "bg-green-500" : status == "Idle" ? "bg-yellow-400" : "bg-red-400")"></span>
                                    <span class="text-xs text-muted-foreground">@name</span>
                                </div>
                            }
                        </div>
                    </BodyContent>
                </DashboardCard>
            </div>

            <!-- Active work orders -->
            <div class="mt-6 rounded-xl border bg-card shadow-sm">
                <div class="flex items-center justify-between border-b px-6 py-4">
                    <h3 class="text-sm font-semibold text-foreground">Active Work Orders</h3>
                    <a href="#" class="text-xs font-medium text-primary hover:underline">All orders</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="border-b bg-muted/30">
                            <tr>
                                @foreach (var h in new[] { "Order #", "Product", "Target", "Completed", "Progress", "Status" })
                                {
                                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">@h</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            @foreach (var wo in _workOrders)
                            {
                                var pct = (int)((double)wo.Done / wo.Target * 100);
                                <tr class="hover:bg-muted/30 transition-colors">
                                    <td class="px-5 py-3 font-mono text-xs text-muted-foreground">@wo.Id</td>
                                    <td class="px-5 py-3 font-medium text-foreground">@wo.Product</td>
                                    <td class="px-5 py-3 text-muted-foreground">@wo.Target.ToString("N0")</td>
                                    <td class="px-5 py-3 text-muted-foreground">@wo.Done.ToString("N0")</td>
                                    <td class="px-5 py-3">
                                        <div class="flex items-center gap-2">
                                            <div class="h-1.5 w-24 overflow-hidden rounded-full bg-muted">
                                                <div class="h-full rounded-full bg-primary" style="width:@(pct)%"></div>
                                            </div>
                                            <span class="text-xs text-muted-foreground">@(pct)%</span>
                                        </div>
                                    </td>
                                    <td class="px-5 py-3">
                                        <span class="rounded-full px-2 py-0.5 text-xs font-semibold @(wo.Status == "On Track" ? "bg-green-500/10 text-green-600" : wo.Status == "At Risk" ? "bg-yellow-500/10 text-yellow-600" : "bg-red-500/10 text-red-500")">
                                            @wo.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

@code {
    private static readonly IList<DashboardNavItem> _nav =
    [
        new("Plant Floor",    "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/></svg>", true),
        new("Work Orders",    "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>"),
        new("Machines",       "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><rect x='4' y='4' width='16' height='16' rx='2'/><rect x='9' y='9' width='6' height='6'/><line x1='9' y1='1' x2='9' y2='4'/><line x1='15' y1='1' x2='15' y2='4'/><line x1='9' y1='20' x2='9' y2='23'/><line x1='15' y1='20' x2='15' y2='23'/><line x1='20' y1='9' x2='23' y2='9'/><line x1='20' y1='14' x2='23' y2='14'/><line x1='1' y1='9' x2='4' y2='9'/><line x1='1' y1='14' x2='4' y2='14'/></svg>"),
        new("Quality",        "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'/><polyline points='22 4 12 14.01 9 11.01'/></svg>"),
        new("Maintenance",    "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path d='M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z'/></svg>"),
        new("Reports",        "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/></svg>"),
    ];

    private record WoRow(string Id, string Product, int Target, int Done, string Status);
    private static readonly IList<WoRow> _workOrders =
    [
        new("WO-20241", "Gear Assembly GX-40",   2000, 1840, "On Track"),
        new("WO-20242", "Motor Housing Type B",  1500, 1490, "On Track"),
        new("WO-20243", "Bracket Kit LF-22",     3000, 1820, "At Risk"),
        new("WO-20244", "Drive Shaft DS-10",     800,  800,  "Complete"),
        new("WO-20245", "Control Panel CP-7",    400,  280,  "At Risk"),
        new("WO-20246", "Filter Housing FH-55",  5000, 2100, "Delayed"),
    ];
}
