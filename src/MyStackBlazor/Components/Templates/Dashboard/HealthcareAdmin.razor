@namespace MyStackBlazor.Components.Templates.Dashboard
@using MyStackBlazor.Components.Blocks
@using MyStackBlazor.Components.Blocks.Dashboard

<div class="flex h-screen overflow-hidden bg-background">
    <DashboardSidebar Brand="MedAdmin" Items="@_nav" />

    <div class="flex flex-1 flex-col overflow-hidden">
        <TopNavbar Brand="MedAdmin"
                   UserName="Dr. Patel"
                   UserInitials="DP"
                   NotificationCount="7"
                   Breadcrumbs="@[new("Dashboard")]" />

        <main class="flex-1 overflow-y-auto p-6">
            <div class="mb-6">
                <h2 class="text-xl font-bold text-foreground">Hospital Overview</h2>
                <p class="text-sm text-muted-foreground">Friday, 16 May 2026 · General Hospital</p>
            </div>

            <!-- KPIs -->
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <CompactCard Label="Total Patients"     Value="1,248"  Trend="+34 since yesterday" TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>' />
                <CompactCard Label="Appointments Today" Value="142"    Trend="18 remaining"        TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>' />
                <CompactCard Label="Available Beds"     Value="84"     Trend="-12 from yesterday"  TrendUp="false" IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>' />
                <CompactCard Label="Satisfaction Score" Value="4.8/5"  Trend="+0.2 this quarter"  TrendUp="true"  IconSvg='<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' />
            </div>

            <!-- Charts -->
            <div class="mt-6 grid gap-6 lg:grid-cols-2">
                <DashboardCard Title="Patient Admissions" Description="Last 7 days" Trend="+12%" TrendUp="true">
                    <BodyContent>
                        <div class="flex h-32 items-end gap-2">
                            @foreach (var (day, h) in new[] { ("Mon",55), ("Tue",70), ("Wed",62), ("Thu",85), ("Fri",78), ("Sat",45), ("Sun",38) })
                            {
                                <div class="flex flex-1 flex-col items-center gap-1">
                                    <div class="w-full rounded-t bg-primary/30 hover:bg-primary/60 transition-colors" style="height:@(h)%"></div>
                                    <span class="text-[10px] text-muted-foreground">@day</span>
                                </div>
                            }
                        </div>
                    </BodyContent>
                </DashboardCard>

                <DashboardCard Title="Department Capacity" Description="Current occupancy">
                    <BodyContent>
                        <div class="space-y-3">
                            @foreach (var (dept, pct, warn) in new[] { ("ICU","92%",true), ("Emergency","78%",false), ("Cardiology","65%",false), ("Orthopaedics","48%",false), ("Paediatrics","35%",false) })
                            {
                                <div>
                                    <div class="mb-1 flex justify-between text-xs">
                                        <span class="text-muted-foreground">@dept</span>
                                        <span class="font-medium @(warn ? "text-red-500" : "text-foreground")">@pct</span>
                                    </div>
                                    <div class="h-2 overflow-hidden rounded-full bg-muted">
                                        <div class="h-full rounded-full @(warn ? "bg-red-400" : "bg-primary/50")" style="width:@pct"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </BodyContent>
                </DashboardCard>
            </div>

            <!-- Today's appointments -->
            <div class="mt-6 rounded-xl border bg-card shadow-sm">
                <div class="flex items-center justify-between border-b px-6 py-4">
                    <h3 class="text-sm font-semibold text-foreground">Upcoming Appointments</h3>
                    <a href="#" class="text-xs font-medium text-primary hover:underline">Full schedule</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="border-b bg-muted/30">
                            <tr>
                                @foreach (var h in new[] { "Time", "Patient", "Doctor", "Department", "Type", "Status" })
                                {
                                    <th class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-muted-foreground">@h</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            @foreach (var apt in _appointments)
                            {
                                <tr class="hover:bg-muted/30 transition-colors">
                                    <td class="px-5 py-3 font-medium text-foreground">@apt.Time</td>
                                    <td class="px-5 py-3 text-foreground">@apt.Patient</td>
                                    <td class="px-5 py-3 text-muted-foreground">@apt.Doctor</td>
                                    <td class="px-5 py-3 text-muted-foreground">@apt.Dept</td>
                                    <td class="px-5 py-3 text-muted-foreground">@apt.Type</td>
                                    <td class="px-5 py-3">
                                        <span class="rounded-full px-2 py-0.5 text-xs font-semibold
                                            @(apt.Status == "Confirmed" ? "bg-green-500/10 text-green-600" :
                                              apt.Status == "In Progress" ? "bg-blue-500/10 text-blue-600" :
                                              "bg-yellow-500/10 text-yellow-600")">
                                            @apt.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

@code {
    private static readonly IList<DashboardNavItem> _nav =
    [
        new("Dashboard",    "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/></svg>", true),
        new("Patients",     "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/></svg>"),
        new("Appointments", "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><rect x='3' y='4' width='18' height='18' rx='2' ry='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/></svg>"),
        new("Staff",        "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>"),
        new("Medical Records","#","<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>"),
        new("Settings",     "#", "<svg class='h-4 w-4' fill='none' stroke='currentColor' viewBox='0 0 24 24'><circle cx='12' cy='12' r='3'/></svg>"),
    ];

    private record AptRow(string Time, string Patient, string Doctor, string Dept, string Type, string Status);
    private static readonly IList<AptRow> _appointments =
    [
        new("09:00", "James Holloway",  "Dr. Patel",   "Cardiology",   "Consultation",  "In Progress"),
        new("09:30", "Mei Lin",         "Dr. Okafor",  "Orthopaedics", "Follow-up",     "Confirmed"),
        new("10:00", "Robert Evans",    "Dr. Sharma",  "Neurology",    "New Patient",   "Confirmed"),
        new("10:30", "Alicia Moreno",   "Dr. Patel",   "Cardiology",   "Post-surgery",  "Confirmed"),
        new("11:00", "Tom Baker",       "Dr. Nguyen",  "Paediatrics",  "Vaccination",   "Waiting"),
        new("11:30", "Sophia Reyes",    "Dr. Okafor",  "Emergency",    "Urgent",        "Waiting"),
    ];
}
