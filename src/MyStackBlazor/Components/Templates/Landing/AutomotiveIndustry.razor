@namespace MyStackBlazor.Components.Templates.Landing
@using MyStackBlazor.Components.Blocks
@using MyStackBlazor.Components.Blocks.Landing

<div>
    <HeroBlock
        Eyebrow="Premium Auto Group"
        Headline="Drive Your &lt;span class='text-primary'&gt;Dream Car&lt;/span&gt; Today"
        Description="Explore our premium selection of new and certified pre-owned vehicles. Expert staff, competitive financing, and exceptional after-sales service await you."
