@namespace MyStackBlazor.Components.Templates.Landing
@using MyStackBlazor.Components.Blocks
@using MyStackBlazor.Components.Blocks.Landing

<div>
    <StackHeroBlock
        Eyebrow="Trusted since 1947"
        Headline="Banking Built for &lt;span class='text-primary'&gt;Your Future&lt;/span&gt;"
        Description="Global reach. Personal service. Whether you're saving for tomorrow, investing for growth, or financing your next chapter, we have the tools and expertise to help."
        PrimaryCtaText="Open an Account"
        PrimaryCtaHref="#"
        SecondaryCtaText="Explore Products"
        SecondaryCtaHref="#" />

    <StackFeaturesBlock
        Title="Everything your money needs"
        Subtitle="Our products"
        ColsClass="grid-cols-2 lg:grid-cols-4"
        Items="@_features" />

    <StackStatsBlock
        Title="Trusted by millions"
        Items="@_stats" />

    <StackIncentivesBlock
        Title="Why bank with us"
        Subtitle="Our commitment"
        Items="@_incentives"
        Columns="2" />

    <StackPartnersBlock
        Title="Our global network"
        Subtitle="Partners"
        Items="@_partners" />

    <StackContactFormBlock
        Title="We're here to help"
        Eyebrow="Contact"
        Description="Have a question about your account, our products, or anything else? Our team is available 24/7."
        Email="support@intlbank.com"
        Phone="+1 800 555 0100" />

    <StackFooterBlock
        Brand="IntlBank"
        Description="Member FDIC. Equal Housing Lender. © IntlBank Corporation. All deposits insured up to $250,000."
        Sections="@_footerSections"
        Copyright="@($"© {DateTime.Today.Year} IntlBank Corporation. All rights reserved.")" />
</div>

@code {
    private static readonly IList<FeatureItem> _features =
    [
        new("Checking & Savings", "High-yield savings and fee-free checking with no minimums."),
        new("Loans & Mortgages",  "Competitive rates on home, auto, and personal loans."),
        new("Investments",        "Managed portfolios, ETFs, and retirement accounts in one place."),
        new("Business Banking",   "Merchant services, payroll, and credit lines for businesses of any size."),
    ];

    private static readonly IList<StatItem> _stats =
    [
        new("12M+",   "Customers worldwide",    "Across 48 countries"),
        new("$2.4T",  "Assets under management","As of Q1 2026"),
        new("3,800+", "Branch locations",        "Plus 40,000 ATMs"),
        new("99.99%", "Uptime",                  "Digital banking availability"),
    ];

    private static readonly IList<IncentiveItem> _incentives =
    [
        new("FDIC Insured",          "Every deposit is insured up to $250,000 by the Federal Deposit Insurance Corporation."),
        new("Zero Hidden Fees",      "No monthly maintenance fees, no minimum balance requirements, no surprises."),
        new("24/7 Support",          "Reach a real person any time by phone, chat, or our award-winning mobile app."),
        new("Fraud Protection",      "Real-time alerts, biometric login, and zero-liability protection on all transactions."),
    ];

    private static readonly IList<PartnerItem> _partners =
    [
        new("Visa"), new("Mastercard"), new("SWIFT"), new("Fedwire"),
        new("Plaid"), new("Stripe"), new("Bloomberg"), new("Moody's"),
    ];

    private static readonly IList<FooterSection> _footerSections =
    [
        new("Personal",  [new("Checking","#"), new("Savings","#"), new("Mortgages","#"), new("Credit Cards","#")]),
        new("Business",  [new("Business Checking","#"), new("Loans","#"), new("Merchant Services","#"), new("Payroll","#")]),
        new("Company",   [new("About","#"), new("Investor Relations","#"), new("Careers","#"), new("Newsroom","#")]),
    ];
}
