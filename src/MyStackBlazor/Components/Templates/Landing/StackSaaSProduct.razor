@namespace MyStackBlazor.Components.Templates.Landing
@using MyStackBlazor.Components.Blocks
@using MyStackBlazor.Components.Blocks.Landing

<div>
    <StackHeroBlock
        Eyebrow="Now in public beta"
        Headline="Ship Faster with &lt;span class='text-primary'&gt;Less Friction&lt;/span&gt;"
        Description="The all-in-one platform for modern teams. Automate workflows, collaborate in real time, and ship product with confidence — all without duct tape."
        PrimaryCtaText="Start free trial"
        PrimaryCtaHref="#"
        SecondaryCtaText="View demo"
        SecondaryCtaHref="#" />

    <StackPartnersBlock
        Title="Trusted by teams at"
        Items="@_companies" />

    <StackFeaturesBlock
        Title="Everything your team needs"
        Subtitle="Features"
        Items="@_features" />

    <StackStatsBlock Items="@_stats" />

    <StackTestimonialsBlock
        Title="Loved by product teams"
        Subtitle="Testimonials"
        Items="@_testimonials" />

    <StackPricingBlock
        Title="Simple, transparent pricing"
        Subtitle="Pricing"
        Tiers="@_tiers" />

    <StackNewsletterBlock
        Title="Stay in the loop"
        Description="Get product updates, tips, and early access to new features — delivered weekly."
        ButtonText="Subscribe" />

    <StackFooterBlock
        Brand="FlowStack"
        Description="The modern product management platform for teams who ship."
        Sections="@_footerSections"
        Copyright="@($"© {DateTime.Today.Year} FlowStack, Inc. All rights reserved.")" />
</div>

@code {
    private static readonly IList<PartnerItem> _companies =
    [
        new("Stripe"), new("Vercel"), new("Linear"), new("Notion"), new("Figma"), new("GitHub"),
    ];

    private static readonly IList<FeatureItem> _features =
    [
        new("Visual Roadmaps",   "Plan quarters visually. Drag-and-drop epics, milestones, and dependencies on a shared timeline."),
        new("Smart Automations", "Automate repetitive tasks with no-code rules. Save hours every sprint."),
        new("Real-time Collab",  "Edit, comment, and review together — changes appear instantly for every teammate."),
        new("Git Integration",   "Link commits, PRs, and branches to tasks automatically from GitHub, GitLab, or Bitbucket."),
        new("Analytics",         "Track velocity, cycle time, and team health with out-of-the-box engineering metrics."),
        new("Enterprise SSO",    "SAML 2.0, SCIM provisioning, audit logs, and custom roles for enterprise compliance."),
    ];

    private static readonly IList<StatItem> _stats =
    [
        new("85,000+",  "Teams worldwide",        "Across 110 countries"),
        new("99.99%",   "Uptime SLA",             "Over the past 12 months"),
        new("4M+",      "Tasks completed weekly", "By FlowStack teams"),
        new("< 200ms",  "Median API latency",     "Globally distributed"),
    ];

    private static readonly IList<TestimonialItem> _testimonials =
    [
        new("FlowStack replaced four tools we were juggling. Our sprint planning is now half the time and twice as clear.", "Priya Nair", "VP of Engineering, Hexlabs", AvatarInit: "PN", Rating: 5),
        new("The Git integration alone saved my team an hour a day. Every PR links automatically — no more manual updates.", "Ben Carroll", "Lead Developer, Carto", AvatarInit: "BC", Rating: 5),
        new("Onboarding a team of 200 was effortless. SSO, custom roles, and audit logs were configured in under an hour.", "Asha Mehta", "CTO, Ridgepoint", AvatarInit: "AM", Rating: 5),
    ];

    private static readonly IList<PricingTier> _tiers =
    [
        new("Starter", "$0", "/month",
            "Perfect for small teams getting started.",
            [new("Up to 5 members"), new("3 projects"), new("Basic analytics"), new("Community support"), new("SSO", false), new("Custom roles", false)]),
        new("Pro", "$29", "/seat/month",
            "Everything growing teams need to ship confidently.",
            [new("Unlimited members"), new("Unlimited projects"), new("Advanced analytics"), new("Priority support"), new("Git integrations"), new("Custom automations")],
            IsPopular: true,
            ButtonText: "Start free trial"),
        new("Enterprise", "Custom", "",
            "Dedicated infrastructure and compliance for large orgs.",
            [new("All Pro features"), new("SAML SSO & SCIM"), new("Audit logs"), new("SLA guarantee"), new("Dedicated CSM"), new("Custom contract")],
            ButtonText: "Contact sales"),
    ];

    private static readonly IList<FooterSection> _footerSections =
    [
        new("Product",  [new("Features","#"), new("Integrations","#"), new("Changelog","#"), new("Roadmap","#")]),
        new("Resources",[new("Documentation","#"), new("API Reference","#"), new("Blog","#"), new("Status","#")]),
        new("Company",  [new("About","#"), new("Careers","#"), new("Press","#"), new("Contact","#")]),
    ];
}
