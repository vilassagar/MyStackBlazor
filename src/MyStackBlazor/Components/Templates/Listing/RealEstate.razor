@namespace MyStackBlazor.Components.Templates.Listing
@using MyStackBlazor.Components.Blocks
@using MyStackBlazor.Components.Blocks.Landing
@using MyStackBlazor.Components.Blocks.Listing

<div class="min-h-screen bg-background">
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b bg-background">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
            <span class="text-xl font-bold tracking-tight text-foreground">
                <span class="text-primary">Nest</span>Find
            </span>
            <nav class="hidden gap-6 md:flex">
                @foreach (var item in new[] { "Buy", "Rent", "Sell", "Agents", "Mortgage" })
                {
                    <a href="#" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">@item</a>
                }
            </nav>
            <div class="flex items-center gap-2">
                <a href="#" class="hidden rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground hover:bg-muted transition-colors md:block">Sign in</a>
                <a href="#" class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">List property</a>
                <button class="md:hidden rounded-md p-2 text-muted-foreground hover:bg-muted transition-colors"
                        @onclick='() => _flyoutOpen = true'>
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile flyout -->
    <FlyoutNavigation Brand="NestFind"
                      IsOpen="@_flyoutOpen"
                      IsOpenChanged="v => _flyoutOpen = v"
                      Categories="@_navCategories" />

    <!-- Search hero -->
    <div class="bg-primary/5 py-10">
        <div class="mx-auto max-w-3xl px-6 text-center">
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Find your perfect home</h1>
            <p class="mt-2 mb-6 text-muted-foreground">Browse thousands of properties across the country.</p>
            <div class="flex overflow-hidden rounded-xl border bg-background shadow-sm">
                <input type="search" placeholder="City, neighbourhood, or ZIP code"
                       class="flex-1 px-4 py-3 text-sm focus-visible:outline-none" />
                <button class="bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors">
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="mx-auto max-w-7xl px-6 py-8">
        <div class="flex gap-8">
            <!-- Sidebar -->
            <aside class="hidden w-60 flex-shrink-0 lg:block">
                <FilterPanel Title="Filters"
                             Categories="@_filterCategories"
                             OnFilterChange="@(async _ => await Task.CompletedTask)" />
            </aside>

            <!-- Main -->
            <div class="flex-1 min-w-0">
                <SortBar ResultCount="@_listings.Count"
                         SortOptions="@_sortOptions"
                         SelectedSort="_sort"
                         OnSortChanged="s => _sort = s"
                         ViewMode="_view"
                         OnViewModeChanged="v => _view = v" />

                <div class="mt-6 @(_view == "grid" ? "grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" : "flex flex-col gap-4")">
                    @foreach (var listing in _listings)
                    {
                        <article class="group overflow-hidden rounded-xl border bg-card shadow-sm transition-shadow hover:shadow-md">
                            <div class="aspect-video overflow-hidden bg-muted/30 relative">
                                @if (!string.IsNullOrEmpty(listing.BadgeText))
                                {
                                    <span class="absolute left-3 top-3 z-10 rounded-full bg-primary px-2.5 py-0.5 text-xs font-semibold text-primary-foreground">
                                        @listing.BadgeText
                                    </span>
                                }
                                <div class="flex h-full items-center justify-center text-muted-foreground/20">
                                    <svg class="h-16 w-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                    </svg>
                                </div>
                            </div>
                            <div class="p-4">
                                <p class="text-lg font-bold text-foreground">@listing.Price</p>
                                <h3 class="mt-0.5 font-semibold text-foreground group-hover:text-primary transition-colors">@listing.Title</h3>
                                <div class="mt-3 flex gap-4 text-xs text-muted-foreground">
                                    <span>🛏 3 beds</span>
                                    <span>🚿 2 baths</span>
                                    <span>📐 1,420 sqft</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <div class="mt-10 flex justify-center">
                    <button class="rounded-lg border border-primary px-8 py-2.5 text-sm font-medium text-primary transition hover:bg-primary/5">
                        Load more listings
                    </button>
                </div>
            </div>
        </div>
    </div>

    <StatsBlock
        Title="Why NestFind"
        Items="@_stats" />

    <FooterBlock
        Brand="NestFind"
        Description="Connecting buyers, sellers, and renters with their ideal properties since 2010."
        Sections="@_footerSections"
        Copyright="@($"© {DateTime.Today.Year} NestFind Realty Inc. All rights reserved.")" />
</div>

@code {
    private bool   _flyoutOpen;
    private string _sort = "newest";
    private string _view = "grid";

    private static readonly IList<NavCategory> _navCategories =
    [
        new("Buy",      "#", [new("Houses","#"), new("Apartments","#"), new("Condos","#"), new("Townhomes","#")]),
        new("Rent",     "#", [new("Apartments","#"), new("Houses","#"), new("Short-term","#")]),
        new("Sell",     "#"),
        new("Agents",   "#"),
        new("Mortgage", "#"),
    ];

    private static readonly IList<FilterCategory> _filterCategories =
    [
        new("Property type", [new("House","house",124), new("Apartment","apt",231), new("Condo","condo",88), new("Townhome","town",52)]),
        new("Price",         [new("Under $300k","u300",67), new("$300k–$600k","300-600",148), new("Over $600k","o600",83)]),
        new("Bedrooms",      [new("1+","1",104), new("2+","2",196), new("3+","3",142), new("4+","4",61)]),
        new("Status",        [new("For sale","sale",312), new("For rent","rent",86)]),
    ];

    private static readonly IList<SortOption> _sortOptions =
    [
        new("Newest",          "newest"),
        new("Price: Low–High", "price-asc"),
        new("Price: High–Low", "price-desc"),
        new("Most popular",    "popular"),
    ];

    private static readonly IList<ProductItem> _listings =
    [
        new("Sunnybrook Colonial",         "$485,000", null, "For Sale",  4.8m, 12),
        new("Downtown Loft Apartment",     "$2,800/mo", null, "For Rent",  4.6m, 8),
        new("Maple Ridge Family Home",     "$620,000", null, "New",       4.9m, 24),
        new("Riverside Studio",            "$1,650/mo", null, "For Rent",  4.4m, 6),
        new("Oakwood Townhome",            "$395,000", null, "For Sale",  4.7m, 18),
        new("Lakefront Modern Retreat",    "$1.2M",   null, "Luxury",    5.0m, 5),
    ];

    private static readonly IList<StatItem> _stats =
    [
        new("500k+",  "Active listings",       "Updated daily"),
        new("1.2M+",  "Happy homeowners",      "Since 2010"),
        new("4.9/5",  "Agent satisfaction",    "Based on 80,000+ reviews"),
        new("$0",     "Buyer's agent fee",     "We work for you, for free"),
    ];

    private static readonly IList<FooterSection> _footerSections =
    [
        new("Search",  [new("Buy","#"), new("Rent","#"), new("New Builds","#"), new("Foreclosures","#")]),
        new("Tools",   [new("Mortgage Calculator","#"), new("Home Valuation","#"), new("Market Trends","#")]),
        new("Company", [new("About","#"), new("Careers","#"), new("Agents","#"), new("Contact","#")]),
    ];
}
