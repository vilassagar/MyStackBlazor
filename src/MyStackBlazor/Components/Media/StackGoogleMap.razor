@namespace MyStackBlazor.Components.Media
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (string.IsNullOrWhiteSpace(ApiKey))
{
    <div class="@($"flex items-center justify-center rounded-lg border border-dashed border-border bg-muted/30 p-6 text-center text-sm text-muted-foreground {Class}".Trim())"
         style="height:@Height"
         @attributes="AdditionalAttributes">
        Google Maps API key required &mdash; set the <code class="font-mono">ApiKey</code> parameter.
    </div>
}
else
{
    <div @ref="_mapDiv"
         class="@($"overflow-hidden rounded-lg {Class}".Trim())"
         style="height:@Height"
         @attributes="AdditionalAttributes">
    </div>
}

@code {
    /// <summary>A single map marker.</summary>
    public record GoogleMapMarker(double Lat, double Lng, string? Title = null);

    [Parameter] public string? ApiKey { get; set; }
    [Parameter] public double Latitude { get; set; }
    [Parameter] public double Longitude { get; set; }
    [Parameter] public int Zoom { get; set; } = 12;
    [Parameter] public IReadOnlyList<GoogleMapMarker>? Markers { get; set; }
    [Parameter] public string Height { get; set; } = "400px";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _mapDiv;
    private IJSObjectReference? _module;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_initialized || string.IsNullOrWhiteSpace(ApiKey)) return;
        _initialized = true;

        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("loadGoogleMaps", ApiKey);

        var markers = Markers?.Select(m => new { lat = m.Lat, lng = m.Lng, title = m.Title }).ToArray()
                      ?? Array.Empty<object>();

        await module.InvokeVoidAsync("initMap", _mapDiv, Latitude, Longitude, Zoom, markers);
    }

    private async ValueTask<IJSObjectReference> GetModuleAsync()
        => _module ??= await JS.InvokeAsync<IJSObjectReference>(
               "import", "./_content/MyStackBlazor/js/google-map.js");

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
