@namespace MyStackBlazor.Components.Media

<div class="@($"flex flex-col gap-1 {Class}".Trim())" @attributes="AdditionalAttributes">
    <iframe src="@IframeSrc"
            title="PDF viewer"
            class="w-full rounded-lg border border-border"
            style="height:@Height">
    </iframe>
    <div class="text-xs text-muted-foreground">
        Can't view the PDF? <a href="@Src" download class="font-medium text-primary underline underline-offset-2">Download PDF</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public bool ShowToolbar { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string IframeSrc => ShowToolbar ? Src : $"{Src}#toolbar=0";
}
