@namespace MyStackBlazor.Components.Blocks.Landing
@using MyStackBlazor.Components.Blocks
@using MyStackBlazor.Components.Common

<section class="bg-muted/20 py-20 md:py-28 @Class">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="mb-16 text-center">
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-primary">@Subtitle</p>
                }
                <h2 class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">@Title</h2>
            </div>
        }

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in Items)
            {
                <figure class="flex flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm">
                    <!-- Stars -->
                    <div class="flex gap-0.5">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <svg class="h-4 w-4 @(i <= t.Rating ? "text-yellow-400" : "text-muted")" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                            </svg>
                        }
                    </div>
                    <blockquote class="flex-1 text-sm leading-relaxed text-muted-foreground">
                        "@t.Quote"
                    </blockquote>
                    <figcaption class="flex items-center gap-3">
                        <StackAvatar Src="@t.AvatarUrl" Initials="@t.AvatarInit" Size="sm" />
                        <div>
                            <div class="text-sm font-semibold text-foreground">@t.Author</div>
                            <div class="text-xs text-muted-foreground">@t.Role</div>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public string?                  Title    { get; set; } = "Loved by developers";
    [Parameter] public string?                  Subtitle { get; set; } = "Testimonials";
    [Parameter] public IList<TestimonialItem>   Items    { get; set; } = DefaultItems;
    [Parameter] public string?                  Class    { get; set; }

    private static readonly IList<TestimonialItem> DefaultItems =
    [
        new("MyStackBlazor saved us weeks of work. The components are polished and accessible from day one.",
            "Sarah Chen", "Lead Developer, Acme Corp", AvatarInit: "SC", Rating: 5),
        new("The DataTable with infinite scroll is exactly what we needed. No pagination headaches anymore.",
            "Marcus Reid", "Frontend Engineer", AvatarInit: "MR", Rating: 5),
        new("Dark mode, theming, and Tailwind CSS v4 support. This is the Blazor component library I've been waiting for.",
            "Priya Nair", "Full-Stack Developer", AvatarInit: "PN", Rating: 5),
    ];
}
