@namespace MyStackBlazor.Components.Blocks.Landing
@using MyStackBlazor.Components.Blocks

<section class="bg-background py-20 md:py-28 @Class">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
        @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Subtitle))
        {
            <div class="mx-auto mb-16 max-w-2xl text-center">
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">@Subtitle</p>
                }
                @if (!string.IsNullOrEmpty(Title))
                {
                    <h2 class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">@Title</h2>
                }
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p class="mt-4 text-muted-foreground">@Description</p>
                }
            </div>
        }

        <div class="grid gap-8 @ColsClass">
            @foreach (var item in Items)
            {
                <div class="group relative flex flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm transition-shadow hover:shadow-md">
                    <!-- Icon -->
                    <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 text-primary">
                        @if (!string.IsNullOrEmpty(item.IconSvg))
                        {
                            @((MarkupString)item.IconSvg)
                        }
                        else
                        {
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        }
                    </div>
                    <h3 class="text-lg font-semibold text-foreground">@item.Title</h3>
                    <p class="text-sm leading-relaxed text-muted-foreground">@item.Description</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public string?             Title       { get; set; } = "Everything you need";
    [Parameter] public string?             Subtitle    { get; set; } = "Features";
    [Parameter] public string?             Description { get; set; }
    [Parameter] public IList<FeatureItem>  Items       { get; set; } = DefaultItems;
    [Parameter] public int                 Columns     { get; set; } = 3;
    [Parameter] public string?             Class       { get; set; }

    private string ColsClass => Columns switch
    {
        2 => "sm:grid-cols-2",
        4 => "sm:grid-cols-2 lg:grid-cols-4",
        _ => "sm:grid-cols-2 lg:grid-cols-3",
    };

    private static readonly IList<FeatureItem> DefaultItems =
    [
        new("Lightning Fast",    "Built on .NET 10 with Blazor's optimised rendering pipeline.",  null),
        new("Fully Accessible",  "Every component follows WAI-ARIA patterns out of the box.",     null),
        new("Dark Mode Ready",   "First-class light/dark/system theme support via CSS variables.", null),
        new("Tailwind CSS v4",   "Utility-first styling with zero-runtime overhead.",              null),
        new("Typed & Generic",   "Generic components like DataTable<T> keep your code safe.",     null),
        new("Open Source / MIT", "Free forever. Use it anywhere, for anything.",                   null),
    ];
}
