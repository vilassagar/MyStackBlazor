@namespace MyStackBlazor.Components.Blocks.Landing
@using MyStackBlazor.Components.Blocks

<section class="bg-background py-20 @Class">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="mb-14 flex items-end justify-between">
                <div>
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-primary">@Subtitle</p>
                    }
                    <h2 class="text-3xl font-bold tracking-tight text-foreground">@Title</h2>
                </div>
                @if (!string.IsNullOrEmpty(ViewAllHref))
                {
                    <a href="@ViewAllHref" class="text-sm font-medium text-primary hover:underline">View all →</a>
                }
            </div>
        }

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var item in Items)
            {
                <article class="group flex flex-col overflow-hidden rounded-xl border bg-card shadow-sm transition-shadow hover:shadow-md @(item.Href is not null ? "cursor-pointer" : "")">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <div class="aspect-video overflow-hidden">
                            <img src="@item.ImageUrl"
                                 alt="@item.Title"
                                 class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                        </div>
                    }
                    <div class="flex flex-1 flex-col gap-3 p-5">
                        @if (!string.IsNullOrEmpty(item.BadgeText))
                        {
                            <span class="inline-flex self-start rounded-full border border-primary/20 bg-primary/5 px-2.5 py-0.5 text-xs font-semibold text-primary">
                                @item.BadgeText
                            </span>
                        }
                        <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors">@item.Title</h3>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="flex-1 text-sm leading-relaxed text-muted-foreground">@item.Description</p>
                        }
                        @if (!string.IsNullOrEmpty(item.Href))
                        {
                            <a href="@item.Href" class="mt-2 text-sm font-medium text-primary hover:underline">
                                Read more →
                            </a>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public string?                Title      { get; set; } = "Latest updates";
    [Parameter] public string?                Subtitle   { get; set; } = "Blog";
    [Parameter] public string?                ViewAllHref{ get; set; }
    [Parameter] public IList<CardBlockItem>   Items      { get; set; } = DefaultItems;
    [Parameter] public string?                Class      { get; set; }

    private static readonly IList<CardBlockItem> DefaultItems =
    [
        new("Introducing DataTable Infinite Scroll",
            "Load thousands of rows seamlessly without pagination — new in v1.2.",
            null, "New"),
        new("Building Accessible Forms with Blazor",
            "A deep-dive into FormField, FloatingLabel, and validation patterns.",
            null, "Guide"),
        new("Tailwind CSS v4 + Blazor: The Complete Setup",
            "Step-by-step guide to integrating the latest Tailwind release.",
            null, "Tutorial"),
    ];
}
