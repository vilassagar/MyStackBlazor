@namespace MyStackBlazor.Components.Blocks.Listing

<div class="flex min-h-full items-center justify-center px-4 py-12 @Class">
    <div class="w-full max-w-sm">
        <!-- Header -->
        <div class="mb-8 text-center">
            @if (!string.IsNullOrEmpty(LogoUrl))
            {
                <img src="@LogoUrl" alt="@Title" class="mx-auto mb-4 h-10" />
            }
            else if (!string.IsNullOrEmpty(Brand))
            {
                <span class="text-2xl font-bold tracking-tight text-foreground">@Brand</span>
            }
            <h1 class="mt-4 text-2xl font-bold tracking-tight text-foreground">@Title</h1>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="mt-2 text-sm text-muted-foreground">@Subtitle</p>
            }
        </div>

        <!-- Card -->
        <div class="rounded-2xl border bg-card p-8 shadow-sm">
            @if (_error is not null)
            {
                <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2.5 text-sm text-red-700">
                    @_error
                </div>
            }

            <form @onsubmit:preventDefault @onsubmit="Submit" class="space-y-5">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-foreground">Email</label>
                    <input type="email" @bind="_email" required autocomplete="email"
                           class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                </div>
                <div>
                    <div class="mb-1.5 flex items-center justify-between">
                        <label class="text-sm font-medium text-foreground">Password</label>
                        @if (!string.IsNullOrEmpty(ForgotPasswordHref))
                        {
                            <a href="@ForgotPasswordHref" class="text-xs text-primary hover:underline">Forgot password?</a>
                        }
                    </div>
                    <input type="password" @bind="_password" required autocomplete="current-password"
                           class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                </div>

                <button type="submit" disabled="@_loading"
                        class="w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90 disabled:opacity-60">
                    @(_loading ? "Signing in…" : ButtonText)
                </button>
            </form>

            @if (!string.IsNullOrEmpty(SignUpHref))
            {
                <p class="mt-5 text-center text-sm text-muted-foreground">
                    Don't have an account?
                    <a href="@SignUpHref" class="font-medium text-primary hover:underline">Sign up</a>
                </p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string   Title              { get; set; } = "Sign in";
    [Parameter] public string?  Subtitle           { get; set; } = "Welcome back! Please enter your details.";
    [Parameter] public string?  Brand              { get; set; }
    [Parameter] public string?  LogoUrl            { get; set; }
    [Parameter] public string   ButtonText         { get; set; } = "Sign in";
    [Parameter] public string?  ForgotPasswordHref { get; set; } = "#";
    [Parameter] public string?  SignUpHref         { get; set; } = "#";
    [Parameter] public EventCallback<LoginFormData> OnSubmit { get; set; }
    [Parameter] public string?  Class              { get; set; }

    private string _email = "", _password = "";
    private bool   _loading;
    private string? _error;

    private async Task Submit()
    {
        _loading = true;
        _error   = null;
        try
        {
            await OnSubmit.InvokeAsync(new(_email, _password));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    public record LoginFormData(string Email, string Password);
}
