@namespace MyStackBlazor.Components.Blocks.Listing
@using MyStackBlazor.Components.Blocks

<article class="group relative flex flex-col overflow-hidden rounded-xl border bg-card shadow-sm transition-shadow hover:shadow-md @Class">
    <!-- Badge -->
    @if (!string.IsNullOrEmpty(Item.BadgeText))
    {
        <span class="absolute left-3 top-3 z-10 rounded-full bg-primary px-2.5 py-0.5 text-xs font-semibold text-primary-foreground">
            @Item.BadgeText
        </span>
    }
    @if (!Item.IsInStock)
    {
        <span class="absolute right-3 top-3 z-10 rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-muted-foreground">
            Out of stock
        </span>
    }

    <!-- Image -->
    <div class="aspect-square overflow-hidden bg-muted/30">
        @if (!string.IsNullOrEmpty(Item.ImageUrl))
        {
            <img src="@Item.ImageUrl" alt="@Item.Title"
                 class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
        }
        else
        {
            <div class="flex h-full items-center justify-center text-muted-foreground/30">
                <svg class="h-16 w-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
            </div>
        }
    </div>

    <!-- Details -->
    <div class="flex flex-1 flex-col gap-2 p-4">
        <h3 class="line-clamp-2 text-sm font-semibold text-foreground group-hover:text-primary transition-colors">
            @Item.Title
        </h3>

        @if (Item.Rating > 0)
        {
            <div class="flex items-center gap-1.5">
                <div class="flex text-yellow-400">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var filled = i <= (int)Item.Rating;
                        <svg class="h-3.5 w-3.5 @(filled ? "fill-current" : "fill-none")" stroke="currentColor" viewBox="0 0 24 24">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                    }
                </div>
                @if (Item.ReviewCount > 0)
                {
                    <span class="text-xs text-muted-foreground">(@Item.ReviewCount)</span>
                }
            </div>
        }

        <div class="mt-auto flex items-center justify-between pt-2">
            <span class="text-base font-bold text-foreground">@Item.Price</span>
            <button disabled="@(!Item.IsInStock)"
                    @onclick="() => OnAddToCart.InvokeAsync(Item)"
                    class="flex items-center gap-1.5 rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground transition hover:bg-primary/90 disabled:opacity-40 disabled:cursor-not-allowed">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                Add
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter] public ProductItem                  Item       { get; set; } = DefaultItem;
    [Parameter] public EventCallback<ProductItem>   OnAddToCart { get; set; }
    [Parameter] public string?                      Class       { get; set; }

    private static readonly ProductItem DefaultItem = new(
        "Classic Cotton T-Shirt",
        "$29.99",
        null,
        "New",
        Rating: 4.5m,
        ReviewCount: 128);
}
