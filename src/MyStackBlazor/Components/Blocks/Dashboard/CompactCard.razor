@namespace MyStackBlazor.Components.Blocks.Dashboard
@using MyStackBlazor.Components.Blocks

<div class="rounded-xl border bg-card p-5 shadow-sm @Class">
    <div class="flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
            <p class="text-sm text-muted-foreground truncate">@Label</p>
            <p class="mt-1 text-2xl font-bold tracking-tight text-foreground">@Value</p>
            @if (!string.IsNullOrEmpty(Trend))
            {
                <div class="mt-1.5 flex items-center gap-1 text-xs font-medium @(TrendUp ? "text-green-600" : "text-red-500")">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        @if (TrendUp)
                        {
                            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                            <polyline points="17 6 23 6 23 12"></polyline>
                        }
                        else
                        {
                            <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
                            <polyline points="17 18 23 18 23 12"></polyline>
                        }
                    </svg>
                    @Trend
                </div>
            }
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="mt-1 text-xs text-muted-foreground">@Description</p>
            }
        </div>

        @if (!string.IsNullOrEmpty(IconSvg))
        {
            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                @((MarkupString)IconSvg)
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string  Label       { get; set; } = "Total revenue";
    [Parameter] public string  Value       { get; set; } = "$45,231";
    [Parameter] public string? Trend       { get; set; } = "+20.1% from last month";
    [Parameter] public bool    TrendUp     { get; set; } = true;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? IconSvg     { get; set; }
    [Parameter] public string? Class       { get; set; }
}
