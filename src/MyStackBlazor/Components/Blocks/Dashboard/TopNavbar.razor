@namespace MyStackBlazor.Components.Blocks.Dashboard
@using MyStackBlazor.Components.Blocks

<header class="sticky top-0 z-40 border-b bg-background @Class">
    <div class="flex h-16 items-center gap-4 px-4 lg:px-6">
        <!-- Brand -->
        <a href="@BrandHref" class="flex-shrink-0 text-lg font-bold tracking-tight text-foreground">
            @if (!string.IsNullOrEmpty(LogoUrl))
            {
                <img src="@LogoUrl" alt="@Brand" class="h-7" />
            }
            else
            {
                @Brand
            }
        </a>

        <!-- Breadcrumbs -->
        @if (Breadcrumbs?.Count > 0)
        {
            <nav class="hidden items-center gap-1 text-sm text-muted-foreground md:flex">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                @foreach (var (crumb, i) in Breadcrumbs.Select((b, i) => (b, i)))
                {
                    if (i > 0)
                    {
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    }
                    @if (!string.IsNullOrEmpty(crumb.Href) && i < Breadcrumbs.Count - 1)
                    {
                        <a href="@crumb.Href" class="hover:text-foreground transition-colors">@crumb.Label</a>
                    }
                    else
                    {
                        <span class="text-foreground font-medium">@crumb.Label</span>
                    }
                }
            </nav>
        }

        <div class="flex-1"></div>

        <!-- Search -->
        @if (ShowSearch)
        {
            <div class="hidden w-full max-w-xs sm:flex">
                <div class="relative w-full">
                    <svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="search" placeholder="@SearchPlaceholder"
                           class="w-full rounded-md border border-input bg-muted/40 pl-9 pr-3 py-1.5 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                </div>
            </div>
        }

        <!-- Actions -->
        <div class="flex items-center gap-2">
            <!-- Notifications -->
            <button class="relative rounded-md p-2 text-muted-foreground hover:bg-muted hover:text-foreground transition-colors">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                @if (NotificationCount > 0)
                {
                    <span class="absolute right-1 top-1 flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] font-bold text-primary-foreground">
                        @(NotificationCount > 9 ? "9+" : NotificationCount.ToString())
                    </span>
                }
            </button>

            <!-- User avatar -->
            <button class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-muted transition-colors">
                @if (!string.IsNullOrEmpty(UserAvatarUrl))
                {
                    <img src="@UserAvatarUrl" alt="@UserName" class="h-7 w-7 rounded-full object-cover" />
                }
                else
                {
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">
                        @(string.IsNullOrEmpty(UserInitials) ? UserName?.Substring(0,1).ToUpper() : UserInitials)
                    </span>
                }
                <span class="hidden font-medium text-foreground md:block">@UserName</span>
                <svg class="hidden h-3.5 w-3.5 text-muted-foreground md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
        </div>

        @if (EndContent is not null)
        {
            @EndContent
        }
    </div>
</header>

@code {
    [Parameter] public string                   Brand              { get; set; } = "Dashboard";
    [Parameter] public string                   BrandHref          { get; set; } = "#";
    [Parameter] public string?                  LogoUrl            { get; set; }
    [Parameter] public bool                     ShowSearch         { get; set; } = true;
    [Parameter] public string                   SearchPlaceholder  { get; set; } = "Search…";
    [Parameter] public string?                  UserName           { get; set; } = "Admin";
    [Parameter] public string?                  UserInitials       { get; set; }
    [Parameter] public string?                  UserAvatarUrl      { get; set; }
    [Parameter] public int                      NotificationCount  { get; set; }
    [Parameter] public IList<NavBreadcrumb>?    Breadcrumbs        { get; set; }
    [Parameter] public RenderFragment?          EndContent         { get; set; }
    [Parameter] public string?                  Class              { get; set; }
}
