@namespace MyStackBlazor.Components.Common

<span class="@ComputedClass" @attributes="AdditionalAttributes">
    @if (Icon is not null)
    {
        <span class="flex items-center">@Icon</span>
    }
    @ChildContent
    @if (OnRemove.HasDelegate)
    {
        <button type="button"
                class="ml-0.5 inline-flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full hover:bg-black/20 dark:hover:bg-white/20 focus:outline-none focus:ring-1 focus:ring-ring"
                aria-label="Remove"
                @onclick="OnRemove"
                @onclick:stopPropagation="true">
            <svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    }
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass =>
        $"inline-flex items-center gap-1 rounded-full border font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 {SizeClass} {VariantClass} {Class}".Trim();

    private string SizeClass => Size switch
    {
        "sm" => "px-2 py-0 text-xs",
        "lg" => "px-3 py-1 text-sm",
        _    => "px-2.5 py-0.5 text-xs",
    };

    private string VariantClass => Variant switch
    {
        "secondary"   => "border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80",
        "destructive" => "border-transparent bg-destructive text-destructive-foreground hover:bg-destructive/80",
        "success"     => "border-transparent bg-green-500 text-white hover:bg-green-500/80",
        "warning"     => "border-transparent bg-yellow-500 text-white hover:bg-yellow-500/80",
        "outline"     => "border-border text-foreground bg-transparent",
        _             => "border-transparent bg-primary text-primary-foreground hover:bg-primary/80",
    };
}
