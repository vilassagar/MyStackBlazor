@namespace MyStackBlazor.Components.Common

<div role="@Role"
     tabindex="@(Disabled ? null : "0")"
     aria-selected="@(Selected ? "true" : null)"
     aria-disabled="@(Disabled ? "true" : null)"
     class="@ComputedClass"
     @onclick="HandleClick"
     @onkeydown="HandleKeyDown"
     @attributes="AdditionalAttributes">
    @if (Icon is not null)
    {
        <span class="@IconClass">@Icon</span>
    }
    <span class="flex-1 truncate">@ChildContent</span>
    @if (!string.IsNullOrEmpty(Shortcut))
    {
        <span class="@ShortcutClass">@Shortcut</span>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string? Shortcut { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public string Role { get; set; } = "option";
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var sizeClass = Size switch
            {
                "sm" => "px-2 py-1 text-xs rounded-sm",
                "lg" => "px-4 py-3 text-base rounded-md",
                _    => "px-3 py-2 text-sm rounded-sm",
            };
            var stateClass = Disabled
                ? "pointer-events-none opacity-50 cursor-not-allowed"
                : Selected
                    ? "bg-accent text-accent-foreground cursor-default"
                    : "hover:bg-accent hover:text-accent-foreground cursor-pointer";
            return $"relative flex w-full select-none items-center gap-2 outline-none transition-colors focus:bg-accent focus:text-accent-foreground {sizeClass} {stateClass} {Class}".Trim();
        }
    }

    private string IconClass => Size switch
    {
        "sm" => "[&_svg]:h-3 [&_svg]:w-3 shrink-0 text-muted-foreground",
        "lg" => "[&_svg]:h-5 [&_svg]:w-5 shrink-0 text-muted-foreground",
        _    => "[&_svg]:h-4 [&_svg]:w-4 shrink-0 text-muted-foreground",
    };

    private string ShortcutClass => "ml-auto text-xs tracking-widest text-muted-foreground";

    private async Task HandleClick()
    {
        if (!Disabled) await OnClick.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!Disabled && e.Key is "Enter" or " ") await OnClick.InvokeAsync();
    }
}
