@namespace MyStackBlazor.Components.Common
@inject ThemeService ThemeService
@implements IDisposable

<button type="button"
        aria-label="@(ThemeService.IsDark ? "Switch to light theme" : "Switch to dark theme")"
        class="@($"inline-flex items-center justify-center rounded-md p-2 text-sm font-medium ring-offset-background transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 {Class}".Trim())"
        @onclick="Toggle"
        @attributes="AdditionalAttributes">
    @if (ThemeService.IsDark)
    {
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" aria-hidden="true" focusable="false"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" aria-hidden="true" focusable="false"
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
    }
    @if (ShowLabel)
    {
        <span class="ml-2">@(ThemeService.IsDark ? "Light" : "Dark")</span>
    }
</button>

@code {
    [Parameter] public bool ShowLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized() =>
        ThemeService.OnThemeChanged += StateHasChanged;

    private void Toggle() => ThemeService.Toggle();

    public void Dispose() =>
        ThemeService.OnThemeChanged -= StateHasChanged;
}
