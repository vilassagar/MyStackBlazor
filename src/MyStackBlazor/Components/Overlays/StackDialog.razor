@namespace MyStackBlazor.Components.Overlays
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black/80 animate-fade-in" @onclick="CloseOnBackdrop"></div>
        <!-- Panel -->
        <div @ref="_panel" role="dialog"
             tabindex="-1"
             aria-modal="true"
             aria-label="@(AriaLabelledBy is null ? AriaLabel : null)"
             aria-labelledby="@AriaLabelledBy"
             aria-describedby="@AriaDescribedBy"
             @onkeydown="OnKeyDown"
             @onkeydown:stopPropagation="true"
             class="@($"relative z-50 grid w-full max-w-lg gap-4 border bg-background p-6 shadow-lg animate-fade-in sm:rounded-lg {Class}".Trim())"
             @attributes="AdditionalAttributes">
            @ChildContent
            <button type="button"
                    class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
                    @onclick="Close"
                    aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "Dialog";
    [Parameter] public string? AriaLabelledBy { get; set; }
    [Parameter] public string? AriaDescribedBy { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _panel;
    private IJSObjectReference? _module;
    private readonly string _focusId = Guid.NewGuid().ToString("N");
    private bool _active;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen == _active) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/MyStackBlazor/js/dialog.js");
            if (IsOpen) await _module.InvokeVoidAsync("activate", _focusId, _panel);
            else await _module.InvokeVoidAsync("deactivate", _focusId);
            _active = IsOpen;
        }
        catch (JSDisconnectedException) { }
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && CloseOnEscape)
        {
            // Only the topmost modal handles Escape (including nested dialogs).
            if (_module is not null && await _module.InvokeAsync<bool>("isTop", _focusId)) await Close();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("deactivate", _focusId);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task CloseOnBackdrop()
    {
        if (CloseOnBackdropClick) await Close();
    }
}
