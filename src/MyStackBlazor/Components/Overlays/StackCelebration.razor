@namespace MyStackBlazor.Components.Overlays
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_showMessage && HasMessage)
{
    <div class="pointer-events-none fixed inset-0 z-[10000] flex items-center justify-center p-4">
        <div class="msb-celebrate-pop pointer-events-auto w-full max-w-sm rounded-xl border border-border bg-background p-6 text-center shadow-2xl"
             role="status" aria-live="polite">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @if (!string.IsNullOrEmpty(Emoji))
                {
                    <div class="mb-2 text-5xl" aria-hidden="true">@Emoji</div>
                }
                @if (!string.IsNullOrEmpty(Title))
                {
                    <h2 class="text-xl font-semibold text-foreground">@Title</h2>
                }
                @if (!string.IsNullOrEmpty(Message))
                {
                    <p class="mt-1 text-sm text-muted-foreground">@Message</p>
                }
            }
            @if (Dismissible)
            {
                <button type="button"
                        class="mt-4 inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90"
                        @onclick="DismissAsync">@DismissText</button>
            }
        </div>
    </div>
    <style>
        @@keyframes msb-celebrate-pop { 0% { opacity: 0; transform: scale(.85) } 60% { opacity: 1; transform: scale(1.04) } 100% { transform: scale(1) } }
        .msb-celebrate-pop { animation: msb-celebrate-pop .35s ease-out; }
        @@media (prefers-reduced-motion: reduce) { .msb-celebrate-pop { animation: none; } }
    </style>
}

@code {
    /// <summary>Plays the celebration whenever this goes from false to true. Bind it (<c>@bind-Active</c>) to have it reset when finished.</summary>
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<bool> ActiveChanged { get; set; }

    /// <summary>Confetti duration in milliseconds. The message stays up for the same time unless <see cref="Dismissible"/>.</summary>
    [Parameter] public int Duration { get; set; } = 3000;
    [Parameter] public int ParticleCount { get; set; } = 160;
    /// <summary>CSS colors for the confetti. Null uses a bright default palette.</summary>
    [Parameter] public IReadOnlyList<string>? Colors { get; set; }
    /// <summary>Burst origin as fractions of the viewport (0–1).</summary>
    [Parameter] public double OriginX { get; set; } = 0.5;
    [Parameter] public double OriginY { get; set; } = 0.6;

    [Parameter] public string? Emoji { get; set; } = "🎉";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    /// <summary>Custom message card content (replaces Emoji/Title/Message).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Keep the message until the user closes it.</summary>
    [Parameter] public bool Dismissible { get; set; }
    [Parameter] public string DismissText { get; set; } = "Awesome!";

    /// <summary>Raised when the celebration ends (or is dismissed).</summary>
    [Parameter] public EventCallback OnFinished { get; set; }

    private IJSObjectReference? _module;
    private bool _lastActive;
    private bool _showMessage;
    private int _runId;

    private bool HasMessage => ChildContent is not null || !string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Message);

    protected override void OnParametersSet()
    {
        var start = Active && !_lastActive;
        _lastActive = Active;
        // Fire and forget: the animation runs for seconds and must not hold up this render.
        if (start) _ = CelebrateAsync();
    }

    /// <summary>Plays the celebration now.</summary>
    public async Task CelebrateAsync()
    {
        var run = ++_runId;
        _showMessage = true;
        StateHasChanged();

        var confetti = BurstAsync();
        var hold = Dismissible ? Task.CompletedTask : Task.Delay(Duration);
        await Task.WhenAll(confetti, hold);

        if (run != _runId || Dismissible) return;
        await FinishAsync();
    }

    private async Task BurstAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/MyStackBlazor/js/celebration.js");
            await _module.InvokeVoidAsync("burst", new
            {
                particleCount = ParticleCount,
                durationMs = Duration,
                colors = Colors,
                originX = OriginX,
                originY = OriginY,
            });
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { } // prerendering
    }

    private async Task DismissAsync()
    {
        _runId++;
        await FinishAsync();
    }

    private async Task FinishAsync()
    {
        _showMessage = false;
        if (Active && ActiveChanged.HasDelegate)
        {
            _lastActive = false;
            await ActiveChanged.InvokeAsync(false);
        }
        await OnFinished.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _runId++;
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
