@namespace MyStackBlazor.Components.Overlays
@inject DialogService DialogService
@implements IDisposable

<!-- Place this once in App.razor / MainLayout.razor -->
<StackAlertDialog IsOpen="DialogService.Current is not null"
                   Title="DialogService.Current?.Title"
                   Description="DialogService.Current?.Message"
                   ConfirmText="@(DialogService.Current?.ConfirmText ?? "Continue")"
                   CancelText="@(DialogService.Current?.CancelText ?? "Cancel")"
                   OnConfirm="() => DialogService.Resolve(true)"
                   OnCancel="() => DialogService.Resolve(false)" />

@if (DialogService.CurrentMessageBox is { } mb)
{
    <StackMessageBox @key="mb"
                     IsOpen="true"
                     Title="@mb.Options.Title"
                     Message="@mb.Options.Message"
                     YesText="@mb.Options.YesText"
                     NoText="@mb.Options.NoText"
                     CancelText="@mb.Options.CancelText"
                     Destructive="@mb.Options.Destructive"
                     CloseOnBackdropClick="@mb.Options.CloseOnBackdropClick"
                     OnResult="r => DialogService.ResolveMessageBox(r)">
        @mb.Options.Content
    </StackMessageBox>
}

@code {
    protected override void OnInitialized() =>
        DialogService.OnChanged += OnServiceChanged;

    private void OnServiceChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() =>
        DialogService.OnChanged -= OnServiceChanged;
}
