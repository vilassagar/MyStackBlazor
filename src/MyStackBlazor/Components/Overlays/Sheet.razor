@namespace MyStackBlazor.Components.Overlays

@if (IsOpen)
{
    <div class="fixed inset-0 z-50">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black/80 animate-fade-in" @onclick="CloseOnBackdrop"></div>
        <!-- Panel -->
        <div role="dialog"
             aria-modal="true"
             class="@ComputedClass"
             @attributes="AdditionalAttributes">
            <button type="button"
                    class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring"
                    @onclick="Close"
                    aria-label="Close">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Side { get; set; } = "right";
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => Side switch
    {
        "left"   => $"fixed left-0 inset-y-0 h-full w-3/4 sm:max-w-sm border-r bg-background p-6 shadow-lg animate-slide-in-from-right {Class}".Trim(),
        "top"    => $"fixed top-0 inset-x-0 w-full border-b bg-background p-6 shadow-lg {Class}".Trim(),
        "bottom" => $"fixed bottom-0 inset-x-0 w-full border-t bg-background p-6 shadow-lg animate-slide-in-from-bottom {Class}".Trim(),
        _        => $"fixed right-0 inset-y-0 h-full w-3/4 sm:max-w-sm border-l bg-background p-6 shadow-lg animate-slide-in-from-right {Class}".Trim(),
    };

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task CloseOnBackdrop()
    {
        if (CloseOnBackdropClick) await Close();
    }
}
