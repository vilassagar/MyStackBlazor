@namespace MyStackBlazor.Components.Form
@inject IJSRuntime JS

@if (ChildContent is not null)
{
    <span @onclick="DownloadAsync" class="@Class cursor-pointer" @attributes="AdditionalAttributes">
        @ChildContent
    </span>
}
else
{
    <button type="button"
            class="@ButtonClass"
            @onclick="DownloadAsync"
            disabled="@_isDownloading"
            @attributes="AdditionalAttributes">
        @if (_isDownloading)
        {
            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z" />
            </svg>
        }
        else
        {
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
        }
        <span>@(Label ?? FileName ?? "Download")</span>
    </button>
}

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public byte[]? Data { get; set; }
    [Parameter] public string FileName { get; set; } = "download";
    [Parameter] public string ContentType { get; set; } = "application/octet-stream";
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isDownloading;

    private string ButtonClass =>
        $"inline-flex items-center gap-2 rounded-md border border-border bg-background px-3 py-2 text-sm " +
        $"font-medium shadow-sm transition-colors hover:bg-muted focus:outline-none focus:ring-2 focus:ring-ring " +
        $"disabled:pointer-events-none disabled:opacity-50 {Class}".Trim();

    private async Task DownloadAsync()
    {
        if (_isDownloading) return;
        _isDownloading = true;
        try
        {
            if (!string.IsNullOrEmpty(Url))
            {
                await JS.InvokeVoidAsync("MyStackBlazor.downloadFromUrl", Url, FileName);
            }
            else if (Data is not null)
            {
                var base64 = Convert.ToBase64String(Data);
                await JS.InvokeVoidAsync("MyStackBlazor.downloadFile", FileName, ContentType, base64);
            }
        }
        finally
        {
            _isDownloading = false;
        }
    }
}
