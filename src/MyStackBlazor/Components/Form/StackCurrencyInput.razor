@namespace MyStackBlazor.Components.Form
@using System.Globalization
@using System.Linq.Expressions
@implements IDisposable

<div class="@ContainerClass">
    <span class="flex items-center pl-3 text-sm text-muted-foreground select-none">@CurrencySymbol</span>
    <input type="text"
           inputmode="decimal"
           id="@Id"
           value="@DisplayValue"
           disabled="@Disabled"
           readonly="@ReadOnly"
           aria-invalid="@(IsInvalid ? "true" : null)"
           placeholder="@Placeholder"
           class="flex h-full w-full rounded-md bg-transparent px-2 py-2 text-sm placeholder:text-muted-foreground focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
           @oninput="OnInputChanged"
           @onfocus="OnFocus"
           @onblur="OnBlur"
           @attributes="AdditionalAttributes" />
    @if (ShowStepper)
    {
        <div class="flex flex-col border-l-2 border-input">
            <button type="button"
                    class="flex flex-1 items-center justify-center px-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground disabled:pointer-events-none disabled:opacity-50"
                    aria-label="@IncrementLabel"
                    disabled="@IsIncrementDisabled"
                    @onclick="Increment">
                <svg aria-hidden="true" focusable="false" class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <polyline points="18 15 12 9 6 15"></polyline>
                </svg>
            </button>
            <button type="button"
                    class="flex flex-1 items-center justify-center border-t-2 border-input px-2 text-muted-foreground hover:bg-accent hover:text-accent-foreground disabled:pointer-events-none disabled:opacity-50"
                    aria-label="@DecrementLabel"
                    disabled="@IsDecrementDisabled"
                    @onclick="Decrement">
                <svg aria-hidden="true" focusable="false" class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }
    [Parameter] public decimal? Min { get; set; }
    [Parameter] public decimal? Max { get; set; }
    [Parameter] public decimal Step { get; set; } = 1;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowStepper { get; set; } = true;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string CurrencySymbol { get; set; } = "$";
    [Parameter] public int DecimalPlaces { get; set; } = 2;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }


    [Parameter] public Expression<Func<decimal?>>? ValueExpression { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string IncrementLabel { get; set; } = "Increase value";
    [Parameter] public string DecrementLabel { get; set; } = "Decrease value";
    [Parameter] public string ParsingErrorMessage { get; set; } = "Enter a valid number.";
    [Parameter] public string PrecisionErrorMessage { get; set; } = "Enter an amount with fewer decimal places.";
    [Parameter] public string RangeErrorMessage { get; set; } = "Enter an amount within the allowed range.";
    [Parameter] public CultureInfo? Culture { get; set; }
    [CascadingParameter] private EditContext? EditContext { get; set; }

    private EditContext? _validationContext;
    private FieldIdentifier? _field;
    private ValidationMessageStore? _messages;
    private string? _inputText;
    private string? _inputError;
    private decimal? _lastValue;
    private bool _focused;
    private CultureInfo ActiveCulture => Culture ?? CultureInfo.CurrentCulture;

    private bool IsInvalid => _inputError is not null ||
        (_field is { } fieldId && _validationContext?.GetValidationMessages(fieldId).Any() == true);
    private bool IsIncrementDisabled => Disabled || ReadOnly || (Max.HasValue && Value.HasValue && Value >= Max);
    private bool IsDecrementDisabled => Disabled || ReadOnly || (Min.HasValue && Value.HasValue && Value <= Min);

    private string ContainerClass =>
        $"relative flex h-10 w-full items-stretch overflow-hidden rounded-md border-2 border-input bg-background ring-offset-background focus-within:ring-2 focus-within:ring-ring focus-within:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 {Class}".Trim();

    private string? DisplayValue => _inputText ?? (Value is { } amount ? FormatAmount(amount, grouped: !_focused) : null);

    private string FormatAmount(decimal amount, bool grouped)
    {
        var format = (grouped ? "#,0" : "0") +
            (DecimalPlaces == 0 ? "." : "." + new string('0', DecimalPlaces)) +
            new string('#', 28 - DecimalPlaces);
        return amount.ToString(format, ActiveCulture);
    }

    protected override void OnParametersSet()
    {
        if (Min.HasValue && Max.HasValue && Min > Max)
            throw new ArgumentException("Min cannot be greater than Max.");
        if (Step <= 0)
            throw new ArgumentOutOfRangeException(nameof(Step), "Numeric settings must be finite and Step must be positive.");
        if (DecimalPlaces is < 0 or > 28) throw new ArgumentOutOfRangeException(nameof(DecimalPlaces));

        FieldIdentifier? nextField = ValueExpression is null ? null : FieldIdentifier.Create(ValueExpression);
        if (!ReferenceEquals(EditContext, _validationContext) || !Nullable.Equals(nextField, _field))
        {
            DetachValidation();
            _validationContext = EditContext;
            _field = nextField;
            if (_validationContext is not null)
            {
                _validationContext.OnValidationStateChanged += OnValidationStateChanged;
                _messages = new ValidationMessageStore(_validationContext);
                if (_inputError is { } error && _field is { } invalidField) _messages.Add(invalidField, error);
            }
        }
        if (Value != _lastValue)
        {
            _lastValue = Value;
            _inputText = null;
            SetInputError(null);
        }
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    private void SetInputError(string? error)
    {
        _inputError = error;
        _messages?.Clear();
        if (error is not null && _field is { } fieldId) _messages?.Add(fieldId, error);
        _validationContext?.NotifyValidationStateChanged();
    }

    private void OnFocus()
    {
        _focused = true;
        _inputText ??= Value is { } amount ? FormatAmount(amount, grouped: false) : null;
    }
    private void OnBlur()
    {
        _focused = false;
        if (_inputError is null) _inputText = null;
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        if (Disabled || ReadOnly) return;
        var raw = e.Value?.ToString();
        _inputText = raw;
        if (string.IsNullOrWhiteSpace(raw))
        {
            await SetValueAsync(null, preserveText: true);
            return;
        }
        // Parsing and formatting use the same culture, including decimal/group separators.
        var parseCulture = (CultureInfo)ActiveCulture.Clone();
        parseCulture.NumberFormat.CurrencySymbol = CurrencySymbol;
        string? error = null;
        if (!decimal.TryParse(raw, NumberStyles.Currency, parseCulture, out var parsed))
            error = ParsingErrorMessage;
        else if (decimal.Round(parsed, DecimalPlaces) != parsed)
            error = PrecisionErrorMessage;
        else if (Clamp(parsed) != parsed)
            error = RangeErrorMessage;

        if (error is null)
            await SetValueAsync(parsed, preserveText: true);
        else
        {
            SetInputError(error);
            if (_field is { } fieldId) _validationContext?.NotifyFieldChanged(fieldId);
        }
    }

    private async Task SetValueAsync(decimal? value, bool preserveText = false)
    {
        SetInputError(null);
        Value = value;
        _lastValue = value;
        if (!preserveText) _inputText = null;
        await ValueChanged.InvokeAsync(value);
        if (_field is { } fieldId) _validationContext?.NotifyFieldChanged(fieldId);
    }

    private async Task Increment()
    {
        if (IsIncrementDisabled) return;
        decimal next;
        try { next = (Value ?? 0) + Step; }
        catch (OverflowException) { next = decimal.MaxValue; }
        await SetValueAsync(Clamp(next));
    }

    private async Task Decrement()
    {
        if (IsDecrementDisabled) return;
        decimal next;
        try { next = (Value ?? 0) - Step; }
        catch (OverflowException) { next = decimal.MinValue; }
        await SetValueAsync(Clamp(next));
    }

    private decimal Clamp(decimal value)
    {
        if (Min.HasValue && value < Min.Value) return Min.Value;
        if (Max.HasValue && value > Max.Value) return Max.Value;
        return value;
    }

    private void DetachValidation()
    {
        if (_validationContext is null) return;
        _validationContext.OnValidationStateChanged -= OnValidationStateChanged;
        _messages?.Clear();
        _validationContext.NotifyValidationStateChanged();
        _messages = null;
    }

    public void Dispose() => DetachValidation();
}
