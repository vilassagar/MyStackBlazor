@namespace MyStackBlazor.Components.Form
@typeparam TItem

<div class="relative @Class" @attributes="AdditionalAttributes">
    <button type="button"
            class="flex h-10 w-full cursor-pointer items-center justify-between rounded-md border-2 border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            role="combobox"
            aria-expanded="@(_open ? "true" : "false")"
            aria-haspopup="grid"
            @onclick="Toggle"
            @onkeydown="HandleKey">
        <span class="@(Value is null ? "text-muted-foreground" : "truncate")">
            @(Value is not null ? (GetLabel?.Invoke(Value) ?? Value?.ToString() ?? "") : (Placeholder ?? "Select…"))
        </span>
        <svg class="h-4 w-4 flex-shrink-0 opacity-50 transition-transform @(_open ? "rotate-180" : "")"
             aria-hidden="true" focusable="false"
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <polyline points="6 9 12 15 18 9" />
        </svg>
    </button>

    @if (_open)
    {
        <div class="absolute z-50 mt-1 w-full min-w-max overflow-hidden rounded-md border border-border bg-popover text-popover-foreground shadow-md">
            @if (Searchable)
            {
                <div class="border-b px-3 py-2">
                    <input type="text"
                           placeholder="@SearchPlaceholder"
                           aria-label="Search"
                           class="w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground"
                           value="@_search"
                           @oninput="e => _search = e.Value?.ToString() ?? string.Empty"
                           @onclick:stopPropagation="true" />
                </div>
            }
            <div class="max-h-72 overflow-auto">
                <table class="w-full text-sm" role="grid">
                    <thead class="sticky top-0 bg-popover">
                        <tr class="border-b">
                            @foreach (var col in Columns)
                            {
                                <th class="px-3 py-2 text-left text-xs font-medium text-muted-foreground whitespace-nowrap"
                                    style="@(col.Width is not null ? $"width:{col.Width}" : "")">
                                    @col.Header
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredItems)
                        {
                            var fi  = item;
                            var sel = EqualityComparer<TItem>.Default.Equals(fi, Value);
                            <tr class="cursor-pointer transition-colors @(sel ? "bg-accent" : "hover:bg-accent/50")"
                                role="row"
                                aria-selected="@(sel ? "true" : "false")"
                                @onclick="() => SelectItem(fi)">
                                @foreach (var col in Columns)
                                {
                                    var c = col;
                                    <td class="whitespace-nowrap px-3 py-1.5" role="gridcell">@c.Value(fi)</td>
                                }
                            </tr>
                        }
                        @if (!FilteredItems.Any())
                        {
                            <tr role="row">
                                <td class="px-3 py-6 text-center text-muted-foreground"
                                    role="gridcell"
                                    colspan="@Columns.Count">
                                    No results
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem>                           Items            { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<MultiColumnComboBoxColumn<TItem>> Columns         { get; set; } = [];
    [Parameter] public Func<TItem, string>?                                            GetLabel        { get; set; }
    [Parameter] public TItem?                                                           Value           { get; set; }
    [Parameter] public EventCallback<TItem?>                                            ValueChanged    { get; set; }
    [Parameter] public bool                                                             Searchable      { get; set; } = true;
    [Parameter] public string                                                           SearchPlaceholder { get; set; } = "Search…";
    [Parameter] public string?                                                          Placeholder     { get; set; }
    [Parameter] public string?                                                          Class           { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool   _open;
    private string _search = "";

    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search)) return Items;
            return Items.Where(item =>
                Columns.Any(col =>
                    col.Value(item)?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true));
        }
    }

    private void Toggle() => _open = !_open;

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "ArrowDown") _open = true;
        else if (e.Key is "Escape")                  _open = false;
    }

    private async Task SelectItem(TItem item)
    {
        Value   = item;
        _open   = false;
        _search = "";
        await ValueChanged.InvokeAsync(Value);
    }
}
