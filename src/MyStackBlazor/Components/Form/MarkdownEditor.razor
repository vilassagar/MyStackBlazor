@namespace MyStackBlazor.Components.Form
@inject IJSRuntime JS
@using System.Text
@using System.Text.RegularExpressions

<div class="flex flex-col rounded-md border border-border bg-background @Class" @attributes="AdditionalAttributes">
    @* ── Toolbar ── *@
    @if (ShowToolbar)
    {
        <div class="flex flex-wrap items-center gap-0.5 border-b px-2 py-1.5" role="toolbar" aria-label="Markdown formatting">
            @foreach (var btn in _toolbarButtons)
            {
                var b = btn;
                <button type="button"
                        class="flex h-7 min-w-7 items-center justify-center rounded px-1.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        aria-label="@b.Label"
                        title="@b.Label"
                        @onclick="() => ApplyFormat(b.Before, b.After, b.Default)">
                    @if (b.IsIcon)
                    {
                        @((MarkupString)b.Icon)
                    }
                    else
                    {
                        @b.Icon
                    }
                </button>
                @if (b.Separator)
                {
                    <span class="mx-1 h-4 w-px bg-border" aria-hidden="true"></span>
                }
            }

            <span class="ml-auto flex rounded-md border border-border text-xs" role="group" aria-label="View mode">
                @foreach (var (label, mode) in new[] { ("Edit", "edit"), ("Split", "split"), ("Preview", "preview") })
                {
                    var m = mode;
                    <button type="button"
                            class="px-2 py-1 transition-colors @(_viewMode == m ? "bg-accent font-medium text-foreground" : "text-muted-foreground hover:bg-muted")"
                            aria-label="@label"
                            aria-pressed="@(_viewMode == m ? "true" : "false")"
                            @onclick="() => _viewMode = m">
                        @label
                    </button>
                }
            </span>
        </div>
    }

    @* ── Editor + Preview ── *@
    <div class="flex min-h-0 flex-1 @(_viewMode == "split" ? "divide-x" : "")">
        @if (_viewMode != "preview")
        {
            <textarea id="@_id"
                      @ref="_textareaEl"
                      class="flex-1 resize-none bg-transparent p-3 font-mono text-sm leading-relaxed placeholder:text-muted-foreground focus-visible:outline-none"
                      style="min-height:@(Rows * 1.5)rem"
                      placeholder="@(Placeholder ?? "Write markdown here…")"
                      spellcheck="false"
                      aria-label="@(Label ?? "Markdown editor")"
                      aria-multiline="true"
                      value="@Value"
                      @oninput="OnInput" />
        }
        @if (_viewMode != "edit")
        {
            <div class="flex-1 overflow-auto p-4 text-sm leading-relaxed prose-sm prose"
                 aria-label="Markdown preview"
                 aria-live="polite">
                @if (string.IsNullOrWhiteSpace(Value))
                {
                    <p class="text-muted-foreground italic">Nothing to preview</p>
                }
                else
                {
                    @((MarkupString)ParseMarkdown(Value))
                }
            </div>
        }
    </div>

    @* ── Status bar ── *@
    <div class="flex items-center justify-between border-t px-3 py-1 text-xs text-muted-foreground">
        <span>@_wordCount @(_wordCount == 1 ? "word" : "words")</span>
        <span>@(Value?.Length ?? 0) chars</span>
    </div>
</div>

@code {
    [Parameter] public string?             Value       { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string?             Placeholder { get; set; }
    [Parameter] public string?             Label       { get; set; }
    [Parameter] public int                 Rows        { get; set; } = 14;
    [Parameter] public bool                ShowToolbar { get; set; } = true;
    [Parameter] public string?             Class       { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string _viewMode = "split";
    private ElementReference _textareaEl;
    private readonly string _id = $"mde-{Guid.NewGuid():N}";

    private int _wordCount =>
        string.IsNullOrWhiteSpace(Value) ? 0
        : Value!.Split((char[])[' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries).Length;

    // ── Toolbar definition ───────────────────────────────────────────────

    private sealed record ToolbarButton(string Label, string Icon, string Before, string After,
        string Default = "text", bool IsIcon = false, bool Separator = false);

    private static readonly IReadOnlyList<ToolbarButton> _toolbarButtons =
    [
        new("Heading 1",   "H1", "\n# ",   "",   "Heading"),
        new("Heading 2",   "H2", "\n## ",  "",   "Heading"),
        new("Heading 3",   "H3", "\n### ", "",   "Heading", Separator: true),
        new("Bold",        """<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>""",
                           "**",  "**",  "bold text",   true),
        new("Italic",      """<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg>""",
                           "*",   "*",   "italic text", true),
        new("Inline Code", """<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>""",
                           "`",   "`",   "code",        true, Separator: true),
        new("Blockquote",  """<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>""",
                           "\n> ", "",   "quote",       true),
        new("Code Block",  "```", "\n```\n", "\n```",  "code block"),
        new("Bullet List", "—",   "\n- ",  "",   "List item"),
        new("Numbered List","1.", "\n1. ", "",   "List item", Separator: true),
        new("Horizontal Rule", "HR", "\n---\n", "", ""),
        new("Link",        """<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>""",
                           "[",   "](url)",  "Link text", true),
        new("Image",       """<svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>""",
                           "![",  "](url)",  "alt text",  true),
    ];

    // ── Event handlers ──────────────────────────────────────────────────

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task ApplyFormat(string before, string after, string defaultText)
    {
        try
        {
            var newValue = await JS.InvokeAsync<string>(
                "MyStackBlazor.insertAtCursor", _textareaEl, before, after, defaultText);
            Value = newValue;
            await ValueChanged.InvokeAsync(Value);
        }
        catch { }
    }

    // ── Markdown parser ─────────────────────────────────────────────────

    private static string ParseMarkdown(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "";

        var sb   = new StringBuilder();
        var lines = markdown.Split('\n');
        var inCodeBlock  = false;
        var codeContent  = new StringBuilder();
        var inUl = false;
        var inOl = false;

        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimEnd();

            if (line.StartsWith("```"))
            {
                if (inCodeBlock)
                {
                    CloseLists(sb, ref inUl, ref inOl);
                    sb.Append($"<pre class=\"my-2 overflow-auto rounded bg-muted p-3 text-xs font-mono\"><code>{codeContent}</code></pre>");
                    codeContent.Clear();
                    inCodeBlock = false;
                }
                else
                {
                    CloseLists(sb, ref inUl, ref inOl);
                    inCodeBlock = true;
                }
                continue;
            }

            if (inCodeBlock) { codeContent.Append(Enc(line) + "\n"); continue; }

            var isUl = line.StartsWith("- ") || line.StartsWith("* ") || line.StartsWith("+ ");
            var olM  = Regex.Match(line, @"^\d+\. (.+)");

            if (inUl && !isUl)       { sb.Append("</ul>"); inUl = false; }
            if (inOl && !olM.Success) { sb.Append("</ol>"); inOl = false; }

            if (line.StartsWith("#### ")) { sb.Append($"<h4 class=\"mt-3 mb-1 text-base font-semibold\">{Inline(line[5..])}</h4>"); continue; }
            if (line.StartsWith("### "))  { sb.Append($"<h3 class=\"mt-4 mb-1 text-lg font-semibold\">{Inline(line[4..])}</h3>"); continue; }
            if (line.StartsWith("## "))   { sb.Append($"<h2 class=\"mt-5 mb-2 text-xl font-semibold\">{Inline(line[3..])}</h2>"); continue; }
            if (line.StartsWith("# "))    { sb.Append($"<h1 class=\"mt-6 mb-2 text-2xl font-bold\">{Inline(line[2..])}</h1>"); continue; }
            if (line.StartsWith("> "))    { sb.Append($"<blockquote class=\"my-2 border-l-4 border-border pl-4 italic text-muted-foreground\">{Inline(line[2..])}</blockquote>"); continue; }

            if (Regex.IsMatch(line, @"^[-*_]{3,}$"))
            { sb.Append("<hr class=\"my-4 border-border\" />"); continue; }

            if (isUl)
            {
                if (!inUl) { sb.Append("<ul class=\"my-2 list-disc space-y-0.5 pl-5\">"); inUl = true; }
                sb.Append($"<li>{Inline(line[2..])}</li>"); continue;
            }

            if (olM.Success)
            {
                if (!inOl) { sb.Append("<ol class=\"my-2 list-decimal space-y-0.5 pl-5\">"); inOl = true; }
                sb.Append($"<li>{Inline(olM.Groups[1].Value)}</li>"); continue;
            }

            if (string.IsNullOrWhiteSpace(line)) { sb.Append("<br />"); continue; }

            sb.Append($"<p class=\"my-1 leading-relaxed\">{Inline(line)}</p>");
        }

        if (inCodeBlock) sb.Append($"<pre class=\"my-2 overflow-auto rounded bg-muted p-3 text-xs font-mono\"><code>{codeContent}</code></pre>");
        if (inUl)        sb.Append("</ul>");
        if (inOl)        sb.Append("</ol>");

        return sb.ToString();
    }

    private static void CloseLists(StringBuilder sb, ref bool inUl, ref bool inOl)
    {
        if (inUl) { sb.Append("</ul>"); inUl = false; }
        if (inOl) { sb.Append("</ol>"); inOl = false; }
    }

    private static string Inline(string text)
    {
        text = Enc(text);
        text = Regex.Replace(text, @"`(.+?)`",
            "<code class=\"rounded bg-muted px-1 py-0.5 text-xs font-mono\">$1</code>");
        text = Regex.Replace(text, @"!\[([^\]]*)\]\(([^\)]+)\)",
            "<img src=\"$2\" alt=\"$1\" class=\"max-w-full rounded\" />");
        text = Regex.Replace(text, @"\[([^\]]+)\]\(([^\)]+)\)",
            "<a href=\"$2\" class=\"text-primary underline\" target=\"_blank\" rel=\"noopener\">$1</a>");
        text = Regex.Replace(text, @"\*\*\*(.+?)\*\*\*", "<strong><em>$1</em></strong>");
        text = Regex.Replace(text, @"\*\*(.+?)\*\*",    "<strong>$1</strong>");
        text = Regex.Replace(text, @"__(.+?)__",         "<strong>$1</strong>");
        text = Regex.Replace(text, @"\*(.+?)\*",         "<em>$1</em>");
        text = Regex.Replace(text, @"_(.+?)_",           "<em>$1</em>");
        return text;
    }

    private static string Enc(string s) => System.Net.WebUtility.HtmlEncode(s);
}
