@namespace MyStackBlazor.Components.Form

<div class="@ContainerClass"
     role="group"
     aria-label="Rating: @Value of @Max"
     @onmouseleave="ResetHover"
     @attributes="AdditionalAttributes">

    @for (int i = 1; i <= Max; i++)
    {
        var pos   = i;
        var state = GetState(pos);

        <div class="relative @SizeClass @ScaleClass">

            @* ── Full star ───────────────────────────────────── *@
            @if (state == StarState.Full)
            {
                <svg class="@SizeClass text-yellow-400 pointer-events-none select-none"
                     aria-hidden="true" focusable="false"
                     fill="currentColor" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="@_starD" />
                </svg>
            }

            @* ── Half star (left half filled, right half outline) *@
            else if (state == StarState.Half)
            {
                <svg class="@SizeClass pointer-events-none select-none" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
                    <defs>
                        <clipPath id="rh-@_uid-@pos">
                            <rect x="0" y="0" width="12" height="24" />
                        </clipPath>
                    </defs>
                    <path class="text-muted-foreground/40"
                          fill="none" stroke="currentColor" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round"
                          d="@_starD" />
                    <path class="text-yellow-400"
                          fill="currentColor" stroke="currentColor" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round"
                          clip-path="url(#rh-@_uid-@pos)"
                          d="@_starD" />
                </svg>
            }

            @* ── Empty star ──────────────────────────────────── *@
            else
            {
                <svg class="@SizeClass text-muted-foreground/40 pointer-events-none select-none"
                     aria-hidden="true" focusable="false"
                     fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="@_starD" />
                </svg>
            }

            @* ── Invisible interaction hotspot(s) ────────────── *@
            @if (!(Disabled || ReadOnly))
            {
                @if (Step == 0.5m)
                {
                    <button type="button"
                            class="absolute inset-y-0 left-0 w-1/2 focus:outline-none"
                            aria-label="@((decimal)pos - 0.5m) of @Max"
                            @onmouseenter="() => _hovered = pos - 0.5m"
                            @onclick="() => SetValue(pos - 0.5m)" />
                    <button type="button"
                            class="absolute inset-y-0 right-0 w-1/2 focus:outline-none"
                            aria-label="@pos of @Max"
                            @onmouseenter="() => _hovered = (decimal)pos"
                            @onclick="() => SetValue((decimal)pos)" />
                }
                else
                {
                    <button type="button"
                            class="absolute inset-0 rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                            aria-label="@pos of @Max"
                            @onmouseenter="() => _hovered = (decimal)pos"
                            @onclick="() => SetValue((decimal)pos)" />
                }
            }
        </div>
    }

    @if (ShowValue && (Value > 0 || _hovered > 0))
    {
        <span class="ml-2 text-sm tabular-nums text-muted-foreground">
            @((_hovered > 0 ? _hovered : Value).ToString("0.#"))<span class="text-muted-foreground/50">/@Max</span>
        </span>
    }
</div>

@code {
    private enum StarState { Empty, Half, Full }

    // Single source of truth for the star path — no string-split corruption risk
    private const string _starD =
        "M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z";

    [Parameter] public decimal Value { get; set; }
    [Parameter] public EventCallback<decimal> ValueChanged { get; set; }
    [Parameter] public int Max { get; set; } = 5;
    [Parameter] public decimal Step { get; set; } = 0.5m;
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public bool ShowValue { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private decimal _hovered;
    private readonly string _uid = Guid.NewGuid().ToString("N")[..6];

    private string ContainerClass =>
        $"inline-flex items-center gap-0.5 {Class}".Trim();

    private string SizeClass => Size switch
    {
        "sm" => "h-4 w-4",
        "lg" => "h-7 w-7",
        "xl" => "h-9 w-9",
        _    => "h-6 w-6",
    };

    private string ScaleClass => (Disabled || ReadOnly)
        ? ""
        : "cursor-pointer transition-transform hover:scale-125";

    private decimal DisplayValue => _hovered > 0 ? _hovered : Value;

    private StarState GetState(int pos)
    {
        var dv = DisplayValue;
        if (dv >= pos)             return StarState.Full;
        if (dv >= pos - 0.5m && Step == 0.5m) return StarState.Half;
        return StarState.Empty;
    }

    private void ResetHover() => _hovered = 0;

    private async Task SetValue(decimal v)
    {
        if (Disabled || ReadOnly) return;
        Value = (v == Value) ? 0m : v;
        await ValueChanged.InvokeAsync(Value);
    }
}
