@namespace MyStackBlazor.Components.Form
@typeparam T
@inherits DatePickerBase<T>

@*
    Date picker modelled on the Telerik DatePicker API: a segmented date input plus a calendar popup.
    T can be DateTime, DateTime?, DateOnly or DateOnly?.

    <StackDatePicker @bind-Value="date" Format="dd MMM yyyy" Min="@DateTime.Today" ShowWeekNumbers />
*@

<div class="@($"relative inline-flex w-full flex-col {Class}".TrimEnd())"
     style="@(Width is null ? null : $"width:{Width}")"
     @onkeydown="OnWrapperKeyDownAsync"
     @attributes="AdditionalAttributes">

    <StackDateInput T="T" @ref="Input"
                    Value="Value" ValueChanged="OnInputValueChangedAsync" ValueExpression="ValueExpression"
                    Format="@EffectiveFormat" Min="Min" Max="Max"
                    Placeholder="@Placeholder" FormatPlaceholder="FormatPlaceholder"
                    AutoSwitchParts="AutoSwitchParts" AutoSwitchKeys="AutoSwitchKeys" AutoCorrectParts="AutoCorrectParts"
                    TwoDigitYearMax="TwoDigitYearMax" ShowClearButton="ShowClearButton"
                    Enabled="!IsDisabled" ReadOnly="ReadOnly"
                    Size="@Size" Rounded="@Rounded" FillMode="@FillMode"
                    Id="@Id" TabIndex="TabIndex" AriaLabel="@(AriaLabel ?? "Date")"
                    OnChange="OnChange" OnBlur="OnInputBlurAsync">
        <SuffixTemplate>
            <button type="button"
                    tabindex="-1"
                    class="@ToggleButtonCls"
                    aria-label="Open calendar"
                    aria-haspopup="dialog"
                    aria-expanded="@(IsOpen ? "true" : "false")"
                    aria-controls="@(IsOpen ? PopupId : null)"
                    disabled="@(IsDisabled || ReadOnly)"
                    @onclick="ToggleAsync"
                    @onclick:stopPropagation="true">
                <svg class="h-4 w-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </button>
        </SuffixTemplate>
    </StackDateInput>

    @if (IsOpen)
    {
        <div class="@OverlayCls" @onclick="OnOverlayClickAsync" aria-hidden="true"></div>
        <div id="@PopupId" class="@PopupCls" role="dialog" aria-label="@(Title ?? "Choose a date")">
            @if (AdaptiveMode == AdaptiveMode.Auto)
            {
                <div class="hidden items-center justify-between border-b px-4 py-3 max-sm:flex">
                    <span class="text-sm font-semibold">@(Title ?? "Select date")</span>
                    <button type="button" class="@ToggleButtonCls" aria-label="Close" @onclick="() => CloseFromUserAsync(refocus: true)">✕</button>
                </div>
            }
            <StackDateCalendar @ref="_calendar"
                               Value="CurrentDate?.Date"
                               ValueChanged="OnCalendarValueAsync"
                               Date="_calendarDate"
                               View="View" ViewChanged="ViewChanged" BottomView="BottomView" TopView="TopView"
                               Min="Min" Max="Max" DisabledDates="DisabledDates"
                               ShowWeekNumbers="ShowWeekNumbers" ShowOtherMonthDays="ShowOtherMonthDays"
                               OnCellRender="OnCalendarCellRender"
                               Class="border-0" />
        </div>
    }
</div>

@code {
    /// <summary>The calendar level shown when the popup opens.</summary>
    [Parameter] public CalendarView View { get; set; } = CalendarView.Month;
    [Parameter] public EventCallback<CalendarView> ViewChanged { get; set; }
    /// <summary>The level at which clicks select (Year = month picker, and so on).</summary>
    [Parameter] public CalendarView BottomView { get; set; } = CalendarView.Month;
    [Parameter] public CalendarView TopView { get; set; } = CalendarView.Century;
    [Parameter] public List<DateTime>? DisabledDates { get; set; }
    [Parameter] public bool ShowWeekNumbers { get; set; }
    [Parameter] public bool ShowOtherMonthDays { get; set; } = true;
    /// <summary>Called for every calendar cell; set <c>args.Class</c> to style it.</summary>
    [Parameter] public Action<CalendarCellRenderEventArgs>? OnCalendarCellRender { get; set; }

    private StackDateCalendar? _calendar;
    private DateTime _calendarDate = DateTime.Today;
    private bool _focusCalendar;

    protected override string DefaultFormat => "d";

    protected override void OnPopupOpening()
    {
        _calendarDate = CalendarMath.Clamp((CurrentDate ?? DateTime.Today).Date, Min, Max);
        _focusCalendar = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCalendar && _calendar is not null)
        {
            _focusCalendar = false;
            try { await _calendar.FocusAsync(); } catch { }
        }
    }

    /// <summary>Shows <paramref name="date"/> in the calendar at the given level (opens nothing).</summary>
    public void NavigateTo(DateTime date, CalendarView view)
    {
        _calendarDate = date.Date;
        _calendar?.NavigateTo(date, view);
    }

    private Task OnCalendarValueAsync(DateTime? date)
    {
        // Keep the time of day of an existing DateTime value.
        var time = CurrentDate?.TimeOfDay ?? TimeSpan.Zero;
        return SetFromPopupAsync(date is DateTime d ? d.Date + time : null, close: true);
    }
}
