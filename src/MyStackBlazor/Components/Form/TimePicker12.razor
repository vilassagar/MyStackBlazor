@namespace MyStackBlazor.Components.Form

<div class="relative @Class" @attributes="AdditionalAttributes">

    <!-- Trigger -->
    <button type="button"
            class="flex h-10 w-full items-center gap-2 rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            disabled="@Disabled"
            @onclick="ToggleOpen">
        <svg class="h-4 w-4 flex-shrink-0 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
        </svg>
        <span class="@(Value is null ? "text-muted-foreground" : "")">
            @TriggerLabel
        </span>
    </button>

    @if (_isOpen)
    {
        <div class="absolute z-50 mt-1 overflow-hidden rounded-xl border bg-popover shadow-xl animate-fade-in" style="width:220px">

            <!-- Header -->
            <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2.5">
                <span class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">12-Hour</span>
                <span class="font-mono text-sm font-bold tabular-nums">@LivePreview</span>
            </div>

            <!-- Drums + AM/PM -->
            <div class="flex items-end justify-center gap-1 px-3 py-3">

                <!-- Hour drum (01–12) -->
                <div class="flex flex-col items-center gap-0.5">
                    <button type="button"
                            class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
                            @onclick="IncH">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <polyline points="18 15 12 9 6 15" />
                        </svg>
                    </button>
                    <div class="relative flex h-[88px] w-12 flex-col items-center justify-center overflow-hidden rounded-xl bg-muted/50">
                        <span class="absolute top-2 font-mono text-xs font-medium text-muted-foreground/40 select-none">
                            @PrevH12.ToString("D2")
                        </span>
                        <span class="z-10 w-10 rounded-lg bg-primary/15 py-1.5 text-center font-mono text-xl font-bold text-primary ring-1 ring-primary/25 select-none">
                            @_hour12.ToString("D2")
                        </span>
                        <span class="absolute bottom-2 font-mono text-xs font-medium text-muted-foreground/40 select-none">
                            @NextH12.ToString("D2")
                        </span>
                    </div>
                    <button type="button"
                            class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
                            @onclick="DecH">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </button>
                    <span class="text-[9px] font-semibold uppercase tracking-widest text-muted-foreground/60">HR</span>
                </div>

                <span class="mb-7 select-none text-2xl font-bold text-muted-foreground/50">:</span>

                <!-- Minute drum -->
                <div class="flex flex-col items-center gap-0.5">
                    <button type="button"
                            class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
                            @onclick="IncM">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <polyline points="18 15 12 9 6 15" />
                        </svg>
                    </button>
                    <div class="relative flex h-[88px] w-12 flex-col items-center justify-center overflow-hidden rounded-xl bg-muted/50">
                        <span class="absolute top-2 font-mono text-xs font-medium text-muted-foreground/40 select-none">
                            @((_minute - 1 + 60) % 60).ToString("D2")
                        </span>
                        <span class="z-10 w-10 rounded-lg bg-primary/15 py-1.5 text-center font-mono text-xl font-bold text-primary ring-1 ring-primary/25 select-none">
                            @_minute.ToString("D2")
                        </span>
                        <span class="absolute bottom-2 font-mono text-xs font-medium text-muted-foreground/40 select-none">
                            @((_minute + 1) % 60).ToString("D2")
                        </span>
                    </div>
                    <button type="button"
                            class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
                            @onclick="DecM">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </button>
                    <span class="text-[9px] font-semibold uppercase tracking-widest text-muted-foreground/60">MIN</span>
                </div>

                <!-- AM / PM pills -->
                <div class="mb-6 ml-1 flex flex-col gap-2">
                    <button type="button"
                            class="@($"w-14 rounded-lg px-2 py-2.5 text-sm font-bold tracking-wide transition-all {(!_isPm ? "bg-primary text-primary-foreground shadow-sm" : "border border-border text-muted-foreground hover:bg-accent hover:text-foreground")}")"
                            @onclick="@(() => _isPm = false)">
                        AM
                    </button>
                    <button type="button"
                            class="@($"w-14 rounded-lg px-2 py-2.5 text-sm font-bold tracking-wide transition-all {(_isPm ? "bg-primary text-primary-foreground shadow-sm" : "border border-border text-muted-foreground hover:bg-accent hover:text-foreground")}")"
                            @onclick="@(() => _isPm = true)">
                        PM
                    </button>
                </div>

            </div>

            <!-- Footer -->
            <div class="flex gap-2 border-t bg-muted/20 px-3 py-2.5">
                <button type="button"
                        class="flex-1 rounded-lg border px-2 py-1.5 text-xs font-medium transition-colors hover:bg-accent"
                        @onclick="Clear">Clear</button>
                <button type="button"
                        class="flex-1 rounded-lg bg-primary px-2 py-1.5 text-xs font-medium text-primary-foreground transition-colors hover:bg-primary/90"
                        @onclick="Confirm">OK</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public TimeSpan? Value { get; set; }
    [Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "hh : mm AM";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isOpen;
    private int  _hour12 = 12;  // 1–12
    private int  _minute;
    private bool _isPm;

    private int PrevH12 => _hour12 == 1  ? 12 : _hour12 - 1;
    private int NextH12 => _hour12 == 12 ? 1  : _hour12 + 1;

    private string LivePreview  => $"{_hour12:D2} : {_minute:D2} {(_isPm ? "PM" : "AM")}";
    private string TriggerLabel => Value.HasValue ? FormatValue(Value.Value) : Placeholder;

    protected override void OnParametersSet()
    {
        if (Value.HasValue)
        {
            var h   = Value.Value.Hours;
            _minute = Value.Value.Minutes;
            _isPm   = h >= 12;
            _hour12 = h % 12 == 0 ? 12 : h % 12;
        }
    }

    private void ToggleOpen()
    {
        if (Disabled) return;
        if (!_isOpen && !Value.HasValue)
        {
            var now = DateTime.Now;
            _isPm   = now.Hour >= 12;
            _hour12 = now.Hour % 12 == 0 ? 12 : now.Hour % 12;
            _minute = now.Minute;
        }
        _isOpen = !_isOpen;
    }

    private void IncH() => _hour12 = _hour12 == 12 ? 1  : _hour12 + 1;
    private void DecH() => _hour12 = _hour12 == 1  ? 12 : _hour12 - 1;
    private void IncM() => _minute = (_minute + 1) % 60;
    private void DecM() => _minute = (_minute - 1 + 60) % 60;

    private int To24Hour() => _isPm
        ? (_hour12 == 12 ? 12 : _hour12 + 12)
        : (_hour12 == 12 ? 0  : _hour12);

    private static string FormatValue(TimeSpan t)
    {
        var h    = t.Hours % 12 == 0 ? 12 : t.Hours % 12;
        var ampm = t.Hours >= 12 ? "PM" : "AM";
        return $"{h:D2} : {t.Minutes:D2} {ampm}";
    }

    private async Task Confirm()
    {
        Value = new TimeSpan(To24Hour(), _minute, 0);
        await ValueChanged.InvokeAsync(Value);
        _isOpen = false;
    }

    private async Task Clear()
    {
        Value = null;
        await ValueChanged.InvokeAsync(null);
        _isOpen = false;
    }
}
