@namespace MyStackBlazor.Components.Form

<div class="@ComputedClass" role="group" aria-label="Rating" @attributes="AdditionalAttributes">
    @for (var i = 1; i <= Max; i++)
    {
        var star = i;
        <button type="button"
                class="@GetStarClass(star)"
                disabled="@(Disabled || ReadOnly)"
                aria-label="@star of @Max stars"
                @onclick="() => SetValue(star)"
                @onmouseenter="() => _hovered = star"
                @onmouseleave="() => _hovered = 0">
            <svg class="@IconSize" fill="@GetFill(star)" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
            </svg>
        </button>
    }
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public int Max { get; set; } = 5;
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int _hovered;

    private string ComputedClass => $"flex items-center gap-0.5 {Class}".Trim();

    private string IconSize => Size switch
    {
        "sm" => "h-4 w-4",
        "lg" => "h-7 w-7",
        "xl" => "h-9 w-9",
        _    => "h-5 w-5",
    };

    private string GetFill(int star)
    {
        var active = _hovered > 0 ? _hovered : Value;
        return star <= active ? "currentColor" : "none";
    }

    private string GetStarClass(int star)
    {
        var active = _hovered > 0 ? _hovered : Value;
        var colorClass = star <= active ? "text-yellow-400" : "text-muted-foreground/40";
        var interactiveClass = (Disabled || ReadOnly) ? "cursor-default" : "cursor-pointer hover:scale-110 transition-transform";
        return $"{colorClass} {interactiveClass} focus:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm disabled:pointer-events-none disabled:opacity-50".Trim();
    }

    private async Task SetValue(int star)
    {
        if (Disabled || ReadOnly) return;
        Value = star == Value ? 0 : star;
        await ValueChanged.InvokeAsync(Value);
    }
}
