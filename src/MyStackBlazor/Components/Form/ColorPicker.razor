@namespace MyStackBlazor.Components.Form

<div class="@($"space-y-3 {Class}".Trim())" @attributes="AdditionalAttributes">
    <!-- Swatch + hex input row -->
    <div class="flex items-center gap-3">
        <button type="button"
                class="h-10 w-10 flex-shrink-0 overflow-hidden rounded-md border border-input shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                style="background-color: @Value"
                aria-label="Color preview"
                title="@Value">
        </button>

        <input type="text"
               value="@Value"
               maxlength="7"
               placeholder="#000000"
               class="flex h-10 w-32 rounded-md border border-input bg-background px-3 py-2 font-mono text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
               @oninput="OnHexInput"
               @onblur="NormalizeHex" />

        @if (ShowAlpha)
        {
            <div class="flex flex-1 items-center gap-2">
                <input type="range" min="0" max="100" value="@_alpha"
                       class="flex-1 accent-primary"
                       @oninput="OnAlphaChange" />
                <span class="w-10 text-right text-xs text-muted-foreground">@_alpha%</span>
            </div>
        }
    </div>

    <!-- RGB sliders -->
    @if (ShowSliders)
    {
        <div class="space-y-2">
            <div class="flex items-center gap-2">
                <span class="w-4 shrink-0 text-center text-xs font-medium text-muted-foreground">R</span>
                <input type="range" min="0" max="255" value="@_r"
                       class="flex-1 accent-red-500"
                       @oninput="e => UpdateRgb(ParseInt(e, 0), _g, _b)" />
                <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">@_r</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-4 shrink-0 text-center text-xs font-medium text-muted-foreground">G</span>
                <input type="range" min="0" max="255" value="@_g"
                       class="flex-1 accent-green-500"
                       @oninput="e => UpdateRgb(_r, ParseInt(e, 0), _b)" />
                <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">@_g</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-4 shrink-0 text-center text-xs font-medium text-muted-foreground">B</span>
                <input type="range" min="0" max="255" value="@_b"
                       class="flex-1 accent-blue-500"
                       @oninput="e => UpdateRgb(_r, _g, ParseInt(e, 0))" />
                <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">@_b</span>
            </div>
        </div>
    }

    <!-- Preset swatches -->
    @if (Swatches.Count > 0)
    {
        <div class="flex flex-wrap gap-1.5">
            @foreach (var swatch in Swatches)
            {
                var color = swatch;
                <button type="button"
                        class="h-6 w-6 rounded border border-input shadow-sm transition-transform hover:scale-110 @(Value?.Equals(swatch, StringComparison.OrdinalIgnoreCase) == true ? "ring-2 ring-ring ring-offset-1" : "")"
                        style="background-color: @color"
                        title="@swatch"
                        @onclick="() => SelectSwatch(swatch)">
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "#000000";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool ShowSliders { get; set; } = true;
    [Parameter] public bool ShowAlpha { get; set; }
    [Parameter] public List<string> Swatches { get; set; } = DefaultSwatches;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public static readonly List<string> DefaultSwatches =
    [
        "#000000", "#ffffff", "#ef4444", "#f97316", "#eab308",
        "#22c55e", "#3b82f6", "#8b5cf6", "#ec4899", "#64748b",
    ];

    private int _r, _g, _b, _alpha = 100;

    protected override void OnParametersSet() => ParseHex(Value);

    private void ParseHex(string? hex)
    {
        if (string.IsNullOrEmpty(hex) || !hex.StartsWith('#') || hex.Length != 7) return;
        try
        {
            _r = Convert.ToInt32(hex[1..3], 16);
            _g = Convert.ToInt32(hex[3..5], 16);
            _b = Convert.ToInt32(hex[5..7], 16);
        }
        catch { }
    }

    private async Task OnHexInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        if (!raw.StartsWith('#')) raw = "#" + raw;
        Value = raw.ToLowerInvariant();
        ParseHex(Value);
        if (Value.Length == 7)
            await ValueChanged.InvokeAsync(Value);
    }

    private async Task NormalizeHex()
    {
        if (!Value.StartsWith('#')) Value = "#" + Value;
        if (Value.Length != 7) Value = "#000000";
        Value = Value.ToLowerInvariant();
        ParseHex(Value);
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task UpdateRgb(int r, int g, int b)
    {
        _r = r; _g = g; _b = b;
        Value = $"#{_r:x2}{_g:x2}{_b:x2}";
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task SelectSwatch(string color)
    {
        Value = color.ToLowerInvariant();
        ParseHex(Value);
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnAlphaChange(ChangeEventArgs e)
    {
        _alpha = ParseInt(e, 100);
        await ValueChanged.InvokeAsync(Value);
    }

    private static int ParseInt(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), out var v) ? v : fallback;
}
