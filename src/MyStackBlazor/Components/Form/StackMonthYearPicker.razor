@namespace MyStackBlazor.Components.Form

<div class="relative @Class" @attributes="AdditionalAttributes">
    <div role="button"
         tabindex="0"
         aria-expanded="@_open.ToString().ToLower()"
         aria-haspopup="true"
         aria-label="@(Value.HasValue ? Value.Value.ToString("MMMM yyyy") : (Placeholder ?? "Pick month & year"))"
         class="flex h-10 w-full items-center rounded-md border-2 border-input bg-background px-3 py-2 text-sm cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
         @onclick="TogglePanel"
         @onkeydown='e => { if (e.Key is "Enter" or " ") TogglePanel(); if (e.Key == "Escape") ClosePanel(); }'>
        <svg class="mr-2 h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span class="@(Value.HasValue ? "" : "text-muted-foreground")">
            @(Value.HasValue ? Value.Value.ToString("MMMM yyyy") : (Placeholder ?? "Pick month & year"))
        </span>
    </div>

    @if (_open)
    {
        <div class="fixed inset-0 z-40" aria-hidden="true" @onclick="ClosePanel"></div>
        <div class="absolute z-50 mt-1 w-64 rounded-md border bg-popover p-3 shadow-md animate-fade-in">

            <div class="flex items-center justify-between mb-3">
                <button type="button" aria-label="Previous year"
                        class="p-1 rounded hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                        @onclick="PrevYear">
                    <svg class="h-4 w-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
                <span class="text-sm font-semibold select-none">@_viewYear</span>
                <button type="button" aria-label="Next year"
                        class="p-1 rounded hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                        @onclick="NextYear">
                    <svg class="h-4 w-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
            </div>

            <div class="grid grid-cols-3 gap-1">
                @for (int m = 1; m <= 12; m++)
                {
                    var month = m;
                    var isSelected = Value.HasValue && Value.Value.Year == _viewYear && Value.Value.Month == month;
                    var isToday = DateTime.Today.Year == _viewYear && DateTime.Today.Month == month;
                    <button type="button"
                            aria-label="@(new DateTime(_viewYear, month, 1).ToString("MMMM yyyy"))"
                            aria-pressed="@isSelected.ToString().ToLower()"
                            class="@MonthClass(isSelected, isToday)"
                            @onclick="() => SelectMonth(month)">
                        @(new DateTime(_viewYear, month, 1).ToString("MMMM"))
                    </button>
                }
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _open;
    private int _viewYear = DateTime.Today.Year;

    private string MonthClass(bool selected, bool isCurrentMonth) =>
        "rounded-md py-1.5 text-sm text-center transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring " +
        (selected
            ? "bg-primary text-primary-foreground font-medium"
            : isCurrentMonth
                ? "font-bold text-primary hover:bg-accent"
                : "hover:bg-accent");

    private void TogglePanel()
    {
        _open = !_open;
        if (_open)
            _viewYear = Value?.Year ?? DateTime.Today.Year;
    }

    private void ClosePanel() => _open = false;
    private void PrevYear() => _viewYear--;
    private void NextYear() => _viewYear++;

    private async Task SelectMonth(int month)
    {
        Value = new DateTime(_viewYear, month, 1);
        _open = false;
        await ValueChanged.InvokeAsync(Value);
    }
}
