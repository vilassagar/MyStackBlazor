@namespace MyStackBlazor.Components.Form
@typeparam T
@inherits DatePickerBase<T>

@*
    Date-time picker modelled on the Telerik DateTimePicker API: a segmented input plus a
    popup with a Date tab (calendar) and a Time tab (time lists), confirmed with Set.

    <StackDateTimePicker @bind-Value="meeting" Format="dd MMM yyyy HH:mm" Steps="@(new TimePickerSteps { Minute = 5 })" />
*@

<div class="@($"relative inline-flex w-full flex-col {Class}".TrimEnd())"
     style="@(Width is null ? null : $"width:{Width}")"
     @onkeydown="OnWrapperKeyDownAsync"
     @attributes="AdditionalAttributes">

    <StackDateInput T="T" @ref="Input"
                    Value="Value" ValueChanged="OnInputValueChangedAsync" ValueExpression="ValueExpression"
                    Format="@EffectiveFormat" Min="Min" Max="Max"
                    Placeholder="@Placeholder" FormatPlaceholder="FormatPlaceholder"
                    AutoSwitchParts="AutoSwitchParts" AutoSwitchKeys="AutoSwitchKeys" AutoCorrectParts="AutoCorrectParts"
                    TwoDigitYearMax="TwoDigitYearMax" ShowClearButton="ShowClearButton"
                    Enabled="!IsDisabled" ReadOnly="ReadOnly"
                    Size="@Size" Rounded="@Rounded" FillMode="@FillMode"
                    Id="@Id" TabIndex="TabIndex" AriaLabel="@(AriaLabel ?? "Date and time")"
                    OnChange="OnChange" OnBlur="OnInputBlurAsync">
        <SuffixTemplate>
            <button type="button" tabindex="-1" class="@ToggleButtonCls"
                    aria-label="Open date and time picker" aria-haspopup="dialog"
                    aria-expanded="@(IsOpen ? "true" : "false")" aria-controls="@(IsOpen ? PopupId : null)"
                    disabled="@(IsDisabled || ReadOnly)"
                    @onclick="ToggleAsync" @onclick:stopPropagation="true">
                <svg class="h-4 w-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </button>
        </SuffixTemplate>
    </StackDateInput>

    @if (IsOpen)
    {
        <div class="@OverlayCls" @onclick="OnOverlayClickAsync" aria-hidden="true"></div>
        <div id="@PopupId" class="@PopupCls" role="dialog" aria-label="@(Title ?? "Choose a date and time")">
            @if (AdaptiveMode == AdaptiveMode.Auto)
            {
                <div class="hidden items-center justify-between border-b px-4 py-3 max-sm:flex">
                    <span class="text-sm font-semibold">@(Title ?? "Select date and time")</span>
                    <button type="button" class="@ToggleButtonCls" aria-label="Close" @onclick="() => CloseFromUserAsync(refocus: true)">✕</button>
                </div>
            }

            <div role="tablist" aria-label="Date or time" class="flex gap-1 border-b p-2">
                <button type="button" role="tab" aria-selected="@(!_timeTab ? "true" : "false")" class="@TabCls(!_timeTab)" @onclick="() => _timeTab = false">Date</button>
                <button type="button" role="tab" aria-selected="@(_timeTab ? "true" : "false")" class="@TabCls(_timeTab)" @onclick="() => _timeTab = true">Time</button>
            </div>

            <div role="tabpanel" class="min-h-[18rem]">
                @if (!_timeTab)
                {
                    <StackDateCalendar Value="_temp?.Date" ValueChanged="OnCalendarValue"
                                       Date="_temp?.Date ?? DateTime.Today"
                                       View="View" BottomView="BottomView" TopView="TopView"
                                       Min="Min" Max="Max" DisabledDates="DisabledDates"
                                       ShowWeekNumbers="ShowWeekNumbers" ShowOtherMonthDays="ShowOtherMonthDays"
                                       OnCellRender="OnCalendarCellRender" Class="border-0" />
                }
                else
                {
                    <div class="flex justify-center">
                        <StackTimeSelector @bind-Value="_temp" Format="@EffectiveFormat" Steps="Steps" OnEnter="SetAsync" />
                    </div>
                }
            </div>

            <div class="flex items-center justify-between gap-2 border-t px-2 py-2">
                <button type="button" class="text-xs font-medium text-primary hover:underline" @onclick="() => _temp = DateTime.Now">Now</button>
                <div class="flex gap-2">
                    <button type="button" class="@FooterButtonCls" @onclick="() => CloseFromUserAsync(refocus: true)">Cancel</button>
                    <button type="button" class="@PrimaryFooterButtonCls" @onclick="SetAsync">Set</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public CalendarView View { get; set; } = CalendarView.Month;
    [Parameter] public CalendarView BottomView { get; set; } = CalendarView.Month;
    [Parameter] public CalendarView TopView { get; set; } = CalendarView.Century;
    [Parameter] public List<DateTime>? DisabledDates { get; set; }
    [Parameter] public bool ShowWeekNumbers { get; set; }
    [Parameter] public bool ShowOtherMonthDays { get; set; } = true;
    [Parameter] public Action<CalendarCellRenderEventArgs>? OnCalendarCellRender { get; set; }
    /// <summary>Step sizes of the hour / minute / second lists.</summary>
    [Parameter] public TimePickerSteps? Steps { get; set; }

    private DateTime? _temp;
    private bool _timeTab;

    protected override string DefaultFormat => "G";

    protected override void OnPopupOpening()
    {
        _temp = CurrentDate ?? DateTime.Today;
        _timeTab = false;
    }

    private void OnCalendarValue(DateTime? date)
    {
        if (date is not DateTime d) return;
        _temp = d.Date + (_temp?.TimeOfDay ?? TimeSpan.Zero);
        _timeTab = true; // like Telerik: picking a date moves on to the time
    }

    private Task SetAsync() => SetFromPopupAsync(_temp, close: true);

    private static string TabCls(bool active) =>
        "flex-1 rounded-md px-3 py-1.5 text-xs font-medium transition-colors " +
        (active ? "bg-primary text-primary-foreground" : "hover:bg-accent");
}
