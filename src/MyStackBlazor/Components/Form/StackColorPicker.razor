@namespace MyStackBlazor.Components.Form

@*
    Colour picker button with a popup, modelled on the Telerik ColorPicker API.

    <StackColorPicker @bind-Value="color" Views="@(new List<ColorPickerView> { ColorPickerView.Palette })" />

    The earlier API (ShowAlpha, ShowSliders, Swatches) still works.
*@

<div class="@($"relative inline-flex flex-col {Class}".TrimEnd())" @onkeydown="OnKeyDownAsync" @attributes="AdditionalAttributes">
    <button @ref="_button"
            type="button"
            id="@Id"
            class="@ButtonCls"
            disabled="@(!IsEnabled)"
            title="@Title"
            aria-label="@(AriaLabel ?? $"Choose color, current {Value ?? "none"}")"
            aria-haspopup="dialog"
            aria-expanded="@(_open ? "true" : "false")"
            @onclick="ToggleAsync">
        @if (Icon is not null)
        {
            <span class="flex flex-col items-center leading-none">
                @Icon
                <span class="mt-0.5 h-1 w-5 rounded-sm" style="@($"background:{Value ?? "transparent"}")"></span>
            </span>
        }
        else
        {
            <span class="h-5 w-6 rounded-sm border border-black/15" style="@SwatchStyle"></span>
        }
        <svg class="@($"h-3.5 w-3.5 text-muted-foreground transition-transform {(_open ? "rotate-180" : "")}")" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
    </button>

    @if (_open)
    {
        <div class="fixed inset-0 z-40" @onclick="() => CloseFromUserAsync(refocus: false)" aria-hidden="true"></div>
        <div role="dialog" aria-label="@(Title ?? "Color picker")"
             class="@($"absolute left-0 top-full z-50 mt-1 shadow-lg {(AdaptiveMode == AdaptiveMode.Auto ? "max-sm:fixed max-sm:inset-x-0 max-sm:bottom-0 max-sm:top-auto max-sm:mt-0" : "")} {PopupClass}".TrimEnd())">
            <StackFlatColorPicker Value="@Value" ValueChanged="OnPickedAsync" OnCancel="() => CloseFromUserAsync(refocus: true)"
                                  Views="EffectiveViews" View="View" ViewChanged="ViewChanged" ValueFormat="ValueFormat"
                                  ShowPreview="ShowPreview" ShowButtons="ShowButtons" ShowClearButton="ShowClearButton"
                                  ShowOpacityEditor="EffectiveShowOpacity" Colors="EffectiveColors" Palette="Palette"
                                  Columns="Columns" TileWidth="@TileWidth" TileHeight="@TileHeight" />
        </div>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public List<ColorPickerView>? Views { get; set; }
    [Parameter] public ColorPickerView View { get; set; } = ColorPickerView.Gradient;
    [Parameter] public EventCallback<ColorPickerView> ViewChanged { get; set; }
    [Parameter] public ColorFormat ValueFormat { get; set; } = ColorFormat.Hex;
    [Parameter] public bool ShowPreview { get; set; } = true;
    /// <summary>Show Apply / Cancel in the popup; without them a pick applies and closes immediately.</summary>
    [Parameter] public bool ShowButtons { get; set; } = true;
    [Parameter] public bool ShowClearButton { get; set; } = true;
    [Parameter] public bool ShowOpacityEditor { get; set; } = true;
    [Parameter] public IEnumerable<string>? Colors { get; set; }
    [Parameter] public ColorPalettePresets Palette { get; set; } = ColorPalettePresets.Office;
    [Parameter] public int? Columns { get; set; }
    [Parameter] public string TileWidth { get; set; } = "1.5rem";
    [Parameter] public string TileHeight { get; set; } = "1.5rem";

    /// <summary>Content shown on the button instead of the colour swatch (the colour shows as a bar under it).</summary>
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public string Size { get; set; } = DropDownListTheme.Size.Medium;
    [Parameter] public string Rounded { get; set; } = DropDownListTheme.Rounded.Medium;
    [Parameter] public string FillMode { get; set; } = DropDownListTheme.FillMode.Solid;
    [Parameter] public AdaptiveMode AdaptiveMode { get; set; } = AdaptiveMode.None;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? PopupClass { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter] public EventCallback<object?> OnChange { get; set; }
    [Parameter] public EventCallback<ColorPickerOpenCloseEventArgs> OnOpen { get; set; }
    [Parameter] public EventCallback<ColorPickerOpenCloseEventArgs> OnClose { get; set; }

    // ── Earlier API ──────────────────────────────────────────────────────────
    /// <summary>Earlier API: shows the gradient (slider) view.</summary>
    [Parameter] public bool ShowSliders { get; set; } = true;
    /// <summary>Earlier API: alias for <see cref="ShowOpacityEditor"/>.</summary>
    [Parameter] public bool? ShowAlpha { get; set; }
    /// <summary>Earlier API: palette colours.</summary>
    [Parameter] public List<string>? Swatches { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Earlier API: the default swatches.</summary>
    public static readonly List<string> DefaultSwatches =
    [
        "#000000", "#ffffff", "#ef4444", "#f97316", "#eab308",
        "#22c55e", "#3b82f6", "#8b5cf6", "#ec4899", "#64748b",
    ];

    private ElementReference _button;
    private bool _open;

    private bool IsEnabled => Enabled;
    private bool EffectiveShowOpacity => ShowAlpha ?? ShowOpacityEditor;
    private IEnumerable<string>? EffectiveColors => Colors ?? Swatches;

    private List<ColorPickerView> EffectiveViews =>
        Views ?? (ShowSliders ? [ColorPickerView.Gradient, ColorPickerView.Palette] : [ColorPickerView.Palette]);

    private string SwatchStyle => Value is null
        ? "background:repeating-linear-gradient(45deg,#fff 0 4px,#e5e7eb 4px 8px)"
        : $"background:{Value}";

    public void Open()
    {
        if (!IsEnabled || _open) return;
        _open = true;
        StateHasChanged();
    }

    public void Close()
    {
        if (!_open) return;
        _open = false;
        StateHasChanged();
    }

    public ValueTask FocusAsync() => _button.FocusAsync();

    private async Task ToggleAsync()
    {
        if (_open) { await CloseFromUserAsync(refocus: false); return; }
        var args = new ColorPickerOpenCloseEventArgs();
        await OnOpen.InvokeAsync(args);
        if (!args.IsCancelled) _open = true;
    }

    private async Task CloseFromUserAsync(bool refocus)
    {
        if (!_open) return;
        var args = new ColorPickerOpenCloseEventArgs();
        await OnClose.InvokeAsync(args);
        if (args.IsCancelled) return;
        _open = false;
        if (refocus)
        {
            try { await _button.FocusAsync(); } catch { }
        }
    }

    private async Task OnPickedAsync(string? color)
    {
        Value = color;
        await ValueChanged.InvokeAsync(color);
        await OnChange.InvokeAsync(color);
        await CloseFromUserAsync(refocus: true);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseFromUserAsync(refocus: true);
        else if (e.AltKey && e.Key == "ArrowDown" && !_open) await ToggleAsync();
    }

    private string ButtonCls
    {
        get
        {
            var size = Size switch
            {
                DropDownListTheme.Size.Small => "h-8 px-1.5",
                DropDownListTheme.Size.Large => "h-12 px-3",
                _                            => "h-10 px-2",
            };
            var rounded = FillMode == DropDownListTheme.FillMode.Flat ? "rounded-none" : Rounded switch
            {
                DropDownListTheme.Rounded.None  => "rounded-none",
                DropDownListTheme.Rounded.Small => "rounded-sm",
                DropDownListTheme.Rounded.Large => "rounded-lg",
                DropDownListTheme.Rounded.Full  => "rounded-full",
                _                               => "rounded-md",
            };
            var fill = FillMode switch
            {
                DropDownListTheme.FillMode.Flat    => "border-0 border-b-2 border-input bg-transparent",
                DropDownListTheme.FillMode.Outline => "border-2 border-input bg-transparent",
                _                                  => "border border-input bg-background shadow-sm",
            };
            return $"inline-flex items-center gap-1.5 transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 {size} {rounded} {fill}";
        }
    }
}
