@namespace MyStackBlazor.Components.Navigation
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav
@implements IDisposable

<a href="@Href"
   class="@ComputedClass"
   aria-current="@(_isActive ? "page" : null)"
   aria-disabled="@(Disabled ? "true" : null)"
   tabindex="@(Disabled ? "-1" : null)"
   title="@(Collapsed ? TitleText : null)"
   @attributes="AdditionalAttributes">
    @if (Icon is not null)
    {
        <StackLucideIcon Name="@Icon" Size="sm" />
    }
    @if (!Collapsed)
    {
        <span class="min-w-0 flex-1 truncate">@ChildContent</span>
        @if (!string.IsNullOrEmpty(Badge))
        {
            <span class="ml-auto rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">@Badge</span>
        }
    }
    else
    {
        <span class="sr-only">@if (TitleText is not null) { @TitleText } else { @ChildContent }</span>
    }
</a>

@code {
    /// <summary>
    /// Sidebar/navigation link that highlights itself when the current URL matches — the styled
    /// equivalent of Blazor's <c>NavLink</c>.
    /// </summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>
    /// How the URL is matched. Default <see cref="NavLinkMatch.Prefix"/> (same as <c>NavLink</c>):
    /// "/orders" is active on "/orders/5". Use <see cref="NavLinkMatch.All"/> for the home link.
    /// </summary>
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    /// <summary>Optional Lucide icon name shown before the text.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Optional count/label pill at the end of the link.</summary>
    [Parameter] public string? Badge { get; set; }

    /// <summary>Icon-only mode for a collapsed sidebar. The text becomes the tooltip and screen-reader label.</summary>
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>Tooltip/label used in <see cref="Collapsed"/> mode. Defaults to nothing; set it when <see cref="ChildContent"/> is markup.</summary>
    [Parameter] public string? TitleText { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Classes added when active. Replaces the default active styling.</summary>
    [Parameter] public string? ActiveClass { get; set; }

    /// <summary>Force the active state on or off, ignoring the URL. Null (default) follows the URL.</summary>
    [Parameter] public bool? Active { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isActive;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override void OnParametersSet() => _isActive = ComputeActive();

    private bool ComputeActive() => Active ?? NavMatcher.IsActive(Nav, Href, Match);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var active = ComputeActive();
        if (active == _isActive) return;
        _isActive = active;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private string ComputedClass
    {
        get
        {
            var layout = Collapsed ? "justify-center px-2" : "gap-3 px-3";
            var state = Disabled
                ? "pointer-events-none opacity-50 text-muted-foreground"
                : _isActive
                    ? ActiveClass ?? "bg-accent text-accent-foreground font-medium"
                    : "text-muted-foreground hover:bg-accent/60 hover:text-foreground";
            return $"flex items-center rounded-md py-2 text-sm no-underline outline-none transition-colors focus-visible:ring-2 focus-visible:ring-ring {layout} {state} {Class}".Trim();
        }
    }
}
