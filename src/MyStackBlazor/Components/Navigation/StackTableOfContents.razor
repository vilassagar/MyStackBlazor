@namespace MyStackBlazor.Components.Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_sections.Count > 0)
{
    <nav class="@($"text-sm {Class}".Trim())" aria-label="@Title" @attributes="AdditionalAttributes">
        @if (!string.IsNullOrEmpty(Title))
        {
            <p class="mb-2 font-semibold text-foreground">@Title</p>
        }
        <ul class="flex flex-col border-l border-border">
            @foreach (var s in _sections.Where(s => s.Level <= MaxLevel))
            {
                var section = s;
                var active = section.Id == _activeId;
                <li>
                    <a href="@($"#{section.Id}")"
                       class="@($"-ml-px block border-l-2 py-1 transition-colors {Indent(section.Level)} {(active ? "border-primary font-medium text-foreground" : "border-transparent text-muted-foreground hover:text-foreground")}")"
                       aria-current="@(active ? "location" : null)"
                       @onclick="() => GoToAsync(section.Id)" @onclick:preventDefault="true">@section.Text</a>
                </li>
            }
        </ul>
    </nav>
}

@code {
    /// <summary>
    /// "On this page" navigation (MudPageContentNavigation equivalent): lists the h2/h3/h4 headings inside
    /// <see cref="ContainerSelector"/> and highlights the one being read. Headings without an id get one.
    /// Mark a heading (or a block) with <c>data-toc-ignore</c> to leave it out.
    /// </summary>
    [Parameter] public string ContainerSelector { get; set; } = "main";
    /// <summary>Explicit sections instead of scanning headings.</summary>
    [Parameter] public IReadOnlyList<TocSection>? Sections { get; set; }
    [Parameter] public string Title { get; set; } = "On this page";
    /// <summary>Deepest heading level shown (2–4).</summary>
    [Parameter] public int MaxLevel { get; set; } = 3;
    /// <summary>Height of a sticky header, so jumps don't hide the heading under it.</summary>
    [Parameter] public int ScrollOffset { get; set; } = 80;
    [Parameter] public EventCallback<string> ActiveSectionChanged { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<StackTableOfContents>? _ref;
    private int _watchId;
    private List<TocSection> _sections = [];
    private string? _activeId;

    private static string Indent(int level) => level switch { 3 => "pl-6", 4 => "pl-9", _ => "pl-3" };

    protected override void OnParametersSet()
    {
        if (Sections is not null) _sections = Sections.ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await RescanAsync();
    }

    /// <summary>Re-read the headings, e.g. after the page content changed.</summary>
    public async Task RescanAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/MyStackBlazor/js/interactions.js");
            if (Sections is null)
                _sections = (await _module.InvokeAsync<List<TocSection>>("scanHeadings", ContainerSelector)).ToList();
            if (_watchId != 0) await _module.InvokeVoidAsync("dispose", _watchId);
            _ref ??= DotNetObjectReference.Create(this);
            _watchId = await _module.InvokeAsync<int>("watchSections", _ref,
                _sections.Where(s => s.Level <= MaxLevel).Select(s => s.Id).ToArray(), ScrollOffset);
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task OnActiveSection(string id)
    {
        if (id == _activeId) return;
        _activeId = id;
        await ActiveSectionChanged.InvokeAsync(id);
        StateHasChanged();
    }

    private async Task GoToAsync(string id)
    {
        _activeId = id;
        if (_module is not null) await _module.InvokeVoidAsync("scrollToId", id, ScrollOffset, true);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                if (_watchId != 0) await _module.InvokeVoidAsync("dispose", _watchId);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _ref?.Dispose();
    }
}
