@namespace MyStackBlazor.Components.Navigation

@*
    Mobile tab bar (Material "bottom navigation") for phones and .NET MAUI Blazor Hybrid apps.
    Route mode: give each item an Href; the active tab follows the URL.
    Value mode: give each item a Value and bind the selected one with @bind-Value.
*@
<CascadingValue Value="this" IsFixed="true">
    <nav class="@ComputedClass" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
        <ul role="list" class="mx-auto flex h-16 max-w-lg items-stretch">
            @ChildContent
        </ul>
    </nav>
</CascadingValue>

@code {
    /// <summary><see cref="StackBottomNavigationItem"/> children (3-5 is recommended).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Selected item value in value mode. Use with <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Pin to the bottom of the viewport (adds iOS safe-area padding).</summary>
    [Parameter] public bool Fixed { get; set; } = true;

    /// <summary>Show item labels: always (default), active (only on the selected item), never.</summary>
    [Parameter] public string ShowLabels { get; set; } = "always";

    /// <summary>Hide on medium screens and up, where a sidebar usually takes over.</summary>
    [Parameter] public bool HideOnDesktop { get; set; } = true;

    [Parameter] public string AriaLabel { get; set; } = "Primary";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass =>
        "z-40 border-t border-border bg-background/95 pb-[env(safe-area-inset-bottom)] backdrop-blur supports-[backdrop-filter]:bg-background/80 " +
        (Fixed ? "fixed inset-x-0 bottom-0 " : "w-full ") +
        (HideOnDesktop ? "md:hidden " : "") +
        Class;

    private readonly List<StackBottomNavigationItem> _items = [];
    private string? _renderedValue;

    internal void Register(StackBottomNavigationItem item) => _items.Add(item);
    internal void Unregister(StackBottomNavigationItem item) => _items.Remove(item);

    protected override void OnParametersSet()
    {
        // A new Value from @bind-Value must repaint every item, not just the clicked one.
        if (_renderedValue != Value) RefreshItems();
    }

    internal async Task SelectAsync(string? value)
    {
        if (value is null || value == Value) return;
        Value = value;
        RefreshItems();
        await ValueChanged.InvokeAsync(value);
    }

    private void RefreshItems()
    {
        _renderedValue = Value;
        foreach (var item in _items) item.Refresh();
    }
}
