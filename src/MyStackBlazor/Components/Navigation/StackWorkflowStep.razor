@namespace MyStackBlazor.Components.Navigation
@implements IDisposable

@if (Parent?.IsActiveStep(this) == true && ChildContent is not null)
{
    <div class="@Class" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    public enum StepStatus { Pending, Active, Completed, Error, Skipped, InProgress }

    [CascadingParameter] public StackWorkflow? Parent { get; set; }

    [Parameter] public string?           Title         { get; set; }
    [Parameter] public string?           Description   { get; set; }
    [Parameter] public string?           StatusText    { get; set; }
    [Parameter] public StepStatus        Status        { get; set; } = StepStatus.Pending;
    [Parameter] public string?           Color         { get; set; }
    [Parameter] public string?           Size          { get; set; }
    [Parameter] public string?           Label         { get; set; }
    [Parameter] public RenderFragment?   Icon          { get; set; }
    [Parameter] public RenderFragment?   ChildContent  { get; set; }
    [Parameter] public string?           Class         { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>?   AdditionalAttributes { get; set; }

    // Set by parent Workflow to avoid mutating a [Parameter] from outside the component
    internal StepStatus? RuntimeStatus { get; set; }

    protected override void OnInitialized() => Parent?.AddStep(this);
    public void Dispose()                   => Parent?.RemoveStep(this);
}
