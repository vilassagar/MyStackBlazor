@namespace MyStackBlazor.Components.Navigation

<div class="@($"space-y-6 {Class}".Trim())" @attributes="AdditionalAttributes">
    <div class="flex border-b">
        @for (var i = 0; i < _steps.Count; i++)
        {
            var idx  = i;
            var step = _steps[i];
            var isActive = idx == _currentStep;
            var isDone   = idx < _currentStep || step.Completed;

            <button type="button"
                    class="flex items-center gap-2 border-b-2 px-4 py-3 text-sm font-medium transition-colors focus:outline-none @(isActive ? "border-primary text-primary" : "border-transparent text-muted-foreground hover:text-foreground") @(isDone && !isActive ? "text-foreground" : "")"
                    @onclick="() => GoToStep(idx)">
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border-2 text-xs @GetIndicatorClass(isActive, isDone)">
                    @if (isDone)
                    {
                        <svg class="h-3 w-3" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    }
                    else { @(idx + 1) }
                </span>
                @step.Title
            </button>
        }
    </div>

    <div>
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </div>

    @if (ShowNavigation)
    {
        <div class="flex items-center justify-between pt-2">
            <button type="button"
                    class="inline-flex items-center gap-2 rounded-md border px-4 py-2 text-sm font-medium hover:bg-accent disabled:pointer-events-none disabled:opacity-50"
                    disabled="@(_currentStep == 0)"
                    @onclick="Previous">
                <svg class="h-4 w-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Back
            </button>

            <span class="text-sm text-muted-foreground">@(_currentStep + 1) / @_steps.Count</span>

            @if (_currentStep < _steps.Count - 1)
            {
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
                        @onclick="Next">
                    Next
                    <svg class="h-4 w-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
            }
            else
            {
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90"
                        @onclick="Finish">
                    Finish
                    <svg class="h-4 w-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public EventCallback OnFinish { get; set; }
    [Parameter] public EventCallback<int> OnStepChanged { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    internal readonly List<StackWizardStep> _steps = [];
    private int _currentStep;

    internal void AddStep(StackWizardStep step )    { _steps.Add(step); StateHasChanged(); }
    internal void RemoveStep(StackWizardStep step ) => _steps.Remove(step);
    internal bool IsActiveStep(StackWizardStep step ) => _steps.IndexOf(step) == _currentStep;

    public async Task GoToStep(int index)
    {
        if (index < 0 || index >= _steps.Count) return;
        _currentStep = index;
        await OnStepChanged.InvokeAsync(_currentStep);
    }

    public async Task Next()
    {
        if (_currentStep >= _steps.Count - 1) return;
        _steps[_currentStep].Completed = true;
        _currentStep++;
        await OnStepChanged.InvokeAsync(_currentStep);
    }

    public async Task Previous()
    {
        if (_currentStep <= 0) return;
        _currentStep--;
        await OnStepChanged.InvokeAsync(_currentStep);
    }

    public async Task Finish()
    {
        _steps[_currentStep].Completed = true;
        await OnFinish.InvokeAsync();
    }

    private static string GetIndicatorClass(bool isActive, bool isDone) => (isActive, isDone) switch
    {
        (_, true) => "border-primary bg-primary text-primary-foreground",
        (true, _) => "border-primary text-primary",
        _         => "border-border text-muted-foreground",
    };
}
