@namespace MyStackBlazor.Components.Data

<div class="flex flex-col overflow-hidden rounded-md border border-border bg-background @Class"
     style="@(Height ?? "height:420px")"
     @attributes="AdditionalAttributes">

    @* ── Toolbar ── *@
    <div class="flex flex-shrink-0 items-center gap-2 border-b px-3 py-1.5">
        <button type="button"
                class="flex h-7 w-7 items-center justify-center rounded text-muted-foreground transition-colors hover:bg-accent disabled:pointer-events-none disabled:opacity-40"
                aria-label="Go up one folder"
                disabled="@(_navPath.Count == 0)"
                @onclick="NavigateUp">
            <svg class="h-4 w-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </button>

        <nav class="flex min-w-0 flex-1 items-center gap-0.5 text-sm" aria-label="Folder location">
            <button type="button"
                    class="flex-shrink-0 rounded px-1 py-0.5 hover:bg-accent @(_navPath.Count == 0 ? "font-medium text-foreground" : "text-muted-foreground")"
                    @onclick='() => NavigateBreadcrumb(-1)'>
                @Root.Name
            </button>
            @for (int i = 0; i < _navPath.Count; i++)
            {
                var idx = i;
                <svg class="h-3 w-3 flex-shrink-0 text-muted-foreground/40" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
                <button type="button"
                        class="max-w-28 flex-shrink-0 truncate rounded px-1 py-0.5 hover:bg-accent @(idx == _navPath.Count - 1 ? "font-medium text-foreground" : "text-muted-foreground")"
                        @onclick="() => NavigateBreadcrumb(idx)">
                    @_navPath[idx].Name
                </button>
            }
        </nav>

        <input type="search"
               placeholder="Search…"
               aria-label="Search files and folders"
               class="h-7 w-32 rounded border border-input bg-background px-2 text-xs placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
               value="@_search"
               @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />

        <div class="flex overflow-hidden rounded border border-border" role="group" aria-label="View mode">
            <button type="button"
                    class="flex h-7 w-7 items-center justify-center @(_viewMode == "grid" ? "bg-accent" : "bg-background hover:bg-muted")"
                    aria-label="Grid view" aria-pressed="@(_viewMode == "grid" ? "true" : "false")"
                    @onclick='() => _viewMode = "grid"'>
                <svg class="h-3.5 w-3.5" aria-hidden="true" fill="currentColor" viewBox="0 0 16 16">
                    <rect x="1" y="1" width="6" height="6" rx="1" />
                    <rect x="9" y="1" width="6" height="6" rx="1" />
                    <rect x="1" y="9" width="6" height="6" rx="1" />
                    <rect x="9" y="9" width="6" height="6" rx="1" />
                </svg>
            </button>
            <button type="button"
                    class="flex h-7 w-7 items-center justify-center @(_viewMode == "list" ? "bg-accent" : "bg-background hover:bg-muted")"
                    aria-label="List view" aria-pressed="@(_viewMode == "list" ? "true" : "false")"
                    @onclick='() => _viewMode = "list"'>
                <svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <circle cx="3" cy="6" r="1" fill="currentColor" />
                    <circle cx="3" cy="12" r="1" fill="currentColor" />
                    <circle cx="3" cy="18" r="1" fill="currentColor" />
                </svg>
            </button>
        </div>
    </div>

    @* ── Body ── *@
    <div class="flex min-h-0 flex-1 overflow-hidden">

        @* Folder tree sidebar *@
        @if (ShowTree)
        {
            <div class="w-44 flex-shrink-0 overflow-auto border-r p-1.5" role="tree" aria-label="Folder tree">
                @foreach (var (treeItem, treeLevel, treeHasChildren) in _treeRows)
                {
                    var ti  = treeItem;
                    var tl  = treeLevel;
                    var thc = treeHasChildren;
                    var isExpanded = _treeExpanded.Contains(ti);
                    var isCurrent  = ti == CurrentDir;

                    <div class="flex cursor-pointer select-none items-center gap-1 rounded py-0.5 text-xs transition-colors @(isCurrent ? "bg-accent font-medium" : "hover:bg-muted/50")"
                         style="padding-left:@(4 + tl * 14)px"
                         role="treeitem"
                         aria-expanded="@(thc ? (isExpanded ? "true" : "false") : null)"
                         tabindex="0"
                         @onclick="() => OnTreeItemClick(ti)"
                         @onkeydown="e => OnTreeKeyDown(e, ti)">
                        <span class="flex h-3.5 w-3.5 flex-shrink-0 items-center justify-center"
                              @onclick:stopPropagation="true"
                              @onclick="() => ToggleTreeExpand(ti)">
                            @if (thc)
                            {
                                <svg class="h-3 w-3 transition-transform duration-100 @(isExpanded ? "rotate-90" : "")"
                                     aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            }
                        </span>
                        <svg class="h-3.5 w-3.5 flex-shrink-0 text-yellow-400" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M2 6a2 2 0 012-2h4l2 2h4a2 2 0 012 2v7a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                        </svg>
                        <span class="truncate">@ti.Name</span>
                    </div>
                }
            </div>
        }

        @* Content area *@
        <div class="flex-1 overflow-auto" @onclick="() => _selected = null">
            @{
                var items = VisibleItems;
            }

            @if (items.Count == 0)
            {
                <div class="flex h-full items-center justify-center p-4 text-sm text-muted-foreground">
                    @(string.IsNullOrWhiteSpace(_search) ? "This folder is empty" : "No results")
                </div>
            }
            else if (_viewMode == "grid")
            {
                <div class="grid grid-cols-[repeat(auto-fill,minmax(88px,1fr))] gap-2 p-3">
                    @foreach (var item in items)
                    {
                        var fi = item;
                        var sel = fi == _selected;
                        <div class="flex cursor-pointer select-none flex-col items-center gap-1.5 rounded-lg p-2 text-center transition-colors @(sel ? "bg-accent ring-1 ring-ring" : "hover:bg-muted/50")"
                             role="option"
                             aria-selected="@(sel ? "true" : "false")"
                             tabindex="0"
                             @onclick:stopPropagation="true"
                             @onclick="() => SelectItem(fi)"
                             @ondblclick="() => OpenItem(fi)"
                             @onkeydown="e => OnItemKeyDown(e, fi)">
                            @if (fi.IsDirectory)
                            {
                                <svg class="h-10 w-10 text-yellow-400" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M2 6a2 2 0 012-2h4l2 2h4a2 2 0 012 2v7a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                                </svg>
                            }
                            else
                            {
                                <svg class="h-10 w-10 text-muted-foreground/60" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            }
                            <span class="w-full truncate text-xs text-foreground">@fi.Name</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <table class="w-full text-sm" role="grid">
                    <thead>
                        <tr class="border-b">
                            <th class="sticky top-0 bg-background px-3 py-2 text-left text-xs font-medium text-muted-foreground">Name</th>
                            <th class="sticky top-0 bg-background px-3 py-2 text-right text-xs font-medium text-muted-foreground">Size</th>
                            <th class="sticky top-0 bg-background px-3 py-2 text-right text-xs font-medium text-muted-foreground">Modified</th>
                            @if (AllowDelete)
                            {
                                <th class="sticky top-0 bg-background px-3 py-2 text-right text-xs font-medium text-muted-foreground">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            var fi = item;
                            var sel = fi == _selected;
                            <tr class="cursor-pointer border-b transition-colors @(sel ? "bg-accent" : "hover:bg-muted/30")"
                                role="row"
                                aria-selected="@(sel ? "true" : "false")"
                                @onclick:stopPropagation="true"
                                @onclick="() => SelectItem(fi)"
                                @ondblclick="() => OpenItem(fi)">
                                <td class="px-3 py-1.5" role="gridcell">
                                    <div class="flex items-center gap-2">
                                        @if (fi.IsDirectory)
                                        {
                                            <svg class="h-4 w-4 flex-shrink-0 text-yellow-400" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M2 6a2 2 0 012-2h4l2 2h4a2 2 0 012 2v7a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="h-4 w-4 flex-shrink-0 text-muted-foreground/60" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                            </svg>
                                        }
                                        <span class="truncate">@fi.Name</span>
                                    </div>
                                </td>
                                <td class="px-3 py-1.5 text-right text-muted-foreground" role="gridcell">
                                    @(fi.IsDirectory ? "—" : FormatSize(fi.SizeBytes))
                                </td>
                                <td class="px-3 py-1.5 text-right text-muted-foreground" role="gridcell">
                                    @(fi.Modified.HasValue ? fi.Modified.Value.ToString("d MMM yyyy") : "—")
                                </td>
                                @if (AllowDelete)
                                {
                                    <td class="px-3 py-1.5 text-right" role="gridcell">
                                        <button type="button"
                                                class="rounded p-1 text-muted-foreground transition-colors hover:bg-destructive/10 hover:text-destructive focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                                                aria-label="Delete @fi.Name"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => DeleteItem(fi)">
                                            <svg class="h-3.5 w-3.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <polyline points="3 6 5 6 21 6" />
                                                <path d="M19 6l-1 14H6L5 6" />
                                                <path d="M10 11v6m4-6v6" />
                                            </svg>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* ── Status bar ── *@
    <div class="flex flex-shrink-0 items-center justify-between border-t px-3 py-1 text-xs text-muted-foreground">
        <span>@VisibleItems.Count @(VisibleItems.Count == 1 ? "item" : "items")</span>
        @if (_selected is not null)
        {
            <span>
                <strong class="text-foreground">@_selected.Name</strong>
                @if (!_selected.IsDirectory)
                {
                    <span>&nbsp;·&nbsp;@FormatSize(_selected.SizeBytes)</span>
                }
            </span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public FileManagerItem Root { get; set; } = null!;
    [Parameter] public bool ShowTree { get; set; } = true;
    [Parameter] public bool AllowDelete { get; set; } = false;
    [Parameter] public string? Height { get; set; } = "height:420px";
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<FileManagerItem> OnFileOpen { get; set; }
    [Parameter] public EventCallback<FileManagerItem> OnSelect { get; set; }
    [Parameter] public EventCallback<FileManagerItem> OnDelete { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly List<FileManagerItem> _navPath = [];
    private readonly HashSet<FileManagerItem> _treeExpanded = [];
    private List<(FileManagerItem item, int level, bool hasChildren)> _treeRows = [];
    private FileManagerItem? _selected;
    private string _viewMode = "grid";
    private string _search = "";

    private FileManagerItem CurrentDir => _navPath.Count > 0 ? _navPath[^1] : Root;

    private List<FileManagerItem> VisibleItems
    {
        get
        {
            var src = CurrentDir.Children
                .OrderByDescending(i => i.IsDirectory)
                .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase);

            if (!string.IsNullOrWhiteSpace(_search))
                src = src.Where(i => i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
                         .OrderByDescending(i => i.IsDirectory)
                         .ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase);

            return src.ToList();
        }
    }

    protected override void OnParametersSet() => RebuildTree();

    // ── Tree ────────────────────────────────────────────────────────────────

    private void RebuildTree()
    {
        _treeRows = [];
        FlattenTree(Root.Children, 0);
    }

    private void FlattenTree(IEnumerable<FileManagerItem> items, int level)
    {
        foreach (var item in items.Where(i => i.IsDirectory).OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase))
        {
            var childDirs = item.Children.Where(c => c.IsDirectory).ToList();
            _treeRows.Add((item, level, childDirs.Count > 0));
            if (_treeExpanded.Contains(item))
                FlattenTree(childDirs, level + 1);
        }
    }

    private void ToggleTreeExpand(FileManagerItem item)
    {
        if (_treeExpanded.Contains(item)) _treeExpanded.Remove(item);
        else _treeExpanded.Add(item);
        RebuildTree();
    }

    private void OnTreeItemClick(FileManagerItem item)
    {
        var path = new List<FileManagerItem>();
        TryFindPath(Root, item, path);
        _navPath.Clear();
        _navPath.AddRange(path);
        _treeExpanded.Add(item);
        _selected = null;
        _search = "";
        RebuildTree();
    }

    private void OnTreeKeyDown(KeyboardEventArgs e, FileManagerItem item)
    {
        if (e.Key is "Enter" or " ") OnTreeItemClick(item);
    }

    private static bool TryFindPath(FileManagerItem root, FileManagerItem target, List<FileManagerItem> path)
    {
        foreach (var child in root.Children)
        {
            if (child == target) { path.Add(child); return true; }
            if (child.IsDirectory)
            {
                path.Add(child);
                if (TryFindPath(child, target, path)) return true;
                path.RemoveAt(path.Count - 1);
            }
        }
        return false;
    }

    // ── Navigation ──────────────────────────────────────────────────────────

    private void NavigateUp()
    {
        if (_navPath.Count > 0) _navPath.RemoveAt(_navPath.Count - 1);
        _selected = null;
        _search = "";
    }

    private void NavigateBreadcrumb(int index)
    {
        if (index < 0)
            _navPath.Clear();
        else
            _navPath.RemoveRange(index + 1, _navPath.Count - index - 1);

        _selected = null;
        _search = "";
    }

    // ── Item interaction ────────────────────────────────────────────────────

    private void SelectItem(FileManagerItem item)
    {
        _selected = item;
        OnSelect.InvokeAsync(item);
    }

    private void OpenItem(FileManagerItem item)
    {
        if (item.IsDirectory)
        {
            _navPath.Add(item);
            _treeExpanded.Add(item);
            _selected = null;
            _search = "";
            RebuildTree();
        }
        else
        {
            OnFileOpen.InvokeAsync(item);
        }
    }

    private void OnItemKeyDown(KeyboardEventArgs e, FileManagerItem item)
    {
        if (e.Key == "Enter") OpenItem(item);
        else if (e.Key == " ") SelectItem(item);
    }

    private void DeleteItem(FileManagerItem item)
    {
        if (_selected == item) _selected = null;
        OnDelete.InvokeAsync(item);
    }

    // ── Formatting ──────────────────────────────────────────────────────────

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024            => $"{bytes} B",
        < 1024 * 1024     => $"{bytes / 1024.0:F1} KB",
        _                 => $"{bytes / (1024.0 * 1024):F1} MB",
    };
}
