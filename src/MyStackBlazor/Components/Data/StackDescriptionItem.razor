@namespace MyStackBlazor.Components.Data

@if (Parent?.IsHorizontal ?? true)
{
    <div class="@($"grid grid-cols-1 gap-1 py-3 sm:grid-cols-3 sm:gap-4 {Class}".Trim())" @attributes="AdditionalAttributes">
        <dt class="font-medium text-muted-foreground">@Term</dt>
        <dd class="text-foreground sm:col-span-2">@Body</dd>
    </div>
}
else
{
    <div class="@($"flex flex-col gap-1 {Class}".Trim())" @attributes="AdditionalAttributes">
        <dt class="font-medium text-muted-foreground">@Term</dt>
        <dd class="text-foreground">@Body</dd>
    </div>
}

@code {
    [CascadingParameter] private StackDescriptionList? Parent { get; set; }

    /// <summary>The label, for example "Email".</summary>
    [Parameter, EditorRequired] public string Term { get; set; } = "";

    /// <summary>The value. Any markup is allowed (badges, links, buttons).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private RenderFragment Body => ChildContent ?? (b => b.AddContent(0, Parent?.EmptyText ?? "—"));
}
