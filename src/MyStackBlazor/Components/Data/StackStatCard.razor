@namespace MyStackBlazor.Components.Data
@using System.Globalization

@*
    KPI / statistic tile: label, big value, optional change vs. previous period, icon and sparkline slot.
    Example: <StackStatCard Label="Revenue" Value="₹4.2L" Change="12.5" ChangeLabel="vs last month" Icon="indian-rupee" />
*@
<div class="@ComputedClass" role="group" aria-label="@Label" @attributes="AdditionalAttributes">
    <div class="flex items-start justify-between gap-3">
        <p class="text-sm font-medium text-muted-foreground">@Label</p>
        @if (IconContent is not null)
        {
            @IconContent
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary">
                <StackLucideIcon Name="@Icon" Size="sm" />
            </span>
        }
    </div>

    @if (Loading)
    {
        <div class="mt-2 h-8 w-24 animate-pulse rounded bg-muted" aria-hidden="true"></div>
        <span class="sr-only">Loading</span>
    }
    else
    {
        <p class="mt-1 text-2xl font-bold tracking-tight text-foreground">
            @if (ValueContent is not null) { @ValueContent } else { @Value }
        </p>
    }

    @if (Change is decimal change && !Loading)
    {
        <p class="mt-1 flex flex-wrap items-center gap-1 text-xs">
            <span class="@TrendClass(change) inline-flex items-center gap-0.5 font-medium" data-trend="@TrendName(change)">
                @if (change != 0)
                {
                    <StackLucideIcon Name="@(change > 0 ? "trending-up" : "trending-down")" Size="xs" />
                }
                @FormatChange(change)
            </span>
            @if (!string.IsNullOrEmpty(ChangeLabel))
            {
                <span class="text-muted-foreground">@ChangeLabel</span>
            }
            <span class="sr-only">@SpokenChange(change)</span>
        </p>
    }

    @if (Description is not null)
    {
        <p class="mt-1 text-xs text-muted-foreground">@Description</p>
    }

    @if (ChildContent is not null)
    {
        <div class="mt-3">@ChildContent</div>
    }
</div>

@code {
    /// <summary>What is being measured, for example "Active users".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Pre-formatted value text. Use <see cref="ValueContent"/> for custom markup (such as a StackCountUp).</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public RenderFragment? ValueContent { get; set; }

    /// <summary>Change versus the previous period, in percent. Positive is shown as up.</summary>
    [Parameter] public decimal? Change { get; set; }

    /// <summary>Context for the change, for example "vs last month".</summary>
    [Parameter] public string? ChangeLabel { get; set; }

    /// <summary>When true, a drop is good news (costs, churn, response time) and is coloured green.</summary>
    [Parameter] public bool InvertTrend { get; set; }

    /// <summary>Lucide icon name shown in the top-right corner.</summary>
    [Parameter] public string? Icon { get; set; }

    [Parameter] public RenderFragment? IconContent { get; set; }

    /// <summary>Secondary text under the value.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Extra content at the bottom, for example a <c>StackSparkline</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Show a skeleton in place of the value and change.</summary>
    [Parameter] public bool Loading { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => $"rounded-lg border bg-card p-5 text-card-foreground shadow-sm {Class}".Trim();

    private static string TrendName(decimal change) => change > 0 ? "up" : change < 0 ? "down" : "flat";

    private string TrendClass(decimal change)
    {
        if (change == 0) return "text-muted-foreground";
        var good = (change > 0) != InvertTrend;
        return good ? "text-green-600 dark:text-green-400" : "text-destructive";
    }

    private static string FormatChange(decimal change) =>
        (change > 0 ? "+" : "") + change.ToString("0.#", CultureInfo.CurrentCulture) + "%";

    private static string SpokenChange(decimal change)
    {
        if (change == 0) return "No change";
        var amount = Math.Abs(change).ToString("0.#", CultureInfo.CurrentCulture);
        return change > 0 ? $"Up {amount} percent" : $"Down {amount} percent";
    }
}
