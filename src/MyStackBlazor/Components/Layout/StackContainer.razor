@namespace MyStackBlazor.Components.Layout

<div class="@ComputedClass" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Centred page-width wrapper with responsive side padding (MudContainer equivalent).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Max width: "sm" (640px), "md" (768px), "lg" (1024px), "xl" (1280px, default), "2xl" (1536px), "full".</summary>
    [Parameter] public string MaxWidth { get; set; } = "xl";
    /// <summary>Remove the side padding (e.g. for edge-to-edge content on phones).</summary>
    [Parameter] public bool DisableGutters { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass
    {
        get
        {
            var max = MaxWidth switch
            {
                "sm"   => "max-w-screen-sm",
                "md"   => "max-w-screen-md",
                "lg"   => "max-w-screen-lg",
                "2xl"  => "max-w-screen-2xl",
                "full" => "max-w-none",
                _      => "max-w-screen-xl",
            };
            return $"mx-auto w-full {max} {(DisableGutters ? "" : "px-4 sm:px-6 lg:px-8")} {Class}".Trim();
        }
    }
}
