@namespace MyStackBlazor.Components.Layout

<div class="@Class" @attributes="AdditionalAttributes">
    <!-- Header -->
    <button type="button"
            class="flex w-full items-center justify-between bg-muted/40 px-4 py-3 text-left text-sm font-medium hover:bg-muted/70 transition-colors focus:outline-none"
            aria-expanded="@IsOpen.ToString().ToLower()"
            @onclick="Toggle">
        <span class="flex items-center gap-2">
            @if (Icon is not null) { @Icon }
            @Title
        </span>
        <svg class="h-4 w-4 shrink-0 transition-transform duration-200 @(IsOpen ? "rotate-180" : "")"
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </button>

    <!-- Animated content -->
    <div style="display:grid; grid-template-rows:@(IsOpen ? "1fr" : "0fr"); transition:grid-template-rows 200ms ease-out;">
        <div style="overflow:hidden;">
            <div class="px-4 py-3 text-sm">@ChildContent</div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public PanelBar? Parent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Key { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsOpen => Parent?.IsOpen(Key ?? Title) ?? false;
    private void Toggle() => Parent?.Toggle(Key ?? Title);
}
