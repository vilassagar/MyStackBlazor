@namespace MyStackBlazor.Components.Layout

<div class="@HandleClass"
     role="separator"
     aria-orientation="@(Group?.IsHorizontal == true ? "vertical" : "horizontal")"
     @onmousedown="OnMouseDown"
     @onmousedown:preventDefault="true">
    @if (WithHandle)
    {
        <div class="@GripClass">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                 class="@GripIconClass">
                @if (Group?.IsHorizontal == true)
                {
                    <path d="M8 5a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm0 5a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm0 5a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm8-10a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm0 5a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm0 5a1 1 0 1 0 0-2 1 1 0 0 0 0 2z" />
                }
                else
                {
                    <path d="M5 8a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm5 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm5 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0zM5 16a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm5 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0zm5 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0z" />
                }
            </svg>
        </div>
    }
</div>

@code {
    [CascadingParameter] public StackResizablePanelGroup? Group { get; set; }
    [Parameter] public bool WithHandle { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private int _handleIndex = -1;

    protected override void OnInitialized()
    {
        _handleIndex = Group?.GetNextHandleIndex() ?? 0;
    }

    private string HandleClass
    {
        get
        {
            var orientation = Group?.IsHorizontal == true
                ? "w-1.5 cursor-col-resize flex-col"
                : "h-1.5 cursor-row-resize flex-row";
            return $"relative flex shrink-0 items-center justify-center bg-border hover:bg-primary/30 transition-colors {orientation} {Class}".Trim();
        }
    }

    private string GripClass =>
        "z-10 flex h-4 w-4 items-center justify-center rounded-sm border border-border bg-background";

    private string GripIconClass => "h-2.5 w-2.5 text-muted-foreground";

    private async Task OnMouseDown(MouseEventArgs e)
    {
        if (Group is not null)
            await Group.StartDrag(_handleIndex);
    }
}
