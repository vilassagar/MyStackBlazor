@namespace MyStackBlazor.Components.Charts

<StackPieChart Segments="Segments"
               Title="Title"
               Donut="true"
               CenterLabel="CenterLabel"
               ShowLegend="ShowLegend"
               ShowPercentages="ShowPercentages"
               ShowTooltip="ShowTooltip"
               Class="Class"
               AdditionalAttributes="AdditionalAttributes" />

@code {
    [EditorRequired, Parameter] public IReadOnlyList<ChartSegment> Segments { get; set; } = [];
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? CenterLabel { get; set; }
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool ShowPercentages { get; set; } = true;
    [Parameter] public bool ShowTooltip { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
