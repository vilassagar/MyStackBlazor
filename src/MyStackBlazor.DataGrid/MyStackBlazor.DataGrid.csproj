<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>MyStackBlazor.DataGrid</PackageId>
    <Description>High-performance enterprise data grid for MyStackBlazor. Supports server-side paging, sorting, filtering, virtualization, and Excel export via ClosedXML.</Description>
    <PackageTags>blazor;datagrid;grid;virtualize;excel;export;enterprise</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyStackBlazor.Core\MyStackBlazor.Core.csproj" />
    <ProjectReference Include="..\MyStackBlazor.Accessibility\MyStackBlazor.Accessibility.csproj" />
  </ItemGroup>

</Project>
