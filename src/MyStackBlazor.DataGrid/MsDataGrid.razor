    // ── Freeze/pinned columns ─────────────────────────────────────────────
    /// <summary>Fallback pixel width used when a frozen column's Width isn't an explicit px value.</summary>
    private const double DefaultFrozenColumnPx = 150d;

    private static double ParsePxWidth(string? width)
    {
        if (!string.IsNullOrWhiteSpace(width) &&
            width.EndsWith("px", StringComparison.OrdinalIgnoreCase) &&
            double.TryParse(width.AsSpan(0, width.Length - 2), out var px))
            return px;
        return DefaultFrozenColumnPx;
    }

    private string? GetFrozenStyle(MsDataGridColumn<TItem> col)
    {
        if (col.Frozen == FreezePosition.None) return null;
        var visible = VisibleColumns.ToList();
        var idx = visible.IndexOf(col);
        if (idx < 0) return null;

        double offset = 0;
        if (col.Frozen == FreezePosition.Left)
        {
            if (DetailTemplate is not null) offset += 40;
            if (SelectionMode == SelectionMode.Multiple) offset += 40;
            for (var i = 0; i < idx; i++)
                if (visible[i].Frozen == FreezePosition.Left)
                    offset += ParsePxWidth(visible[i].Width);
            return $"position:sticky;left:{offset.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;z-index:2;background:inherit;";
        }
        else
        {
            for (var i = visible.Count - 1; i > idx; i--)
                if (visible[i].Frozen == FreezePosition.Right)
                    offset += ParsePxWidth(visible[i].Width);
            return $"position:sticky;right:{offset.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;z-index:2;background:inherit;";
        }
    }

