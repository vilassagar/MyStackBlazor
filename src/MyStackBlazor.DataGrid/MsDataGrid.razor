@namespace MyStackBlazor.DataGrid
@using MyStackBlazor.DataGrid.Models
@using MyStackBlazor.DataGrid.Services
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

<div class="ms-datagrid w-full overflow-hidden rounded-lg border border-border bg-background shadow-sm"
     role="grid"
     aria-label="@(AriaLabel ?? "Data Grid")"
     aria-rowcount="@_totalCount"
     aria-busy="@(_isLoading ? "true" : null)">

    @* ── Toolbar ─────────────────────────────────────────────────────────── *@
    <div class="ms-datagrid__toolbar flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3">
        <div class="flex items-center gap-2 flex-1 min-w-0">
            <div class="relative max-w-xs flex-1">
                <input type="search"
                       class="w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                       placeholder="@Labels.SearchPlaceholder"
                       aria-label="Search grid"
                       value="@_state.SearchTerm"
                       @oninput="OnSearchInput" />
            </div>
            @if (EditMode != EditMode.None && NewRowFactory is not null)
            {
                <button class="inline-flex items-center gap-1.5 rounded-md border border-input bg-background px-3 py-1.5 text-sm hover:bg-accent"
                        aria-label="Add row" @onclick="AddRow">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    @Labels.AddRowText
                </button>
            }
            @if (EditMode == EditMode.Batch && _batchEdits.Count > 0)
            {
                <button class="inline-flex items-center gap-1.5 rounded-md bg-primary text-primary-foreground px-3 py-1.5 text-sm hover:bg-primary/90"
                        @onclick="SaveBatchEdits">
                    Save All (@_batchEdits.Count)
                </button>
                <button class="inline-flex items-center gap-1.5 rounded-md border border-input bg-background px-3 py-1.5 text-sm hover:bg-accent"
                        @onclick="CancelBatchEdits">
                    Discard
                </button>
            }
        </div>
        <div class="flex items-center gap-2">
            @if (_isLoading)
            {
                <span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-muted border-t-primary"
                      aria-label="Loading" role="status"></span>
            }

            @* Column chooser *@
            @if (_columns.Count > 0)
            {
                <div class="relative">
                    <button class="inline-flex items-center gap-1.5 rounded-md border border-input bg-background px-3 py-1.5 text-sm hover:bg-accent"
                            aria-label="Column chooser" aria-expanded="@_showColumnChooser"
                            @onclick="ToggleColumnChooser">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                        @Labels.ColumnsText
                    </button>
                    @if (_showColumnChooser)
                    {
                        <div class="fixed inset-0 z-40" @onclick="() => _showColumnChooser = false"></div>
                        <div class="absolute right-0 top-full z-50 mt-1 min-w-[11rem] rounded-md border border-border bg-background shadow-lg"
                             role="dialog" aria-label="Column visibility">
                            <div class="p-2 space-y-0.5 max-h-72 overflow-y-auto">
                                @foreach (var col in _columns)
                                {
                                    var isVisible = !_hiddenColumns.Contains(col.Field);
                                    <label class="flex items-center gap-2 px-2 py-1.5 rounded hover:bg-muted cursor-pointer text-sm select-none">
                                        <input type="checkbox" class="rounded" checked="@isVisible"
                                               @onclick:stopPropagation="true"
                                               @onchange="e => ToggleColumnVisibility(col, (bool)(e.Value ?? true))" />
                                        @col.Title
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @* Export dropdown *@
            <div class="relative">
                <button class="inline-flex items-center gap-1.5 rounded-md border border-input bg-background px-3 py-1.5 text-sm hover:bg-accent disabled:pointer-events-none disabled:opacity-50"
                        aria-label="Export options" disabled="@(_isLoading || DataProvider is null)"
                        @onclick="ToggleExportMenu">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    @Labels.ExportText
                    <svg class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                @if (_showExportMenu)
                {
                    <div class="fixed inset-0 z-40" @onclick="() => _showExportMenu = false"></div>
                    <div class="absolute right-0 top-full z-50 mt-1 min-w-[9rem] rounded-md border border-border bg-background shadow-lg py-1">
                        <button class="w-full text-left px-4 py-2 text-sm hover:bg-muted"
                                @onclick="ExportExcel">Excel (.xlsx)</button>
                        <button class="w-full text-left px-4 py-2 text-sm hover:bg-muted"
                                @onclick="ExportCsv">CSV (.csv)</button>
                        <button class="w-full text-left px-4 py-2 text-sm hover:bg-muted"
                                @onclick="ExportJson">JSON (.json)</button>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Group Panel ──────────────────────────────────────────────────────── *@
    @if (ShowGroupPanel)
    {
        <div class="ms-datagrid__group-panel flex flex-wrap items-center gap-2 border-b border-border px-4 py-2 min-h-[42px] bg-muted/20">
            @if (_activeGroups.Count == 0)
            {
                <span class="text-xs text-muted-foreground italic">
                    Click the ≡ icon in a column header to group by that column.
                </span>
            }
            else
            {
                <span class="text-xs text-muted-foreground mr-1">Grouped by:</span>
                @foreach (var field in _activeGroups)
                {
                    var f = field;
                    var title = _columns.FirstOrDefault(c => c.Field == f)?.Title ?? f;
                    <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary">
                        @title
                        <button class="ml-1 hover:text-destructive leading-none" aria-label="Remove group"
                                @onclick="() => RemoveGroup(f)">×</button>
                    </span>
                }
                <button class="ml-auto text-xs text-muted-foreground hover:text-foreground hover:underline underline-offset-2"
                        @onclick="ClearGroups">Clear all</button>
            }
        </div>
    }

    @* ── Column header row is rendered inside the scrollable body below (as its first child) so `position:sticky` pins it to the top while rows scroll underneath ── *@

    @* ── Filter row ───────────────────────────────────────────────────────── *@
    @if (ShowFilterRow && VisibleColumns.Any(c => c.Filterable))
    {
        <div class="ms-datagrid__filters grid border-b border-border bg-background" role="row"
             style="grid-template-columns: @_columnTemplate">
            @if (DetailTemplate is not null)
            {
                <div class="px-3 py-1.5" role="columnheader"></div>
            }
            @if (SelectionMode == SelectionMode.Multiple)
            {
                <div class="px-3 py-1.5" role="columnheader"></div>
            }
            @foreach (var col in VisibleColumns)
            {
                <div class="px-3 py-1.5" role="columnheader" style="@GetFrozenStyle(col)">
                    @if (col.Filterable)
                    {
                        <input type="search"
                               class="w-full rounded border border-input bg-muted/30 px-2 py-1 text-xs placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                               placeholder="Filter…"
                               aria-label="@($"Filter by {col.Title}")"
                               value="@(_filterInputs.TryGetValue(col.Field, out var fv) ? fv : "")"
                               @oninput="e => OnFilterInput(col.Field, e.Value?.ToString())" />
                    }
                </div>
            }
            @if (_commandColumn is not null || EditMode == EditMode.Row)
            {
                <div class="px-3 py-1.5" role="columnheader"></div>
            }
        </div>
    }

    @* ── Body (header row is the first child so it can stick to the top of this scroll container) ─────────────────────────────────────────────────── *@
    <div class="ms-datagrid__body relative"
         style="@(Pageable || _activeGroups.Count > 0 ? "" : $"height:{BodyHeight};overflow-y:auto;")">
    <div class="ms-datagrid__header grid bg-muted/40 border-b border-border" role="row"
         style="grid-template-columns: @_columnTemplate; position:sticky; top:0; z-index:3;">
        @if (DetailTemplate is not null)
        {
            <div class="flex items-center justify-center px-3 py-3" role="columnheader" aria-label="Expand column"></div>
        }
        @if (SelectionMode == SelectionMode.Multiple)
        {
            <div class="flex items-center justify-center px-3 py-3" role="columnheader" aria-label="Select all">
                <input type="checkbox" class="rounded" aria-label="Select all rows"
                       checked="@_allSelected" @onchange="ToggleSelectAll" />
            </div>
        }
        @foreach (var col in VisibleColumns)
        {
            var sortDir = GetSortState(col.Field);
            var sortOrd = GetSortOrder(col.Field);
            var hasMenuFilter = _menuFilters.TryGetValue(col.Field, out var mfc) && !string.IsNullOrEmpty(mfc.Value);
            <div class="relative flex items-center px-4 py-3 text-sm font-semibold text-foreground @(col.Sortable ? "cursor-pointer select-none hover:bg-muted/60" : "")"
                 role="columnheader"
                 aria-sort="@GetAriaSortValue(sortDir)"
                 title="@col.Tooltip"
                 style="@GetFrozenStyle(col)"
                 @onclick="e => OnSortClicked(col, e)">
                <span class="flex-1 truncate">@col.Title</span>

                @* Sort indicator *@
                @if (col.Sortable)
                {
                    <span class="ml-1 text-xs" aria-hidden="true">
                        @if (sortDir == SortDirection.Ascending)
                        {
                            <span class="opacity-70">↑</span>
                            @if (_state.Sort.Count > 1 && sortOrd > 0)
                            {
                                <sup class="text-[9px] opacity-70">@sortOrd</sup>
                            }
                        }
                        else if (sortDir == SortDirection.Descending)
                        {
                            <span class="opacity-70">↓</span>
                            @if (_state.Sort.Count > 1 && sortOrd > 0)
                            {
                                <sup class="text-[9px] opacity-70">@sortOrd</sup>
                            }
                        }
                        else { <span class="opacity-30">↕</span> }
                    </span>
                }

                @* Group button *@
                @if (ShowGroupPanel && col.Groupable)
                {
                    var gf = col.Field;
                    var isGrouped = _activeGroups.Contains(gf);
                    <button class="ml-1 text-xs @(isGrouped ? "text-primary" : "opacity-40 hover:opacity-100")"
                            title="@(isGrouped ? "Remove group" : "Group by " + col.Title)"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleGroup(gf)">≡</button>
                }

                @* Filter icon + menu *@
                @if (col.Filterable)
                {
                    var filterCol = col;
                    <button class="ml-1 @(hasMenuFilter ? "text-primary" : "opacity-40 hover:opacity-100")"
                            title="Filter @col.Title"
                            aria-label="Filter @col.Title"
                            @onclick:stopPropagation="true"
                            @onclick="() => OpenFilterMenu(filterCol)">
                        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L13 10.414V15a1 1 0 01-.553.894l-4 2A1 1 0 017 17v-6.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
                        </svg>
                    </button>
                    @if (_filterMenuField == col.Field)
                    {
                        var fmf = col.Field;
                        <div class="fixed inset-0 z-40" @onclick="CloseFilterMenu"></div>
                        <div class="absolute top-full left-0 z-50 w-64 rounded-md border border-border bg-background shadow-xl"
                             role="dialog" aria-label="@($"Filter {col.Title}")">
                            @if (col.Sortable)
                            {
                                <div class="border-b border-border p-1 space-y-0.5">
                                    <button class="w-full flex items-center gap-2 px-3 py-1.5 rounded text-sm hover:bg-muted text-left"
                                            @onclick="() => MenuSortAsc(fmf)">
                                        <span>↑</span> Sort A → Z
                                    </button>
                                    <button class="w-full flex items-center gap-2 px-3 py-1.5 rounded text-sm hover:bg-muted text-left"
                                            @onclick="() => MenuSortDesc(fmf)">
                                        <span>↓</span> Sort Z → A
                                    </button>
                                    @if (sortDir is not null)
                                    {
                                        <button class="w-full flex items-center gap-2 px-3 py-1.5 rounded text-sm hover:bg-muted text-left text-muted-foreground"
                                                @onclick="() => MenuRemoveSort(fmf)">
                                            Remove Sort
                                        </button>
                                    }
                                </div>
                            }
                            <div class="p-3 space-y-2">
                                <p class="text-xs font-medium text-muted-foreground">@Labels.ShowRowsWhereText</p>
                                @{
                                    var curFilter = _menuFilters.TryGetValue(col.Field, out var ef) ? ef : new MenuFilter();
                                }
                                <select class="w-full rounded border border-input bg-background px-2 py-1 text-xs"
                                        value="@curFilter.OperatorKey"
                                        @onchange="e => OnMenuFilterOpChange(fmf, e)">
                                    @foreach (var op in GetFilterOps(col))
                                    {
                                        <option value="@op.Key">@op.Label</option>
                                    }
                                </select>
                                @if (!IsNullOp(curFilter.OperatorKey))
                                {
                                    <input class="w-full rounded border border-input bg-background px-2 py-1 text-xs"
                                           type="@MenuInputType(col)"
                                           placeholder="Value…"
                                           value="@curFilter.Value"
                                           @oninput="e => SetMenuFilterVal(fmf, e.Value?.ToString())" />
                                }
                                <div class="flex gap-2 pt-1">
                                    <button class="flex-1 rounded bg-primary text-primary-foreground px-3 py-1.5 text-xs font-medium hover:bg-primary/90"
                                            @onclick="() => ApplyMenuFilter(fmf)">Filter</button>
                                    <button class="flex-1 rounded border border-input bg-background px-3 py-1.5 text-xs hover:bg-muted"
                                            @onclick="() => ClearMenuFilter(fmf)">Clear</button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        @if (_commandColumn is not null || EditMode == EditMode.Row)
        {
            <div class="flex items-center px-4 py-3 text-sm font-semibold text-foreground" role="columnheader">
                @(_commandColumn?.Title ?? "")
            </div>
        }
    </div>

        @if (DataProvider is not null)
        {
            @if (Pageable || _activeGroups.Count > 0)
            {
                @if (_displayRows.Count > 0)
                {
                    @foreach (var dr in _displayRows)
                    {
                        @if (dr.IsGroup)
                        {
                            @RenderGroupHeader(dr.Group!)
                        }
                        else
                        {
                            @RenderDataRow(dr.Data!)
                            @if (DetailTemplate is not null && IsExpanded(dr.Data!))
                            {
                                @RenderDetailRow(dr.Data!)
                            }
                        }
                    }
                }
                else if (!_isLoading)
                {
                    @RenderEmptyState()
                }
            }
            else
            {
                <Virtualize ItemsProvider="@LoadServerRowsAsync"
                            ItemSize="@RowHeight"
                            OverscanCount="@OverscanCount"
                            Context="row"
                            @ref="_virtualizeRef">
                    <ItemContent>
                        @RenderDataRow(row)
                        @if (DetailTemplate is not null && IsExpanded(row))
                        {
                            @RenderDetailRow(row)
                        }
                    </ItemContent>
                    <Placeholder>
                        <div class="grid animate-pulse border-b border-border/50"
                             style="grid-template-columns: @_columnTemplate; height: @(RowHeight)px; align-items:center; padding:0 1rem;">
                            @foreach (var _ in VisibleColumns)
                            {
                                <div class="h-4 rounded bg-muted mx-1"></div>
                            }
                        </div>
                    </Placeholder>
                </Virtualize>
                @if (_hasData && _totalCount == 0 && !_isLoading)
                {
                    @RenderEmptyState()
                }
            }
        }
        else
        {
            <div class="flex items-center justify-center py-16 text-muted-foreground text-sm select-none">
                No data provider configured.
            </div>
        }
    </div>

    @* ── Footer / Pager ───────────────────────────────────────────────────── *@
    <div class="ms-datagrid__footer flex items-center justify-between border-t border-border px-4 py-2 text-sm text-muted-foreground">
        <span>
            @if (_hasData)
            {
                @if (SelectionMode == SelectionMode.Multiple && _selectedItems.Count > 0)
                {
                    @($"{_selectedItems.Count:N0} of {_totalCount:N0} selected")
                }
                else
                {
                    @($"{_totalCount:N0} {(_totalCount == 1 ? "row" : "rows")}")
                }
            }
        </span>
        @if (Pageable && _activeGroups.Count == 0 && _totalCount > 0)
        {
            <div class="flex items-center gap-1" role="navigation" aria-label="Pagination">
                <button class="@PagerBtnBase" disabled="@(_currentPage == 0)" @onclick="() => GoToPage(0)">«</button>
                <button class="@PagerBtnBase" disabled="@(_currentPage == 0)" @onclick="() => GoToPage(_currentPage - 1)">‹</button>
                @foreach (var pg in PageNumbers)
                {
                    var p = pg;
                    <button class="@(_currentPage == p ? "bg-primary text-primary-foreground border-primary" : "hover:bg-accent border-input") inline-flex items-center justify-center rounded w-7 h-7 text-xs border"
                            aria-current="@(_currentPage == p ? "page" : null)"
                            @onclick="() => GoToPage(p)">@(p + 1)</button>
                }
                <button class="@PagerBtnBase" disabled="@(_currentPage >= _lastPage)" @onclick="() => GoToPage(_currentPage + 1)">›</button>
                <button class="@PagerBtnBase" disabled="@(_currentPage >= _lastPage)" @onclick="() => GoToPage(_lastPage)">»</button>
                <span class="ml-2 text-xs">Page @(_currentPage + 1) of @(_lastPage + 1)</span>
            </div>
        }
        else if (SelectedItem is not null && SelectionMode == SelectionMode.Single)
        {
            <span class="text-xs">1 row selected</span>
        }
    </div>

    @* ── Summary/aggregate row (computed over the full filtered/sorted dataset, not just the current page) ── *@
    @if (VisibleColumns.Any(c => c.SummaryFunc is not null))
    {
        <div class="ms-datagrid__summary grid border-t border-border bg-muted/20 text-sm font-medium" role="row"
             style="grid-template-columns: @_columnTemplate">
            @if (DetailTemplate is not null)
            {
                <div class="px-3 py-2" role="gridcell"></div>
            }
            @if (SelectionMode == SelectionMode.Multiple)
            {
                <div class="px-3 py-2" role="gridcell"></div>
            }
            @foreach (var col in VisibleColumns)
            {
                <div class="px-4 py-2 truncate" role="gridcell" style="@GetFrozenStyle(col)">
                    @(col.SummaryFunc?.Invoke(_summaryItems) ?? "")
                </div>
            }
            @if (_commandColumn is not null || EditMode == EditMode.Row)
            {
                <div class="px-3 py-2" role="gridcell"></div>
            }
        </div>
    }
</div>

@code {
    // ── Parameters ────────────────────────────────────────────────────────
    [Parameter] public IGridDataProvider<TItem>? DataProvider { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string BodyHeight { get; set; } = "480px";
    [Parameter] public float RowHeight { get; set; } = 52f;
    [Parameter] public int OverscanCount { get; set; } = 10;
    [Parameter] public EventCallback<(byte[] Data, string Format)> OnExported { get; set; }
    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<TItem?> SelectedItemChanged { get; set; }
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }
    [Parameter] public SelectionMode SelectionMode { get; set; } = SelectionMode.Single;
    [Parameter] public IReadOnlyList<TItem> SelectedItems { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<TItem>> SelectedItemsChanged { get; set; }
    [Parameter] public bool Pageable { get; set; } = false;
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public bool ShowGroupPanel { get; set; } = false;
    [Parameter] public bool ShowFilterRow { get; set; } = true;
    [Parameter] public EditMode EditMode { get; set; } = EditMode.None;
    [Parameter] public Func<TItem>? NewRowFactory { get; set; }
    [Parameter] public EventCallback<TItem> OnRowSaved { get; set; }
    [Parameter] public EventCallback<TItem> OnRowAdded { get; set; }
    [Parameter] public EventCallback<TItem> OnRowDeleted { get; set; }
    /// <summary>When set, a leading expand/collapse chevron column is rendered and this fragment is shown in a full-width row under an expanded item.
    /// Nested grids are achieved simply by placing a child &lt;MsDataGrid TItem="..."&gt; inside this template — no separate code path needed.</summary>
    [Parameter] public RenderFragment<TItem>? DetailTemplate { get; set; }
    [Parameter] public GridLabels Labels { get; set; } = GridLabels.Default;

    // ── Internal types ────────────────────────────────────────────────────
    private sealed class DisplayItem
    {
        public TItem? Data { get; init; }
        public GroupHeader? Group { get; init; }
        public bool IsGroup => Group is not null;
        public static DisplayItem FromData(TItem d) => new() { Data = d };
        public static DisplayItem FromGroup(GroupHeader g) => new() { Group = g };
    }

    private sealed class MenuFilter
    {
        public string OperatorKey { get; set; } = "contains";
        public string? Value { get; set; }
    }

    // ── State ─────────────────────────────────────────────────────────────
    private readonly List<MsDataGridColumn<TItem>> _columns = [];
    private MsDataGridCommandColumn<TItem>? _commandColumn;
    private readonly HashSet<string> _hiddenColumns = [];
    private readonly Dictionary<string, string> _filterInputs = [];
    private GridState _state = GridState.Default;
    private int _totalCount;
    private bool _isLoading;
    private bool _hasData;
    private Virtualize<TItem>? _virtualizeRef;
    private bool _showColumnChooser;
    private bool _showExportMenu;
    private readonly HashSet<TItem> _selectedItems = [];
    private bool _allSelected;
    private int _currentPage;
    private int _lastPage;

    // Detail view (expandable rows) — follows the same reference/value-equality assumption as _selectedItems
    private readonly HashSet<TItem> _expandedRows = [];

    // Summary/aggregate footer — holds the full filtered/sorted dataset (not just the current page)
    private List<TItem> _summaryItems = [];

    // Display rows (paged + grouped)
    private readonly List<DisplayItem> _displayRows = [];
    private List<TItem> _allItems = [];

    // Grouping
    private readonly List<string> _activeGroups = [];

    // Filter menu
    private string? _filterMenuField;
    private readonly Dictionary<string, MenuFilter> _menuFilters = [];

    // Editing
    private TItem? _editingRow;
    private readonly Dictionary<string, string> _rowEditBuffer = [];
    private string? _editingCellField;
    private string _cellEditValue = "";
    // Batch: index in _displayRows → field edits
    private readonly List<(TItem Row, Dictionary<string, string> Edits)> _batchEdits = [];

    // ── Operator tables (per data type) ──────────────────────────────────
    private static readonly (string Key, string Label)[] TextFilterOps =
    [
        ("contains",    "Contains"),
        ("notcontains", "Does not contain"),
        ("equals",      "Equals"),
        ("notequals",   "Does not equal"),
        ("startswith",  "Starts with"),
        ("endswith",    "Ends with"),
