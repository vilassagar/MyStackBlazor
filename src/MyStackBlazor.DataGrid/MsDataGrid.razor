        RefreshData();
    }

    private void OnFilterInput(string field, string? value)
    {
        if (string.IsNullOrEmpty(value)) _filterInputs.Remove(field);
        else _filterInputs[field] = value;
        ApplyAllFilters();
        _currentPage = 0;
        RefreshData();
    }

    // ── Filter menu ───────────────────────────────────────────────────────
    private void OpenFilterMenu(MsDataGridColumn<TItem> col)
    {
        if (_filterMenuField == col.Field)
        {
            _filterMenuField = null;
        }
        else
        {
            _filterMenuField = col.Field;
            // Seed a type-appropriate default operator the first time the menu opens
            if (!_menuFilters.ContainsKey(col.Field))
                _menuFilters[col.Field] = new MenuFilter
                {
                    OperatorKey = col.EditorType is EditorType.Number
                                                  or EditorType.Date
                                                  or EditorType.DateTime
                        ? "equals" : "contains"
                };
        }
        StateHasChanged();
    }

    private void CloseFilterMenu() { _filterMenuField = null; StateHasChanged(); }

    private void OnMenuFilterOpChange(string field, ChangeEventArgs e)
    {
        var ops = GetFilterOps(_columns.FirstOrDefault(c => c.Field == field)!);
        var op = e.Value?.ToString() ?? ops[0].Key;
        SetMenuFilterOp(field, op);
    }

    private void SetMenuFilterOp(string field, string op)
    {
        GetOrCreateMenuFilter(field).OperatorKey = op;
        StateHasChanged();
    }

    private void SetMenuFilterVal(string field, string? val)
    {
        GetOrCreateMenuFilter(field).Value = val;
        StateHasChanged();
    }

    private MenuFilter GetOrCreateMenuFilter(string field)
    {
        if (!_menuFilters.TryGetValue(field, out var mf)) _menuFilters[field] = mf = new MenuFilter();
        return mf;
    }

    private void ApplyMenuFilter(string field)
    {
        _filterMenuField = null;
        _currentPage = 0;
        ApplyAllFilters();
        RefreshData();
    }

    private void ClearMenuFilter(string field)
    {
        _menuFilters.Remove(field);
        _filterMenuField = null;
        _currentPage = 0;
        ApplyAllFilters();
        RefreshData();
    }

    private void ApplyAllFilters()
    {
        var descriptors = new List<FilterDescriptor>();
        foreach (var (field, value) in _filterInputs)
            if (!string.IsNullOrEmpty(value))
                descriptors.Add(new FilterDescriptor(field, FilterOperator.Contains, value));

        foreach (var (field, mf) in _menuFilters)
        {
            if (string.IsNullOrEmpty(mf.Value) && !IsNullOp(mf.OperatorKey)) continue;
            var op = mf.OperatorKey switch
            {
                "contains"    => FilterOperator.Contains,
                "notcontains" => FilterOperator.NotEquals,
                "equals"      => FilterOperator.Equals,
                "notequals"   => FilterOperator.NotEquals,
                "startswith"  => FilterOperator.StartsWith,
                "endswith"    => FilterOperator.EndsWith,
                "gt"          => FilterOperator.GreaterThan,
                "lt"          => FilterOperator.LessThan,
                "gte"         => FilterOperator.GreaterThanOrEqual,
                "lte"         => FilterOperator.LessThanOrEqual,
                "isnull"      => FilterOperator.IsNull,
                _             => FilterOperator.IsNotNull
            };
            descriptors.Add(new FilterDescriptor(field, op, mf.Value));
        }
        _state = _state.WithFilters(descriptors);
    }

    // ── Grouping ──────────────────────────────────────────────────────────
    private void ToggleGroup(string field)
    {
        if (_activeGroups.Contains(field)) _activeGroups.Remove(field);
        else _activeGroups.Add(field);
        _currentPage = 0;
        RefreshData();
    }

    private void RemoveGroup(string field) { _activeGroups.Remove(field); RefreshData(); }
    private void ClearGroups() { _activeGroups.Clear(); RefreshData(); }

    private void ToggleGroupCollapse(GroupHeader hdr)
    {
        hdr.Collapsed = !hdr.Collapsed;
        RebuildGroupDisplay();
        StateHasChanged();
    }

    private void RebuildGroupDisplay()
    {
        _displayRows.Clear();
        if (_activeGroups.Count == 0)
        {
            foreach (var item in _allItems) _displayRows.Add(DisplayItem.FromData(item));
            return;
        }

        var groupField = _activeGroups[0];
        var colTitle = _columns.FirstOrDefault(c => c.Field == groupField)?.Title ?? groupField;
        var grouped = _allItems
            .GroupBy(item => _columns.FirstOrDefault(c => c.Field == groupField)?.GetValue(item))
            .OrderBy(g => g.Key?.ToString());

        foreach (var g in grouped)
        {
            var hdr = new GroupHeader
            {
                Field = groupField,
                ColumnTitle = colTitle,
                Value = g.Key,
                Count = g.Count()
            };
            _displayRows.Add(DisplayItem.FromGroup(hdr));
            if (!hdr.Collapsed)
                foreach (var item in g) _displayRows.Add(DisplayItem.FromData(item));
        }
    }

    // ── Editing ───────────────────────────────────────────────────────────
    private bool IsRowEditing(TItem row) =>
        _editingRow is not null && EqualityComparer<TItem>.Default.Equals(_editingRow, row);

    private string GetEditValue(TItem row, MsDataGridColumn<TItem> col)
    {
        var batchEntry = _batchEdits.FirstOrDefault(e => EqualityComparer<TItem>.Default.Equals(e.Row, row));
        if (batchEntry.Edits?.TryGetValue(col.Field, out var bv) == true) return bv;
        if (_rowEditBuffer.TryGetValue(col.Field, out var rv)) return rv;
        return col.GetValue(row)?.ToString() ?? "";
    }

    private void SetEditValue(TItem row, string field, string value)
    {
        if (EditMode == EditMode.Batch)
        {
            var idx = _batchEdits.FindIndex(e => EqualityComparer<TItem>.Default.Equals(e.Row, row));
            if (idx < 0) { _batchEdits.Add((row, [])); idx = _batchEdits.Count - 1; }
            _batchEdits[idx].Edits[field] = value;
        }
        else
        {
            _rowEditBuffer[field] = value;
        }
    }

    private void StartRowEdit(TItem row)
    {
        _editingRow = row;
        _rowEditBuffer.Clear();
        foreach (var col in _columns.Where(c => c.Editable))
            _rowEditBuffer[col.Field] = col.GetValue(row)?.ToString() ?? "";
        StateHasChanged();
    }

    private async Task SaveRowEdit(TItem row)
    {
        foreach (var col in _columns.Where(c => c.Editable && c.ValueSetter is not null))
            if (_rowEditBuffer.TryGetValue(col.Field, out var v)) col.SetValue(row, v);
        _editingRow = default;
        _rowEditBuffer.Clear();
        await OnRowSaved.InvokeAsync(row);
        StateHasChanged();
    }

    private void CancelRowEdit() { _editingRow = default; _rowEditBuffer.Clear(); StateHasChanged(); }

    private void StartCellEdit(TItem row, string field)
    {
        var col = _columns.FirstOrDefault(c => c.Field == field);
        _editingRow = row;
        _editingCellField = field;
        _cellEditValue = col?.GetValue(row)?.ToString() ?? "";
        StateHasChanged();
    }

    private async Task CommitCellEdit(TItem row, MsDataGridColumn<TItem> col)
    {
        col.SetValue(row, _cellEditValue);
        _editingRow = default;
        _editingCellField = null;
        await OnRowSaved.InvokeAsync(row);
        StateHasChanged();
    }

    private void CancelCellEdit() { _editingRow = default; _editingCellField = null; StateHasChanged(); }

    private async Task SaveBatchEdits()
    {
        foreach (var (row, edits) in _batchEdits)
        {
            foreach (var col in _columns.Where(c => c.Editable && c.ValueSetter is not null))
                if (edits.TryGetValue(col.Field, out var v)) col.SetValue(row, v);
            await OnRowSaved.InvokeAsync(row);
        }
        _batchEdits.Clear();
        StateHasChanged();
    }

    private void CancelBatchEdits() { _batchEdits.Clear(); StateHasChanged(); }

    private async Task AddRow()
    {
        if (NewRowFactory is null) return;
        var newItem = NewRowFactory();
        _displayRows.Insert(0, DisplayItem.FromData(newItem));
        _totalCount++;
        await OnRowAdded.InvokeAsync(newItem);
        StartRowEdit(newItem);
    }

    // ── Row interaction ───────────────────────────────────────────────────
    private async Task HandleRowClick(TItem row)
    {
        if (EditMode == EditMode.Cell) return;
        if (SelectionMode == SelectionMode.Multiple) { ToggleItemSelection(row); return; }
        SelectedItem = row;
        await SelectedItemChanged.InvokeAsync(row);
        await OnRowClick.InvokeAsync(row);
        StateHasChanged();
    }

    private void OnRowKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, TItem row)
    {
        if (e.Key is "Enter" or " ") _ = HandleRowClick(row);
    }

    // ── Data loading ──────────────────────────────────────────────────────
    private void RefreshData()
    {
        if (Pageable || _activeGroups.Count > 0) _ = LoadPageAsync();
        else _ = _virtualizeRef?.RefreshDataAsync();
        if (HasSummaryColumns) _ = RefreshSummaryDataAsync();
    }

    private async ValueTask<ItemsProviderResult<TItem>> LoadServerRowsAsync(ItemsProviderRequest request)
    {
        if (DataProvider is null) return new([], 0);
        _isLoading = true;
        StateHasChanged();
        try
        {
            var result = await DataProvider.GetDataAsync(new GridRequest(
                new PageDescriptor(request.StartIndex, request.Count),
                _state.Sort, _state.Filters, _state.SearchTerm), request.CancellationToken);

            _totalCount = result.TotalCount;
            _hasData = true;
            _isLoading = false;
            StateHasChanged();
            return new(result.Items, result.TotalCount);
        }
        catch (OperationCanceledException)
        {
            _isLoading = false;
            return new([], _totalCount);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && (Pageable || _activeGroups.Count > 0) && DataProvider is not null && !_hasData)
            await LoadPageAsync();
        if (firstRender && HasSummaryColumns && DataProvider is not null)
            await RefreshSummaryDataAsync();
    }

    private async Task LoadPageAsync()
    {
        if (DataProvider is null) return;
        _hasData = true;
        _isLoading = true;
        StateHasChanged();
        try
        {
            if (_activeGroups.Count > 0)
            {
                var result = await DataProvider.GetDataAsync(new GridRequest(
                    new PageDescriptor(0, 10_000),
                    _state.Sort, _state.Filters, _state.SearchTerm));
                _allItems = result.Items.ToList();
                _totalCount = result.TotalCount;
                RebuildGroupDisplay();
            }
            else
            {
                var result = await DataProvider.GetDataAsync(new GridRequest(
                    new PageDescriptor(_currentPage * PageSize, PageSize),
                    _state.Sort, _state.Filters, _state.SearchTerm));
                _totalCount = result.TotalCount;
                _lastPage = _totalCount > 0 ? (_totalCount - 1) / PageSize : 0;
                _displayRows.Clear();
                foreach (var item in result.Items) _displayRows.Add(DisplayItem.FromData(item));
                SyncAllSelectedState();
            }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GoToPage(int page)
    {
        _currentPage = Math.Clamp(page, 0, _lastPage);
        await LoadPageAsync();
    }

    public Task RefreshAsync()
    {
        _hasData = false;
        _currentPage = 0;
        if (Pageable || _activeGroups.Count > 0) return LoadPageAsync();
        _ = _virtualizeRef?.RefreshDataAsync();
        return Task.CompletedTask;
    }

    // ── Export ────────────────────────────────────────────────────────────
    private void ExportExcel() { _showExportMenu = false; _ = ExportData(ExportFormat.Excel); }
    private void ExportCsv()   { _showExportMenu = false; _ = ExportData(ExportFormat.Csv); }
    private void ExportJson()  { _showExportMenu = false; _ = ExportData(ExportFormat.Json); }

    private enum ExportFormat { Excel, Csv, Json }

    private async Task ExportData(ExportFormat format)
    {
        if (DataProvider is null) return;
        var result = await DataProvider.GetDataAsync(new GridRequest(
            new PageDescriptor(0, int.MaxValue),
            _state.Sort, _state.Filters, _state.SearchTerm));

        var colDefs = VisibleColumns.Select(c => new ColumnDefinition(
            c.Title, item => c.GetValue((TItem)item!)));

        var (data, fmt) = format switch
        {
            ExportFormat.Csv  => (GridExporter.ExportToCsv(result.Items, colDefs), "csv"),
            ExportFormat.Json => (GridExporter.ExportToJson(result.Items, colDefs), "json"),
            _                 => (GridExporter.ExportToExcel(result.Items, colDefs), "xlsx")
        };

        await OnExported.InvokeAsync((data, fmt));
    }
}
