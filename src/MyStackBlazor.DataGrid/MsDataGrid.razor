    private string _columnTemplate
    {
        get
        {
            var parts = new List<string>();
            if (DetailTemplate is not null) parts.Add("40px");
            if (SelectionMode == SelectionMode.Multiple) parts.Add("40px");
            parts.AddRange(VisibleColumns.Select(c => c.Width ?? "1fr"));
            if (_commandColumn is not null || EditMode == EditMode.Row)
                parts.Add(_commandColumn?.Width ?? "150px");
            return parts.Count > 0 ? string.Join(" ", parts) : "1fr";
        }
    }

    private IEnumerable<int> PageNumbers
    {
        get
        {
            const int window = 2;
            var start = Math.Max(0, _currentPage - window);
            var end = Math.Min(_lastPage, _currentPage + window);
            for (var p = start; p <= end; p++) yield return p;
        }
    }

