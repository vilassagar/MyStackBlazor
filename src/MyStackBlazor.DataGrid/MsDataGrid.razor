    // ── Selection ─────────────────────────────────────────────────────────
    private bool IsSelected(TItem row) =>
        SelectionMode == SelectionMode.Multiple
            ? _selectedItems.Contains(row)
            : EqualityComparer<TItem>.Default.Equals(row, SelectedItem);

    private void ToggleItemSelection(TItem row)
    {
        if (!_selectedItems.Remove(row)) _selectedItems.Add(row);
        SyncAllSelectedState();
        _ = SelectedItemsChanged.InvokeAsync([.. _selectedItems]);
        StateHasChanged();
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        _allSelected = (bool)(e.Value ?? false);
        var dataRows = _displayRows.Where(r => !r.IsGroup).Select(r => r.Data!);
        if (_allSelected) foreach (var row in dataRows) _selectedItems.Add(row);
        else _selectedItems.Clear();
        _ = SelectedItemsChanged.InvokeAsync([.. _selectedItems]);
        StateHasChanged();
    }

    private void SyncAllSelectedState()
    {
        var dataRows = _displayRows.Where(r => !r.IsGroup).Select(r => r.Data!).ToList();
        _allSelected = dataRows.Count > 0 && dataRows.All(r => _selectedItems.Contains(r));
    }

