    private void MenuSortAsc(string field)  { ApplyMenuSort(field, false); _filterMenuField = null; }
    private void MenuSortDesc(string field) { ApplyMenuSort(field, true);  _filterMenuField = null; }
    private void MenuRemoveSort(string field) { RemoveSort(field); _filterMenuField = null; }

    private void ApplyMenuSort(string field, bool descending)
    {
        var dir = descending ? SortDirection.Descending : SortDirection.Ascending;
        var updated = _state.Sort.Where(s => s.Field != field).Append(new SortDescriptor(field, dir)).ToList();
        _state = _state.WithSort(updated);
        RefreshData();
    }

    private void RemoveSort(string field)
    {
        _state = _state.WithSort(_state.Sort.Where(s => s.Field != field).ToList());
        RefreshData();
    }

