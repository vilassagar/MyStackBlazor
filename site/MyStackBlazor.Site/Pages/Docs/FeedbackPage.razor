@page "/docs/feedback"
@inject ToastService Toast

<PageTitle>Feedback — MyStackBlazor Docs</PageTitle>

<h1 class="text-3xl font-bold mb-1">Feedback</h1>
<p class="text-muted-foreground mb-8">Alert banners, progress bars, dialogs, and toast notifications.</p>

<!-- Alert -->
<CodeSample Title="Alert" Description="Use Variant to control severity. Supports Icon, AlertTitle, and AlertDescription slots." Code="@_alertCode">
    <div class="w-full space-y-3">
        <StackAlert>
            <StackAlertTitle>Information</StackAlertTitle>
            <StackAlertDescription>This is a default informational alert message.</StackAlertDescription>
        </StackAlert>
        <StackAlert Variant="destructive">
            <StackAlertTitle>Error</StackAlertTitle>
            <StackAlertDescription>Something went wrong. Please try again later.</StackAlertDescription>
        </StackAlert>
    </div>
</CodeSample>

<!-- Progress -->
<CodeSample Title="Progress" Description="Controlled via Value (0–Max). Max defaults to 100." Code="@_progressCode">
    <div class="w-full max-w-sm space-y-4">
        <div>
            <p class="text-sm font-medium mb-1">Upload progress</p>
            <StackProgress Value="@_progress" />
            <p class="text-xs text-muted-foreground mt-1">@_progress%</p>
        </div>
        <div class="demo-row">
            <StackButton Size="sm" Variant="outline" OnClick="DecProgress">-10</StackButton>
            <StackButton Size="sm" Variant="outline" OnClick="IncProgress">+10</StackButton>
            <StackButton Size="sm" OnClick="SimulateUpload" IsLoading="_uploading">
                @(_uploading ? "Uploading..." : "Simulate Upload")
            </StackButton>
        </div>
    </div>
</CodeSample>

<!-- Dialog -->
<CodeSample Title="Dialog" Description="Controlled by IsOpen / IsOpenChanged. CloseOnBackdropClick defaults to true." Code="@_dialogCode">
    <StackButton OnClick="@(_ => _dialogOpen = true)">Open Dialog</StackButton>
    <StackButton Variant="outline" OnClick="@(_ => _confirmOpen = true)">Confirm Action</StackButton>

    <StackDialog @bind-IsOpen="_dialogOpen">
        <StackDialogHeader>
            <StackDialogTitle>Edit Profile</StackDialogTitle>
        </StackDialogHeader>
        <div class="space-y-4 py-2">
            <div>
                <label class="text-sm font-medium mb-1 block" for="dlg-name">Display name</label>
                <StackInput Id="dlg-name" Placeholder="Vilas Sagar" @bind-Value="_profileName" />
            </div>
            <div>
                <label class="text-sm font-medium mb-1 block" for="dlg-bio">Bio</label>
                <StackTextarea Id="dlg-bio" Placeholder="Tell us about yourself..." @bind-Value="_profileBio" Rows="3" />
            </div>
        </div>
        <StackDialogFooter>
            <div class="demo-row justify-end w-full">
                <StackButton Variant="outline" OnClick="@(_ => _dialogOpen = false)">Cancel</StackButton>
                <StackButton OnClick="SaveProfile">Save changes</StackButton>
            </div>
        </StackDialogFooter>
    </StackDialog>

    <StackAlertDialog @bind-IsOpen="_confirmOpen"
                 Title="Delete item?"
                 Description="This action cannot be undone. This will permanently delete the item from our servers."
                 ConfirmText="Delete"
                 OnConfirm="ConfirmDelete"
                 OnCancel="@(() => _confirmOpen = false)" />
</CodeSample>

<!-- Toast -->
<CodeSample Title="Toast Notifications" Description="Use ToastService (injected) to fire toasts from anywhere. Toaster must be in your layout." Code="@_toastCode">
    <StackButton OnClick="@(_ => Toast.Show("Changes saved successfully.", "Saved!", "success"))">
        Success Toast
    </StackButton>
    <StackButton Variant="destructive" OnClick="@(_ => Toast.Show("Something went wrong.", "Error", "destructive"))">
        Error Toast
    </StackButton>
    <StackButton Variant="outline" OnClick="@(_ => Toast.Show("Update available.", "Info"))">
        Default Toast
    </StackButton>
</CodeSample>

@code {
    private double _progress = 40;
    private bool _uploading;
    private bool _dialogOpen;
    private bool _confirmOpen;
    private string? _profileName;
    private string? _profileBio;

    private void IncProgress() => _progress = Math.Min(100, _progress + 10);
    private void DecProgress() => _progress = Math.Max(0, _progress - 10);

    private async Task SimulateUpload()
    {
        _uploading = true;
        _progress = 0;
        for (var i = 0; i <= 10; i++)
        {
            _progress = i * 10;
            StateHasChanged();
            await Task.Delay(150);
        }
        _uploading = false;
        Toast.Show("Upload complete!", "Done", "success");
    }

    private void SaveProfile()
    {
        _dialogOpen = false;
        Toast.Show("Profile updated.", "Saved", "success");
    }

    private void ConfirmDelete()
    {
        _confirmOpen = false;
        Toast.Show("Item deleted.", "Deleted", "destructive");
    }

    private const string _alertCode = """
        <StackAlert>
            <StackAlertTitle>Information</StackAlertTitle>
            <StackAlertDescription>This is an informational alert.</StackAlertDescription>
        </StackAlert>
        <StackAlert Variant="destructive">
            <StackAlertTitle>Error</StackAlertTitle>
            <StackAlertDescription>Something went wrong.</StackAlertDescription>
        </StackAlert>
        """;

    private const string _progressCode = """
        <StackProgress Value="@_progress" />
        <StackProgress Value="75" Max="100" />
        """;

    private const string _dialogCode = """
        <StackButton OnClick="@(_ => _dialogOpen = true)">Open Dialog</StackButton>

        <StackDialog @bind-IsOpen="_dialogOpen">
            <StackDialogHeader><StackDialogTitle>Edit Profile</StackDialogTitle></StackDialogHeader>
            <StackInput Placeholder="Name" @bind-Value="_name" />
            <StackDialogFooter>
                <StackButton OnClick="@(_ => _dialogOpen = false)">Cancel</StackButton>
                <StackButton OnClick="Save">Save</StackButton>
            </StackDialogFooter>
        </StackDialog>
        """;

    private const string _toastCode = """
        @inject ToastService Toast

        <StackButton OnClick="@(_ => Toast.Show("Saved!", "success", "Done"))">
            Show Toast
        </StackButton>
        """;
}
