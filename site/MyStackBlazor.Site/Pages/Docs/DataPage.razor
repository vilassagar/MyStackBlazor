@page "/docs/data"

<PageTitle>Data &amp; Charts — MyStackBlazor Docs</PageTitle>

<h1 class="text-3xl font-bold mb-1">Data Controls</h1>
<p class="text-muted-foreground mb-8">Table, DataTable, ListView, TreeView, VirtualList, Charts, and MsDataGrid.</p>

<!-- Static Table -->
<CodeSample Title="Table"
             Description="Composable table primitives. Use TableHeader, TableBody, TableRow, TableHead, TableCell."
             Code="@_tableCode">
    <div class="w-full overflow-x-auto">
        <StackTable>
            <StackTableHeader>
                <StackTableRow>
                    <StackTableHead>Name</StackTableHead>
                    <StackTableHead>Role</StackTableHead>
                    <StackTableHead>Status</StackTableHead>
                    <StackTableHead Class="text-right">Joined</StackTableHead>
                </StackTableRow>
            </StackTableHeader>
            <StackTableBody>
                @foreach (var p in _people)
                {
                    <StackTableRow>
                        <StackTableCell Class="font-medium">@p.Name</StackTableCell>
                        <StackTableCell>@p.Role</StackTableCell>
                        <StackTableCell>
                            <StackBadge Variant="@(p.Active ? "default" : "secondary")">
                                @(p.Active ? "Active" : "Inactive")
                            </StackBadge>
                        </StackTableCell>
                        <StackTableCell Class="text-right text-muted-foreground">@p.Joined.ToString("MMM yyyy")</StackTableCell>
                    </StackTableRow>
                }
            </StackTableBody>
        </StackTable>
    </div>
</CodeSample>

<!-- DataTable — search + sort + filter + pagination -->
<CodeSample Title="DataTable"
             Description="Built-in search, column sort, per-column filter, and pagination. Pass ShowSearch, ShowPagination, PageSize."
             Code="@_dataTableCode">
    <div class="w-full">
        <StackDataTable TItem="Person"
                   Items="_people"
                   PageSize="4"
                   Columns="_columns" />
    </div>
</CodeSample>

<!-- ListView -->
<CodeSample Title="ListView"
             Description="Generic list with ItemTemplate, selection highlight, and click callback."
             Code="@_listViewCode">
    <div class="w-full max-w-sm">
        <StackListView TItem="Person"
                  Items="_people"
                  SelectedItem="_selectedPerson"
                  OnItemClick="p => _selectedPerson = p"
                  Height="220px">
            <ItemTemplate Context="person">
                <div class="flex items-center gap-3 px-4 py-3">
                    <StackAvatar Initials="@person.Initials" Size="sm" />
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium truncate">@person.Name</p>
                        <p class="text-xs text-muted-foreground truncate">@person.Role</p>
                    </div>
                    <StackBadge Variant="@(person.Active ? "default" : "secondary")" >
                        @(person.Active ? "Active" : "Inactive")
                    </StackBadge>
                </div>
            </ItemTemplate>
        </StackListView>
        @if (_selectedPerson is not null)
        {
            <p class="text-sm text-muted-foreground mt-2">
                Selected: <strong>@_selectedPerson.Name</strong> — @_selectedPerson.Role
            </p>
        }
    </div>
</CodeSample>

<!-- TreeView -->
<CodeSample Title="TreeView"
             Description="Recursive tree with expand/collapse, keyboard-accessible selection."
             Code="@_treeCode">
    <div class="w-full max-w-xs rounded-md border p-2">
        <StackTreeView TItem="TreeNode"
                  Items="_treeRoots"
                  GetChildren="n => n.Children"
                  GetLabel="n => n.Label"
                  @bind-SelectedItem="_selectedNode" />
    </div>
    @if (_selectedNode is not null)
    {
        <p class="text-sm text-muted-foreground mt-2 ml-1">
            Selected: <strong>@_selectedNode.Label</strong>
        </p>
    }
</CodeSample>

<!-- Doughnut Chart -->
<CodeSample Title="Doughnut Chart"
             Description="StackDoughnutChart wraps StackPieChart with Donut=true — same Segments / CenterLabel / legend / tooltip API as the pie chart."
             Code="@_doughnutCode">
    <div class="w-full max-w-md">
        <StackDoughnutChart Segments="_channelSegments" Title="Traffic by Channel" CenterLabel="12.4K" />
    </div>
</CodeSample>

<!-- Radar Chart -->
<CodeSample Title="Radar Chart"
             Description="StackRadarChart plots one or more ChartSeries across shared Labels (spokes). Hover a spoke's wedge to see all series values for that axis."
             Code="@_radarCode">
    <div class="w-full max-w-md">
        <StackRadarChart Series="_radarSeries" Labels="_radarLabels" Title="Team Skill Comparison" />
    </div>
</CodeSample>

<!-- Polar Area Chart -->
<CodeSample Title="Polar Area Chart"
             Description="StackPolarAreaChart uses ChartSegment like the pie/doughnut chart, but each slice keeps an equal angle and instead encodes value as radius."
             Code="@_polarAreaCode">
    <div class="w-full max-w-md">
        <StackPolarAreaChart Segments="_weekdaySegments" Title="Orders by Weekday" />
    </div>
</CodeSample>

<!-- Scatter Chart -->
<CodeSample Title="Scatter Chart"
             Description="StackScatterChart plots ChartPointSeries — each series is a list of ChartPoint(X, Y, Label) values. Hover a point for its exact coordinates."
             Code="@_scatterCode">
    <div class="w-full">
        <StackScatterChart Series="_scatterSeries" Title="Price vs. Rating" />
    </div>
</CodeSample>

<!-- Sortable List -->
<CodeSample Title="Sortable List"
             Description="StackSortableList adds HTML5 drag-and-drop reordering to any IList<T>. Drag an item and drop it on another to reorder; ItemsChanged fires with the updated list."
             Code="@_sortableListCode">
    <div class="w-full max-w-sm">
        <StackSortableList TItem="string" Items="_sortableItems" ItemsChanged="items => _sortableItems = items">
            <ItemTemplate Context="item">
                <div class="flex items-center gap-3 px-3 py-2">
                    <span class="text-muted-foreground select-none" aria-hidden="true">⠿</span>
                    <span class="text-sm">@item</span>
                </div>
            </ItemTemplate>
        </StackSortableList>
        <p class="text-xs text-muted-foreground mt-2">
            Current order: @string.Join(" → ", _sortableItems)
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: infinite-scroll virtualized server-side grid -->
<CodeSample Title="MsDataGrid — Infinite Scroll"
             Description="Virtual-scroll server-side grid: only visible rows are rendered. Click a header to sort; Shift+click a second header for multi-column sort (numbered badge shows priority). Use the Columns button to show or hide any column. Export downloads all rows as .xlsx."
             Code="@_gridCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products data grid"
                    BodyHeight="400px"
                    OverscanCount="8"
                    SelectedItem="_selectedProduct"
                    SelectedItemChanged="p => _selectedProduct = p"
                    OnExported="HandleExport">
            <MsDataGridColumn Field="Id"       Title="ID"           Width="72px"  Sortable="true" />
            <MsDataGridColumn Field="Name"     Title="Product Name"              Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Category" Title="Category"     Width="160px" Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Price"    Title="Price"        Width="110px" Sortable="true">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
            <MsDataGridColumn Field="InStock"  Title="Stock"        Width="100px" Sortable="true">
                <CellTemplate Context="p">
                    <StackBadge Variant="@(p.InStock ? "default" : "secondary")">
                        @(p.InStock ? "In Stock" : "Out")
                    </StackBadge>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        @if (_selectedProduct is not null)
        {
            <p class="mt-2 text-sm text-muted-foreground">
                Selected: <strong>@_selectedProduct.Name</strong> — @_selectedProduct.Category
            </p>
        }
        @if (_exportMessage is not null)
        {
            <p class="mt-1 text-xs text-muted-foreground">@_exportMessage</p>
        }
    </div>
</CodeSample>

<!-- MsDataGrid: Pagination -->
<CodeSample Title="MsDataGrid — Pagination"
             Description="Set Pageable=true and PageSize to switch from infinite scroll to a numbered pager. The footer shows a windowed page list with first / prev / next / last navigation."
             Code="@_gridPageCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products paged grid"
                    Pageable="true"
                    PageSize="6"
                    SelectedItem="_pagedProduct"
                    SelectedItemChanged="p => _pagedProduct = p">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px"  Sortable="true" />
            <MsDataGridColumn Field="Name"     Title="Name"                   Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Width="160px" Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Price"    Title="Price"    Width="110px" Sortable="true">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
            <MsDataGridColumn Field="InStock"  Title="Stock"    Width="100px" Sortable="true">
                <CellTemplate Context="p">
                    <StackBadge Variant="@(p.InStock ? "default" : "secondary")">
                        @(p.InStock ? "In Stock" : "Out")
                    </StackBadge>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        @if (_pagedProduct is not null)
        {
            <p class="mt-2 text-sm text-muted-foreground">
                Selected: <strong>@_pagedProduct.Name</strong>
            </p>
        }
    </div>
</CodeSample>

<!-- MsDataGrid: Multi-Row Selection -->
<CodeSample Title="MsDataGrid — Multi-Row Selection"
             Description="SelectionMode.Multiple adds a checkbox column and a select-all header checkbox. Click any row or its checkbox to toggle it. SelectedItems and SelectedItemsChanged track the full selection set."
             Code="@_gridSelectCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products multi-select grid"
                    Pageable="true"
                    PageSize="6"
                    SelectionMode="SelectionMode.Multiple"
                    SelectedItems="_multiSelected"
                    SelectedItemsChanged="items => _multiSelected = items">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px"  Sortable="true" />
            <MsDataGridColumn Field="Name"     Title="Name"                   Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Width="160px" Sortable="true" />
            <MsDataGridColumn Field="Price"    Title="Price"    Width="110px" Sortable="true">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
            <MsDataGridColumn Field="InStock"  Title="Stock"    Width="100px" Sortable="true">
                <CellTemplate Context="p">
                    <StackBadge Variant="@(p.InStock ? "default" : "secondary")">
                        @(p.InStock ? "In Stock" : "Out")
                    </StackBadge>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        <p class="mt-2 text-sm text-muted-foreground">
            @if (_multiSelected.Count > 0)
            {
                <span><strong>@_multiSelected.Count</strong> row(s) selected —
                    @string.Join(", ", _multiSelected.Take(3).Select(p => p.Name))
                    @(_multiSelected.Count > 3 ? $" +{_multiSelected.Count - 3} more" : "")
                </span>
            }
            else
            {
                <span>Click rows or checkboxes to select. Use the header checkbox to select/deselect the page.</span>
            }
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: Command Column -->
<CodeSample Title="MsDataGrid — Command Column"
             Description="MsDataGridCommandColumn appends an actions cell to every row. Built-in EditLabel / DeleteLabel buttons fire OnEdit / OnDelete callbacks. Swap in CustomButtons for fully custom actions."
             Code="@_gridCmdCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products command grid"
                    Pageable="true"
                    PageSize="6">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px"  Sortable="true" />
            <MsDataGridColumn Field="Name"     Title="Name"                   Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Width="160px" Sortable="true" />
            <MsDataGridColumn Field="Price"    Title="Price"    Width="110px" Sortable="true">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
            <MsDataGridCommandColumn Title="Actions"
                                     EditLabel="Edit"
                                     DeleteLabel="Delete"
                                     OnEdit="_onEditProduct"
                                     OnDelete="_onDeleteProduct" />
        </MsDataGrid>
        <p class="mt-2 text-sm text-muted-foreground min-h-[1.5rem]">
            @if (_lastAction is not null)
            {
                <span>Last action: <strong>@_lastAction</strong></span>
            }
            else
            {
                <span>Click Edit or Delete on any row.</span>
            }
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: Conditional Formatting + Column Chooser -->
<CodeSample Title="MsDataGrid — Conditional Formatting &amp; Column Chooser"
             Description="CellStyleFunc returns an inline style string per row (e.g. red text for high prices). CellClassFunc returns extra CSS classes. The Columns toolbar button opens a dropdown to toggle any column; columns marked Visible=false start hidden."
             Code="@_gridFmtCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products formatting grid"
                    Pageable="true"
                    PageSize="7">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px"  Sortable="true" />
            <MsDataGridColumn Field="Name"     Title="Name"                   Sortable="true" Filterable="true"
                              Tooltip="Product display name" />
            <MsDataGridColumn Field="Category" Title="Category" Width="160px" Sortable="true" Filterable="true" />
            @* Price: red + bold when > $400, monospaced otherwise *@
            <MsDataGridColumn Field="Price"    Title="Price"    Width="120px" Sortable="true"
                              CellStyleFunc="_priceStyle"
                              CellClassFunc="_priceClass">
                <CellTemplate Context="p">
                    @p.Price.ToString("C")
                </CellTemplate>
            </MsDataGridColumn>
            @* Stock: green text when in stock, muted when out *@
            <MsDataGridColumn Field="InStock"  Title="Stock"    Width="100px" Sortable="true"
                              CellClassFunc="_stockClass">
                <CellTemplate Context="p">
                    <StackBadge Variant="@(p.InStock ? "default" : "secondary")">
                        @(p.InStock ? "In Stock" : "Out")
                    </StackBadge>
                </CellTemplate>
            </MsDataGridColumn>
            @* Hidden by default — visible via Columns button *@
            <MsDataGridColumn Field="Id"       Title="SKU (hidden by default)" Width="160px"
                              Sortable="false" Visible="false" />
        </MsDataGrid>
        <p class="mt-2 text-xs text-muted-foreground">
            Prices above $400 are highlighted. Click <strong>Columns</strong> in the toolbar — "SKU (hidden by default)" starts unchecked.
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: Grouping -->
<CodeSample Title="MsDataGrid — Grouping"
             Description="ShowGroupPanel reveals a drag-target bar above the header. Click the ≡ icon on any Groupable column header to group by it. Group rows show the value, item count, and a ▶/▼ toggle to collapse/expand."
             Code="@_gridGroupCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products grouping grid"
                    ShowGroupPanel="true"
                    ShowFilterRow="false"
                    Pageable="true"
                    PageSize="50">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px"  Sortable="true" />
            <MsDataGridColumn Field="Name"     Title="Name"                   Sortable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Width="160px" Sortable="true" Groupable="true" />
            <MsDataGridColumn Field="Price"    Title="Price"    Width="110px" Sortable="true">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
            <MsDataGridColumn Field="InStock"  Title="Stock"    Width="100px" Sortable="true" Groupable="true">
                <CellTemplate Context="p">
                    <StackBadge Variant="@(p.InStock ? "default" : "secondary")">
                        @(p.InStock ? "In Stock" : "Out")
                    </StackBadge>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        <p class="mt-2 text-xs text-muted-foreground">
            Click <strong>≡</strong> on the Category or Stock header to group. Click a group row to collapse/expand it.
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: Filter Menu -->
<CodeSample Title="MsDataGrid — Filter Menu"
             Description="When Filterable=true on a column the header shows a funnel icon. Clicking it opens a per-column panel with Sort A→Z / Sort Z→A shortcuts and a filter form. Pick an operator (Contains, Equals, Starts with, Greater than…) and type a value to filter without leaving the header."
             Code="@_gridFilterMenuCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products filter menu grid"
                    ShowFilterRow="false"
                    Pageable="true"
                    PageSize="8">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px"  Sortable="true" />
            <MsDataGridColumn Field="Name"     Title="Name"                   Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Width="160px" Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Price"    Title="Price"    Width="110px" Sortable="true" Filterable="true"
                              EditorType="EditorType.Number">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
            <MsDataGridColumn Field="InStock"  Title="Stock"    Width="100px" Sortable="true">
                <CellTemplate Context="p">
                    <StackBadge Variant="@(p.InStock ? "default" : "secondary")">
                        @(p.InStock ? "In Stock" : "Out")
                    </StackBadge>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        <p class="mt-2 text-xs text-muted-foreground">
            Click the funnel icon on Name, Category, or Price. Active filters are shown with a highlighted icon.
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: Row Editing -->
<CodeSample Title="MsDataGrid — Row Editing"
             Description="EditMode.Row puts Save / Cancel buttons in each row's action cell. Click Edit to enter edit mode for that row; editable cells become inputs. ValueSetter is called on save to write the string value back to your model. NewRowFactory + Add Row inserts a blank row at the top."
             Code="@_gridRowEditCode">
    <div class="w-full">
        <MsDataGrid TItem="EditableProduct"
                    DataProvider="_editProvider"
                    AriaLabel="Row edit grid"
                    EditMode="EditMode.Row"
                    NewRowFactory="_newEditableProduct"
                    OnRowSaved="_onEditableSaved"
                    OnRowAdded="_onEditableAdded"
                    Pageable="true"
                    PageSize="6">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px" />
            <MsDataGridColumn Field="Name"     Title="Name"     Editable="true" ValueSetter="_setName"     Sortable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Editable="true" ValueSetter="_setCategory" Width="160px" />
            <MsDataGridColumn Field="Price"    Title="Price"    Editable="true" ValueSetter="_setPrice"
                              EditorType="EditorType.Number" Width="110px">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        <p class="mt-2 text-sm text-muted-foreground min-h-[1.5rem]">
            @if (_editMessage is not null)
            { <span>@_editMessage</span> }
            else
            { <span>Click Edit on any row, or Add Row to insert a new entry.</span> }
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: Cell Editing -->
<CodeSample Title="MsDataGrid — Cell Editing"
             Description="EditMode.Cell lets users click any editable cell to edit it directly in place. The cell switches to an input; press Enter or click away to commit, Escape to cancel."
             Code="@_gridCellEditCode">
    <div class="w-full">
        <MsDataGrid TItem="EditableProduct"
                    DataProvider="_cellEditProvider"
                    AriaLabel="Cell edit grid"
                    EditMode="EditMode.Cell"
                    OnRowSaved="_onEditableSaved"
                    Pageable="true"
                    PageSize="6">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px" />
            <MsDataGridColumn Field="Name"     Title="Name"     Editable="true" ValueSetter="_setName"     Sortable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Editable="true" ValueSetter="_setCategory" Width="160px" />
            <MsDataGridColumn Field="Price"    Title="Price"    Editable="true" ValueSetter="_setPrice"
                              EditorType="EditorType.Number" Width="110px">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        <p class="mt-2 text-xs text-muted-foreground">
            Click any Name, Category, or Price cell to edit in place. Enter commits, Escape cancels.
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: Batch Editing -->
<CodeSample Title="MsDataGrid — Batch Editing"
             Description="EditMode.Batch renders all editable cells as inputs at once. Changes are buffered until you click Save All (shows pending count) or Discard in the toolbar."
             Code="@_gridBatchEditCode">
    <div class="w-full">
        <MsDataGrid TItem="EditableProduct"
                    DataProvider="_batchProvider"
                    AriaLabel="Batch edit grid"
                    EditMode="EditMode.Batch"
                    OnRowSaved="_onEditableSaved"
                    Pageable="true"
                    PageSize="5">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px" />
            <MsDataGridColumn Field="Name"     Title="Name"     Editable="true" ValueSetter="_setName"     Sortable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Editable="true" ValueSetter="_setCategory" Width="160px" />
            <MsDataGridColumn Field="Price"    Title="Price"    Editable="true" ValueSetter="_setPrice"
                              EditorType="EditorType.Number" Width="110px">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        <p class="mt-2 text-xs text-muted-foreground">
            Edit any cells — the toolbar shows <strong>Save All (N)</strong>. Click Save All to commit or Discard to revert.
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: Export -->
<CodeSample Title="MsDataGrid — Export (Excel / CSV / JSON)"
             Description="The Export button in the toolbar opens a dropdown with Excel (.xlsx), CSV (.csv), and JSON (.json) options. OnExported receives (byte[] Data, string Format) — use it to trigger a file download. All matching rows across all pages are exported."
             Code="@_gridExportCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products export grid"
                    Pageable="true"
                    PageSize="6"
                    OnExported="_onExported">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px"  Sortable="true" />
            <MsDataGridColumn Field="Name"     Title="Name"                   Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Width="160px" Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Price"    Title="Price"    Width="110px" Sortable="true">
                <CellTemplate Context="p">
                    <span class="font-mono tabular-nums">@p.Price.ToString("C")</span>
                </CellTemplate>
            </MsDataGridColumn>
            <MsDataGridColumn Field="InStock"  Title="Stock"    Width="100px" Sortable="true">
                <CellTemplate Context="p">
                    <StackBadge Variant="@(p.InStock ? "default" : "secondary")">
                        @(p.InStock ? "In Stock" : "Out")
                    </StackBadge>
                </CellTemplate>
            </MsDataGridColumn>
        </MsDataGrid>
        <p class="mt-2 text-sm text-muted-foreground min-h-[1.5rem]">
            @if (_exportMessage is not null)
            { <span>@_exportMessage</span> }
            else
            { <span>Click the Export button and choose a format.</span> }
        </p>
    </div>
</CodeSample>

<!-- MsDataGrid: Detail Row, Frozen Column & Summary Footer -->
<CodeSample Title="MsDataGrid — Detail Row, Frozen Column &amp; Summary Footer"
             Description="DetailTemplate adds an expand chevron per row; click it to reveal extra content in a full-width row below (nest a child MsDataGrid inside DetailTemplate to build master-detail grids). Frozen=&quot;FreezePosition.Left&quot; pins the ID column while the body scrolls horizontally. Setting SummaryFunc on the Price column renders an aggregate footer row."
             Code="@_gridDetailCode">
    <div class="w-full">
        <MsDataGrid TItem="Product"
                    DataProvider="_productProvider"
                    AriaLabel="Products detail grid"
                    Pageable="true"
                    PageSize="6"
                    DetailTemplate="_productDetail">
            <MsDataGridColumn Field="Id"       Title="ID"       Width="72px"  Sortable="true" Frozen="FreezePosition.Left" />
            <MsDataGridColumn Field="Name"     Title="Name"                   Sortable="true" Filterable="true" />
