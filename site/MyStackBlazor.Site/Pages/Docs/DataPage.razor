    private const string _gridExportCode = """
        // Export button in toolbar opens Excel / CSV / JSON dropdown.
        // OnExported receives (byte[] Data, string Format) for all matching rows.
        // Use JSInterop or a download helper to trigger a browser file download.

        @inject IJSRuntime JS

        <MsDataGrid TItem="Product" DataProvider="_provider"
                    OnExported="HandleExport" Pageable="true" PageSize="6">
            <MsDataGridColumn Field="Name"     Title="Name"     Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Category" Title="Category" Sortable="true" Filterable="true" />
            <MsDataGridColumn Field="Price"    Title="Price"    Sortable="true" />
        </MsDataGrid>

        @code {
            async Task HandleExport((byte[] Data, string Format) export)
            {
                var base64 = Convert.ToBase64String(export.Data);
                await JS.InvokeVoidAsync("downloadFile", $"export.{export.Format}", base64);
            }
        }
        """;

