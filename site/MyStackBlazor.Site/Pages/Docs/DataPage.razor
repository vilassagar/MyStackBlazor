    private const string _gridDetailCode = """
        // DetailTemplate adds an expand chevron; click it to render the fragment below the row.
        // Frozen pins a column while the body scrolls horizontally.
        // SummaryFunc computes an aggregate footer cell from the full filtered/sorted dataset.

        @code {
            RenderFragment<Product> productDetail = p =>
                @<div class="px-6 py-4 text-sm">
                    @p.Name — @p.Category — @p.Price.ToString("C")
                    @* Nest a child <MsDataGrid> here for a real master-detail grid *@
                </div>;

            Func<IEnumerable<Product>, string> priceSummary = items => $"Total: {items.Sum(p => p.Price):C}";
        }

        <MsDataGrid TItem="Product" DataProvider="_provider"
                    Pageable="true" PageSize="6" DetailTemplate="productDetail">
            <MsDataGridColumn Field="Id"    Title="ID"    Width="72px" Frozen="FreezePosition.Left" />
            <MsDataGridColumn Field="Name"  Title="Name"  Sortable="true" />
            <MsDataGridColumn Field="Price" Title="Price" Sortable="true" SummaryFunc="priceSummary" />
        </MsDataGrid>
        """;

