@page "/docs/common"

<PageTitle>Buttons &amp; Badges — MyStackBlazor Docs</PageTitle>

<h1 class="text-3xl font-bold mb-1">Buttons &amp; Badges</h1>
<p class="text-muted-foreground mb-8">Core UI atoms: buttons, badges, chips, avatars, and loading indicators.</p>

<!-- Button Variants -->
<CodeSample Title="Button Variants"
             Description="Use Variant to control the visual style."
             Code="@_btnVariants">
    <StackButton Variant="default">Default</StackButton>
    <StackButton Variant="secondary">Secondary</StackButton>
    <StackButton Variant="outline">Outline</StackButton>
    <StackButton Variant="destructive">Destructive</StackButton>
    <StackButton Variant="ghost">Ghost</StackButton>
    <StackButton Variant="link">Link</StackButton>
</CodeSample>

<!-- Button Sizes -->
<CodeSample Title="Button Sizes"
             Description="Use Size to control the button dimensions."
             Code="@_btnSizes">
    <StackButton Size="sm">Small</StackButton>
    <StackButton Size="default">Default</StackButton>
    <StackButton Size="lg">Large</StackButton>
    <StackButton Size="icon" AriaLabel="Settings">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
    </StackButton>
</CodeSample>

<!-- Loading & Disabled -->
<CodeSample Title="Loading &amp; Disabled States" Code="@_btnStates">
    <StackButton IsLoading="_loading" OnClick="SimulateLoad">
        @(_loading ? "Saving..." : "Save Changes")
    </StackButton>
    <StackButton Variant="outline" Disabled>Disabled</StackButton>
    <StackButton Variant="secondary" IsLoading>Always Loading</StackButton>
</CodeSample>

<!-- Badge Variants -->
<CodeSample Title="Badge Variants" Code="@_badges">
    <StackBadge>Default</StackBadge>
    <StackBadge Variant="secondary">Secondary</StackBadge>
    <StackBadge Variant="destructive">Destructive</StackBadge>
    <StackBadge Variant="outline">Outline</StackBadge>
</CodeSample>

<!-- Chips -->
<CodeSample Title="Chips" Description="Use OnRemove to make chips removable." Code="@_chips">
    @foreach (var tag in _tags)
    {
        <StackChip OnRemove="@(() => RemoveTag(tag))" RemoveLabel="@($"Remove {tag}")">@tag</StackChip>
    }
    <StackChip Variant="secondary">React</StackChip>
    <StackChip Variant="success">Success</StackChip>
    <StackChip Variant="warning">Warning</StackChip>
    <StackChip Variant="outline">Outline</StackChip>
    @if (_tags.Count == 0)
    {
        <span class="text-xs text-muted-foreground">All tags removed — refresh to reset.</span>
    }
</CodeSample>

<!-- Avatar -->
<CodeSample Title="Avatar" Description="Shows initials as fallback when no image source is set." Code="@_avatars">
    <StackAvatar Initials="VS" Size="xs" />
    <StackAvatar Initials="AB" Size="sm" />
    <StackAvatar Initials="CD" />
    <StackAvatar Initials="EF" Size="lg" />
    <StackAvatar Initials="GH" Size="xl" />
    <StackAvatar />
</CodeSample>

<!-- Spinner -->
<CodeSample Title="Spinner" Description="Use for loading states. Size mirrors button sizes." Code="@_spinners">
    <StackSpinner Size="xs" />
    <StackSpinner Size="sm" />
    <StackSpinner />
    <StackSpinner Size="lg" />
    <StackSpinner Size="xl" />
</CodeSample>

<!-- Skeleton -->
<CodeSample Title="Skeleton" Description="Pulse placeholder while content loads." Code="@_skeleton">
    <div class="w-full space-y-3">
        <div class="flex items-center gap-3">
            <StackSkeleton Class="h-10 w-10 rounded-full" />
            <div class="flex-1 space-y-2">
                <StackSkeleton Class="h-4 w-1/3" />
                <StackSkeleton Class="h-3 w-1/2" />
            </div>
        </div>
        <StackSkeleton Class="h-4 w-full" />
        <StackSkeleton Class="h-4 w-4/5" />
        <StackSkeleton Class="h-4 w-2/3" />
    </div>
</CodeSample>

<!-- Typography -->
<CodeSample Title="Typography"
             Description="Semantic text elements. Use Variant to switch between h1–h6, p, lead, large, small, muted, blockquote, and code."
             Code="@_typographyCode">
    <div class="w-full space-y-2">
        <StackTypography Variant="h1">Heading 1</StackTypography>
        <StackTypography Variant="h2">Heading 2</StackTypography>
        <StackTypography Variant="h3">Heading 3</StackTypography>
        <StackTypography Variant="h4">Heading 4</StackTypography>
        <StackTypography Variant="lead">Lead paragraph — larger introductory text.</StackTypography>
        <StackTypography Variant="p">Body paragraph — the default text style for content.</StackTypography>
        <StackTypography Variant="large">Large text</StackTypography>
        <StackTypography Variant="small">Small text</StackTypography>
        <StackTypography Variant="muted">Muted / secondary text</StackTypography>
        <StackTypography Variant="blockquote">"Great components are composed, not configured." — someone wise</StackTypography>
        <StackTypography Variant="code">npm install mystack-blazor</StackTypography>
    </div>
</CodeSample>

<!-- Label -->
<CodeSample Title="Label"
             Description="Associates with an input via For. Styled to match the design system."
             Code="@_labelCode">
    <div class="w-full max-w-xs space-y-1">
        <StackLabel For="lbl-demo">Your email address</StackLabel>
        <StackInput Id="lbl-demo" Type="email" Placeholder="you@example.com" />
    </div>
</CodeSample>

<!-- ButtonGroup -->
<CodeSample Title="Button Group"
             Description="Groups related buttons together, removing gaps between them."
             Code="@_btnGroupCode">
    <div class="space-y-3">
        <StackButtonGroup>
            <StackButton Variant="outline" Size="sm">Left</StackButton>
            <StackButton Variant="outline" Size="sm">Center</StackButton>
            <StackButton Variant="outline" Size="sm">Right</StackButton>
        </StackButtonGroup>
        <StackButtonGroup>
            <StackButton Size="sm">Save</StackButton>
            <StackButton Variant="outline" Size="sm">Preview</StackButton>
            <StackButton Variant="outline" Size="sm">Discard</StackButton>
        </StackButtonGroup>
    </div>
</CodeSample>

<!-- ToggleButton -->
<CodeSample Title="Toggle Button"
             Description="Stateful button that tracks a pressed/active state via IsPressed / IsPressedChanged."
             Code="@_toggleCode">
    <div class="flex flex-wrap gap-3">
        <StackToggleButton @bind-IsPressed="_boldOn">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 4h8a4 4 0 010 8H6zM6 12h9a4 4 0 010 8H6z" />
            </svg>
            Bold
        </StackToggleButton>
        <StackToggleButton @bind-IsPressed="_italicOn">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 4h-9M14 20H5M15 4L9 20" />
            </svg>
            Italic
        </StackToggleButton>
        <StackToggleButton @bind-IsPressed="_underlineOn">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v8a5 5 0 0010 0V4M5 20h14" />
            </svg>
            Underline
        </StackToggleButton>
        <p class="text-sm text-muted-foreground w-full">
            Active: @(string.Join(", ", new[] {
                _boldOn ? "Bold" : null,
                _italicOn ? "Italic" : null,
                _underlineOn ? "Underline" : null
            }.Where(x => x is not null)) is "" ? "none" : string.Join(", ", new[] {
                _boldOn ? "Bold" : null,
                _italicOn ? "Italic" : null,
                _underlineOn ? "Underline" : null
            }.Where(x => x is not null)))
        </p>
    </div>
</CodeSample>

<!-- Kbd -->
<CodeSample Title="Kbd"
             Description="Displays keyboard shortcuts using the semantic &lt;kbd&gt; element. Use Size for sm / md / lg."
             Code="@_kbdCode">
    <div class="flex flex-wrap items-center gap-4">
        <div class="space-y-2">
            <p class="text-xs text-muted-foreground font-medium">Small</p>
            <div class="flex gap-1">
                <StackKbd Size="sm">⌘</StackKbd>
                <StackKbd Size="sm">K</StackKbd>
            </div>
        </div>
        <div class="space-y-2">
            <p class="text-xs text-muted-foreground font-medium">Medium</p>
            <div class="flex gap-1">
                <StackKbd>Ctrl</StackKbd>
                <StackKbd>Shift</StackKbd>
                <StackKbd>P</StackKbd>
            </div>
        </div>
        <div class="space-y-2">
            <p class="text-xs text-muted-foreground font-medium">Large</p>
            <div class="flex gap-1">
                <StackKbd Size="lg">Alt</StackKbd>
                <StackKbd Size="lg">F4</StackKbd>
            </div>
        </div>
    </div>
</CodeSample>

<!-- Empty -->
<CodeSample Title="Empty"
             Description="Empty-state placeholder with icon, title, description, and optional action. Use Size for sm / md / lg."
             Code="@_emptyCode">
    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="rounded-lg border border-border">
            <StackEmpty Size="sm" Title="Nothing here" Description="No items found." />
        </div>
        <div class="rounded-lg border border-border">
            <StackEmpty Title="No results found"
                   Description="Try adjusting your search or filters.">
                <Action>
                    <StackButton Size="sm" Variant="outline">Reset filters</StackButton>
                </Action>
            </StackEmpty>
        </div>
        <div class="rounded-lg border border-border">
            <StackEmpty Size="lg" Title="No data yet" Description="Start by creating your first record." />
        </div>
    </div>
</CodeSample>

<!-- Direction -->
<CodeSample Title="Direction"
             Description="Sets the text direction (LTR/RTL) on a container. Useful for internationalization."
             Code="@_dirCode">
    <div class="w-full space-y-4">
        <div class="rounded-lg border border-border p-4">
            <p class="text-xs text-muted-foreground mb-2 font-medium">LTR (default)</p>
            <StackDirection Dir="ltr">
                <p class="text-sm">Left-to-right text layout. English, French, Spanish etc.</p>
            </StackDirection>
        </div>
        <div class="rounded-lg border border-border p-4">
            <p class="text-xs text-muted-foreground mb-2 font-medium">RTL</p>
            <StackDirection Dir="rtl">
                <p class="text-sm">مرحبًا بالعالم — Right-to-left text layout for Arabic, Hebrew etc.</p>
            </StackDirection>
        </div>
    </div>
</CodeSample>

<!-- Item -->
<CodeSample Title="Item"
             Description="Generic styled list or menu item with optional icon and keyboard shortcut. Use Size for sm / md / lg."
             Code="@_itemCode">
    <div class="w-full max-w-sm space-y-4">
        <div class="rounded-md border border-border p-1 space-y-0.5">
            <p class="px-3 py-1 text-xs text-muted-foreground font-medium">Small items</p>
            <StackItem Size="sm" Shortcut="⌘N">New File</StackItem>
            <StackItem Size="sm" Shortcut="⌘O">Open...</StackItem>
            <StackItem Size="sm" Disabled>Save As (disabled)</StackItem>
        </div>
        <div class="rounded-md border border-border p-1 space-y-0.5">
            <p class="px-3 py-1.5 text-xs text-muted-foreground font-medium">Medium items (default)</p>
            <StackItem Selected>Selected item</StackItem>
            <StackItem Shortcut="⌘X">Cut</StackItem>
            <StackItem Shortcut="⌘C">Copy</StackItem>
        </div>
        <div class="rounded-md border border-border p-1 space-y-0.5">
            <p class="px-4 py-2 text-xs text-muted-foreground font-medium">Large items</p>
            <StackItem Size="lg">Dashboard</StackItem>
            <StackItem Size="lg">Settings</StackItem>
        </div>
    </div>
</CodeSample>

<!-- Callout -->
<CodeSample Title="Callout"
             Description="Inline alert/notice box. Use Variant for Info, Tip, Warning, or Danger, plus an optional Title."
             Code="@_calloutCode">
    <div class="w-full space-y-3">
        <StackCallout Variant="Info" Title="Heads up">This is an informational message with some extra context.</StackCallout>
        <StackCallout Variant="Tip">Pro tip: combine this with other components for richer notices.</StackCallout>
        <StackCallout Variant="Warning" Title="Careful">This action may have unintended side effects.</StackCallout>
        <StackCallout Variant="Danger">Something went wrong. Please try again.</StackCallout>
    </div>
</CodeSample>

<!-- Ribbon -->
<CodeSample Title="Ribbon"
             Description="Overlays a diagonal ribbon banner on top of ChildContent. Use Position for TopLeft/TopRight/BottomLeft/BottomRight and Color for the ribbon background."
             Code="@_ribbonCode">
    <div class="flex flex-wrap gap-8">
        <StackRibbon Text="New">
            <div class="h-32 w-48 rounded-lg border bg-muted"></div>
        </StackRibbon>
        <StackRibbon Text="Sale" Position="BottomLeft" Color="bg-destructive">
            <div class="h-32 w-48 rounded-lg border bg-muted"></div>
        </StackRibbon>
    </div>
</CodeSample>

<!-- Preload -->
<CodeSample Title="Preload"
             Description="Injects a resource hint (&lt;link rel=&quot;preload|prefetch|preconnect&quot;&gt;) into &lt;head&gt; via HeadContent. It has no visible output on the page — view page source or the browser dev tools Elements panel to confirm the &lt;link&gt; tag was added."
             Code="@_preloadCode">
    <div class="w-full space-y-2">
        <StackPreload Href="/js/demo-script.js" As="script" Mode="Preload" />
        <p class="text-sm text-muted-foreground">No visible output — check the page's &lt;head&gt; for a matching &lt;link rel="preload"&gt; tag.</p>
    </div>
</CodeSample>

<!-- Script Loader -->
<CodeSample Title="Script Loader"
             Description="Dynamically injects an external <script> tag on first render and raises OnLoaded once it finishes. This demo points Src at a small same-origin dummy script and flips the badge below when OnLoaded fires."
             Code="@_scriptLoaderCode">
    <div class="flex items-center gap-3">
        <StackScriptLoader Src="/js/demo-script.js" OnLoaded="OnDemoScriptLoaded" />
        @if (_scriptLoaded)
        {
            <StackBadge Variant="secondary">Loaded!</StackBadge>
        }
        else
        {
            <StackBadge Variant="outline">Loading...</StackBadge>
        }
    </div>
</CodeSample>

@code {
    private bool _loading;
    private List<string> _tags = ["Blazor", ".NET", "Tailwind"];
    private bool _boldOn;
    private bool _italicOn;
    private bool _underlineOn;

    private async Task SimulateLoad()
    {
        _loading = true;
        await Task.Delay(1500);
        _loading = false;
    }

    private void RemoveTag(string tag) => _tags.Remove(tag);

    private bool _scriptLoaded;

    private void OnDemoScriptLoaded()
    {
        _scriptLoaded = true;
        StateHasChanged();
    }

    private const string _btnVariants = """
        <StackButton Variant="default">Default</StackButton>
        <StackButton Variant="secondary">Secondary</StackButton>
        <StackButton Variant="outline">Outline</StackButton>
        <StackButton Variant="destructive">Destructive</StackButton>
        <StackButton Variant="ghost">Ghost</StackButton>
        <StackButton Variant="link">Link</StackButton>
        """;

    private const string _btnSizes = """
        <StackButton Size="sm">Small</StackButton>
        <StackButton Size="default">Default</StackButton>
        <StackButton Size="lg">Large</StackButton>
        <StackButton Size="icon" AriaLabel="Settings">...</StackButton>
        """;

    private const string _btnStates = """
        <StackButton IsLoading="_loading" OnClick="SimulateLoad">
            @(_loading ? "Saving..." : "Save Changes")
        </StackButton>
        <StackButton Variant="outline" Disabled>Disabled</StackButton>
        """;

    private const string _badges = """
        <StackBadge>Default</StackBadge>
        <StackBadge Variant="secondary">Secondary</StackBadge>
        <StackBadge Variant="destructive">Destructive</StackBadge>
        <StackBadge Variant="outline">Outline</StackBadge>
        """;

    private const string _chips = """
        <StackChip OnRemove="@(() => RemoveTag(tag))" RemoveLabel="@($"Remove {tag}")">@tag</StackChip>
        <StackChip Variant="success">Success</StackChip>
        <StackChip Variant="warning">Warning</StackChip>
        """;

    private const string _avatars = """
        <StackAvatar Initials="VS" Size="xs" />
        <StackAvatar Initials="AB" Size="sm" />
        <StackAvatar Initials="CD" />
        <StackAvatar Initials="EF" Size="lg" />
        <StackAvatar />
        """;

    private const string _spinners = """
        <StackSpinner Size="xs" />
        <StackSpinner Size="sm" />
        <StackSpinner />
        <StackSpinner Size="lg" />
        """;

    private const string _skeleton = """
        <StackSkeleton Class="h-10 w-10 rounded-full" />
        <StackSkeleton Class="h-4 w-full" />
        <StackSkeleton Class="h-4 w-4/5" />
        """;

    private const string _typographyCode = """
        <StackTypography Variant="h1">Heading 1</StackTypography>
        <StackTypography Variant="h2">Heading 2</StackTypography>
        <StackTypography Variant="lead">Lead paragraph</StackTypography>
        <StackTypography Variant="p">Body paragraph</StackTypography>
        <StackTypography Variant="muted">Muted text</StackTypography>
        <StackTypography Variant="blockquote">"A quote."</StackTypography>
        <StackTypography Variant="code">dotnet add package MyStackBlazor</StackTypography>
        """;

    private const string _labelCode = """
        <StackLabel For="email">Your email address</StackLabel>
        <StackInput Id="email" Type="email" Placeholder="you@example.com" />
        """;

    private const string _btnGroupCode = """
        <StackButtonGroup>
            <StackButton Variant="outline" Size="sm">Left</StackButton>
            <StackButton Variant="outline" Size="sm">Center</StackButton>
            <StackButton Variant="outline" Size="sm">Right</StackButton>
        </StackButtonGroup>
        """;

    private const string _toggleCode = """
        <StackToggleButton @bind-IsPressed="_bold">Bold</StackToggleButton>
        <StackToggleButton @bind-IsPressed="_italic">Italic</StackToggleButton>
        """;

    private const string _kbdCode = """
        <StackKbd Size="sm">⌘</StackKbd>
        <StackKbd>Ctrl</StackKbd>
        <StackKbd Size="lg">Alt</StackKbd>
        """;

    private const string _emptyCode = """
        <StackEmpty Title="No results found" Description="Try adjusting your search.">
            <Action><StackButton Size="sm" Variant="outline">Reset</StackButton></Action>
        </StackEmpty>
        """;

    private const string _dirCode = """
        <StackDirection Dir="ltr">Left-to-right content</StackDirection>
        <StackDirection Dir="rtl">محتوى من اليمين إلى اليسار</StackDirection>
        """;

    private const string _itemCode = """
        <StackItem Shortcut="⌘N">New File</StackItem>
        <StackItem Selected>Selected item</StackItem>
        <StackItem Disabled>Disabled item</StackItem>
        <StackItem Size="lg">Large item</StackItem>
        """;

    private const string _calloutCode = """
        <StackCallout Variant="Info" Title="Heads up">Informational message with context.</StackCallout>
        <StackCallout Variant="Tip">Pro tip: combine this with other components.</StackCallout>
        <StackCallout Variant="Warning" Title="Careful">May have unintended side effects.</StackCallout>
