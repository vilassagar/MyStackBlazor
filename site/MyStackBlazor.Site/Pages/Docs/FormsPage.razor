@page "/docs/forms"
@using System.ComponentModel.DataAnnotations

<PageTitle>Form Controls — MyStackBlazor Docs</PageTitle>

<h1 class="text-3xl font-bold mb-1">Form Controls</h1>
<p class="text-muted-foreground mb-8">Input, select, switch, slider, and more — all keyboard-accessible with two-way binding.</p>

<!-- Text Input -->
<CodeSample Title="Input"
             Description="Supports two-way binding. Use Type for email, password, number, etc."
             Code="@_inputCode">
    <div class="w-full max-w-sm space-y-3">
        <StackInput Placeholder="Your name" @bind-Value="_name" />
        <StackInput Placeholder="Email" Type="email" @bind-Value="_email" />
        <StackInput Placeholder="Disabled" Disabled />
        <StackInput Placeholder="Read-only" Value="Read-only value" ReadOnly />
        @if (!string.IsNullOrEmpty(_name))
        {
            <p class="text-sm text-muted-foreground">Hello, <strong>@_name</strong>!</p>
        }
    </div>
</CodeSample>

<!-- Textarea -->
<CodeSample Title="Textarea" Code="@_textareaCode">
    <div class="w-full max-w-sm">
        <StackTextarea Placeholder="Write a message..." @bind-Value="_message" Rows="4" />
        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="text-xs text-muted-foreground mt-1">@_message.Length characters</p>
        }
    </div>
</CodeSample>

<!-- Select -->
<CodeSample Title="Select" Code="@_selectCode">
    <div class="w-full max-w-sm">
        <StackSelect @bind-Value="_framework" Placeholder="Choose a framework">
            <option value="blazor">Blazor</option>
            <option value="maui">MAUI Blazor</option>
            <option value="server">Blazor Server</option>
            <option value="wasm">Blazor WASM</option>
        </StackSelect>
        @if (!string.IsNullOrEmpty(_framework))
        {
            <p class="text-sm text-muted-foreground mt-2">Selected: <strong>@_framework</strong></p>
        }
    </div>
</CodeSample>

<!-- Switch -->
<CodeSample Title="Switch" Code="@_switchCode">
    <div class="space-y-3 w-full max-w-sm">
        <StackSwitch Id="sw-notif" @bind-Checked="_notifications" Label="Enable notifications" />
        <StackSwitch Id="sw-dark" @bind-Checked="_darkMode" Label="Dark mode preview" />
        <StackSwitch Id="sw-disabled" Disabled Label="Disabled switch" />
        <p class="text-sm text-muted-foreground">
            Notifications: <strong>@(_notifications ? "on" : "off")</strong> &nbsp;|&nbsp;
            Dark mode: <strong>@(_darkMode ? "on" : "off")</strong>
        </p>
    </div>
</CodeSample>

<!-- Slider -->
<CodeSample Title="Slider" Code="@_sliderCode">
    <div class="w-full max-w-sm space-y-4">
        <div>
            <p class="text-sm font-medium mb-2">Volume: @_volume%</p>
            <StackSlider @bind-Value="_volume" Min="0" Max="100" Step="5" />
        </div>
        <div>
            <p class="text-sm font-medium mb-2">Brightness: @_brightness%</p>
            <StackSlider @bind-Value="_brightness" Min="0" Max="100" Step="10" />
        </div>
    </div>
</CodeSample>

<!-- Radio Group -->
<CodeSample Title="Radio Group" Code="@_radioCode">
    <div class="w-full max-w-sm space-y-6">
        <div>
            <p class="text-sm font-medium mb-2">Select a plan</p>
            <StackRadioGroup @bind-Value="_plan">
                <StackRadioGroupItem Value="free"       Label="Free — $0/month"         Id="plan-free" />
                <StackRadioGroupItem Value="pro"        Label="Pro — $9/month"          Id="plan-pro" />
                <StackRadioGroupItem Value="enterprise" Label="Enterprise — Contact us" Id="plan-enterprise" />
            </StackRadioGroup>
            @if (!string.IsNullOrEmpty(_plan))
            {
                <p class="text-sm text-muted-foreground mt-3">Selected: <strong>@_plan</strong></p>
            }
        </div>
        <div>
            <p class="text-sm font-medium mb-2">Disabled options</p>
            <StackRadioGroup Value="free">
                <StackRadioGroupItem Value="free"    Label="Available option"  Id="dis-free" />
                <StackRadioGroupItem Value="locked"  Label="Locked option"     Id="dis-locked"  Disabled />
                <StackRadioGroupItem Value="locked2" Label="Another locked"    Id="dis-locked2" Disabled />
            </StackRadioGroup>
        </div>
    </div>
</CodeSample>

<!-- Floating Label -->
<CodeSample Title="Floating Label"
             Description="Label animates above the input when focused or filled."
             Code="@_floatingCode">
    <div class="w-full max-w-sm space-y-4">
        <StackFloatingLabel Label="First name" @bind-Value="_floatName" />
        <StackFloatingLabel Label="Email" Type="email" @bind-Value="_floatEmail" />
        <StackFloatingLabel Label="Password" Type="password" @bind-Value="_floatPass" />
    </div>
</CodeSample>

<!-- NumericInput -->
<CodeSample Title="Numeric Input"
             Description="Number input with optional stepper buttons and min/max clamping."
             Code="@_numericCode">
    <div class="w-full max-w-xs space-y-4">
        <div>
            <StackLabel For="ni-qty">Quantity (1–99)</StackLabel>
            <StackNumericInput Id="ni-qty" @bind-Value="_quantity" Min="1" Max="99" Step="1" />
        </div>
        <div>
            <StackLabel For="ni-price">Price ($)</StackLabel>
            <StackNumericInput Id="ni-price" @bind-Value="_price" Min="0" Max="9999" Step="0.01" />
        </div>
        <div>
            <StackLabel For="ni-nospin">No stepper</StackLabel>
            <StackNumericInput Id="ni-nospin" @bind-Value="_quantity" ShowStepper="false" />
        </div>
        <p class="text-sm text-muted-foreground">Qty: <strong>@_quantity</strong> — Price: <strong>$@_price</strong></p>
    </div>
</CodeSample>

<!-- InputOtp -->
<CodeSample Title="OTP Input"
             Description="Auto-advances focus on each digit. GroupAt adds a visual separator."
             Code="@_otpCode">
    <div class="space-y-3">
        <div>
            <StackLabel>6-digit code (grouped 3+3)</StackLabel>
            <StackInputOtp Length="6" GroupAt="3" @bind-Value="_otp" />
        </div>
        <div>
            <StackLabel>4-digit PIN</StackLabel>
            <StackInputOtp Length="4" GroupAt="4" @bind-Value="_pin" />
        </div>
        @if (!string.IsNullOrEmpty(_otp))
        {
            <p class="text-sm text-muted-foreground">Code: <strong>@_otp</strong></p>
        }
    </div>
</CodeSample>

<!-- MaskedTextBox -->
<CodeSample Title="Masked Text Box"
             Description="Enforces an input pattern. 0=digit, a=letter, *=any character."
             Code="@_maskedCode">
    <div class="w-full max-w-xs space-y-4">
        <div>
            <StackLabel For="msk-phone">Phone (000-000-0000)</StackLabel>
            <StackMaskedTextBox Id="msk-phone" Mask="000-000-0000" @bind-Value="_maskedPhone" />
        </div>
        <div>
            <StackLabel For="msk-date">Date (DD/MM/YYYY)</StackLabel>
            <StackMaskedTextBox Id="msk-date" Mask="00/00/0000" @bind-Value="_maskedDate" />
        </div>
        <div>
            <StackLabel For="msk-card">Card number (0000 0000 0000 0000)</StackLabel>
            <StackMaskedTextBox Id="msk-card" Mask="0000 0000 0000 0000" @bind-Value="_maskedCard" />
        </div>
    </div>
</CodeSample>

<!-- FormField -->
<CodeSample Title="Form Field"
             Description="Wrapper that adds a Label, helper text, and error message around any input."
             Code="@_formFieldCode">
    <div class="w-full max-w-sm space-y-4">
        <StackFormField Label="Username" For="ff-user" Description="Only letters, numbers, and underscores.">
            <StackInput Id="ff-user" Placeholder="vilas_sagar" @bind-Value="_ffUsername" />
        </StackFormField>
        <StackFormField Label="Email" For="ff-email" Required ErrorMessage="@_ffEmailError">
            <StackInput Id="ff-email" Type="email" Placeholder="you@example.com" @bind-Value="_ffEmail" @onblur="ValidateEmail" />
        </StackFormField>
        <StackFormField Label="Notes" For="ff-notes" Description="Optional. Max 200 characters." Disabled="_ffDisabled">
            <StackTextarea Id="ff-notes" Placeholder="Any extra notes..." Disabled="_ffDisabled" />
        </StackFormField>
        <StackSwitch @bind-Checked="_ffDisabled" Label="Disable notes field" />
    </div>
</CodeSample>

<!-- MultiSelect -->
<CodeSample Title="Multi-Select Dropdown"
             Description="Searchable multi-select with tag pills, Select All, grouping, descriptions, keyboard navigation, and max-selection limit."
             Code="@_multiSelectCode">
    <div class="w-full max-w-2xl space-y-8">

        <!-- Basic -->
        <div class="space-y-2">
            <p class="text-sm font-semibold">Basic</p>
            <StackMultiSelect TItem="string"
                         Options="_countries"
                         @bind-SelectedItems="_selCountries"
                         ItemLabel="x => x"
                         Placeholder="Select countries…" />
            @if (_selCountries.Any())
            {
                <p class="text-xs text-muted-foreground">Selected: <strong>@string.Join(", ", _selCountries)</strong></p>
            }
        </div>

        <!-- With descriptions + groups -->
        <div class="space-y-2">
            <p class="text-sm font-semibold">With Groups &amp; Descriptions</p>
            <StackMultiSelect TItem="TechOption"
                         Options="_techOptions"
                         @bind-SelectedItems="_selTech"
                         ItemLabel="x => x.Name"
                         ItemDescription="x => x.Description"
                         ItemGroup="x => x.Group"
                         Placeholder="Select technologies…"
                         SearchPlaceholder="Search tech stack…" />
            @if (_selTech.Any())
            {
                <p class="text-xs text-muted-foreground">Selected: <strong>@string.Join(", ", _selTech.Select(t => t.Name))</strong></p>
            }
        </div>

        <!-- Max selection + custom template -->
        <div class="space-y-2">
            <p class="text-sm font-semibold">Max 3 Selections + Custom Item Template</p>
            <StackMultiSelect TItem="TeamMember"
                         Options="_teamMembers"
                         @bind-SelectedItems="_selMembers"
                         ItemLabel="m => m.Name"
                         MaxSelection="3"
                         Placeholder="Assign up to 3 members…">
                <ItemTemplate Context="m">
                    <div class="flex items-center gap-2">
                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white"
                              style="background-color: @m.AvatarColor;">
                            @m.Initials
                        </span>
                        <div>
                            <div class="text-sm font-medium leading-tight">@m.Name</div>
                            <div class="text-xs text-muted-foreground">@m.Role</div>
                        </div>
                    </div>
                </ItemTemplate>
            </StackMultiSelect>
            @if (_selMembers.Any())
            {
                <p class="text-xs text-muted-foreground">Assigned: <strong>@string.Join(", ", _selMembers.Select(m => m.Name))</strong></p>
            }
        </div>

        <!-- Disabled state -->
        <div class="space-y-2">
            <p class="text-sm font-semibold">Disabled</p>
            <StackMultiSelect TItem="string"
                         Options="_countries"
                         SelectedItems='new List<string> { "India", "Germany" }'
                         Placeholder="Disabled multi-select"
                         Disabled="true" />
        </div>
    </div>
</CodeSample>

<!-- ListBox -->
<CodeSample Title="List Box"
             Description="Scrollable selection list. Set MultiSelect for multiple picks."
             Code="@_listboxCode">
    <div class="flex flex-wrap gap-6">
        <div>
            <StackLabel>Single select</StackLabel>
            <StackListBox TItem="string"
                     Items="_frameworks"
                     @bind-Value="_selectedFramework"
                     ItemLabel="x => x"
                     Height="160px"
                     Class="w-48" />
            @if (_selectedFramework is not null)
            {
                <p class="text-xs text-muted-foreground mt-1">Selected: <strong>@_selectedFramework</strong></p>
            }
        </div>
        <div>
            <StackLabel>Multi select</StackLabel>
            <StackListBox TItem="string"
                     Items="_frameworks"
                     MultiSelect
                     @bind-SelectedItems="_selectedFrameworks"
                     ItemLabel="x => x"
                     Height="160px"
                     Class="w-48" />
            @if (_selectedFrameworks?.Count > 0)
            {
                <p class="text-xs text-muted-foreground mt-1">@string.Join(", ", _selectedFrameworks)</p>
            }
        </div>
    </div>
</CodeSample>

<!-- InputGroup -->
<CodeSample Title="Input Group"
             Description="Wraps an Input with a text prefix, suffix, or both. Size matches the inner input."
             Code="@_inputGroupCode">
    <div class="w-full max-w-sm space-y-3">
        <div>
            <p class="text-xs text-muted-foreground mb-1">Small — URL prefix</p>
            <StackInputGroup Size="sm">
                <Prefix><span>https://</span></Prefix>
                <ChildContent><StackInput Placeholder="example.com" /></ChildContent>
            </StackInputGroup>
        </div>
        <div>
            <p class="text-xs text-muted-foreground mb-1">Medium — currency prefix + suffix</p>
            <StackInputGroup>
                <Prefix><span>$</span></Prefix>
                <ChildContent><StackInput Placeholder="0.00" Type="number" /></ChildContent>
                <Suffix><span>USD</span></Suffix>
            </StackInputGroup>
        </div>
        <div>
            <p class="text-xs text-muted-foreground mb-1">Large — email suffix</p>
            <StackInputGroup Size="lg">
                <ChildContent><StackInput Placeholder="username" /></ChildContent>
                <Suffix><span>@@example.com</span></Suffix>
            </StackInputGroup>
        </div>
    </div>
</CodeSample>

<!-- PhoneInput -->
<CodeSample Title="Phone Input"
             Description="Country-code dropdown combined with a tel input. Defaults to +91."
             Code="@_phoneCode">
    <div class="w-full max-w-sm space-y-3">
        <StackPhoneInput @bind-Value="_phone" @bind-DialCode="_dialCode" Size="sm" />
        <StackPhoneInput @bind-Value="_phone" @bind-DialCode="_dialCode" />
        <StackPhoneInput @bind-Value="_phone" @bind-DialCode="_dialCode" Size="lg" />
        <StackPhoneInput Disabled Placeholder="Disabled" />
        @if (!string.IsNullOrEmpty(_phone))
        {
            <p class="text-sm text-muted-foreground">Number: <strong>@_dialCode @_phone</strong></p>
        }
    </div>
</CodeSample>

<!-- NativeSelect -->
<CodeSample Title="Native Select"
             Description="Native HTML &lt;select&gt; with consistent Tailwind styling. Use Size for sm / md / lg."
             Code="@_nativeSelectCode">
    <div class="w-full max-w-sm space-y-3">
        <StackNativeSelect Size="sm" Placeholder="Small — pick a colour" @bind-Value="_nativeColor">
            <option value="red">Red</option>
            <option value="green">Green</option>
            <option value="blue">Blue</option>
        </StackNativeSelect>
        <StackNativeSelect Placeholder="Medium — pick a framework" @bind-Value="_nativeFramework">
            <option value="blazor">Blazor</option>
            <option value="react">React</option>
            <option value="vue">Vue</option>
        </StackNativeSelect>
        <StackNativeSelect Size="lg" Placeholder="Large — pick a country" @bind-Value="_nativeCountry">
            <option value="us">United States</option>
            <option value="uk">United Kingdom</option>
            <option value="au">Australia</option>
        </StackNativeSelect>
        @if (!string.IsNullOrEmpty(_nativeFramework))
        {
            <p class="text-sm text-muted-foreground">Framework: <strong>@_nativeFramework</strong></p>
        }
    </div>
</CodeSample>

<!-- MonthYearPicker -->
<CodeSample Title="Month Year Picker"
             Description="Select a month and year. Displays full month names in a 3×4 grid with year navigation arrows."
             Code="@_monthYearPickerCode">
    <div class="w-full max-w-xs space-y-3">
        <StackMonthYearPicker @bind-Value="_selectedMonthYear" Placeholder="Pick month & year" />
        @if (_selectedMonthYear.HasValue)
        {
            <p class="text-sm text-muted-foreground">Selected: <strong>@_selectedMonthYear.Value.ToString("MMMM yyyy")</strong></p>
        }
    </div>
</CodeSample>

<!-- ColorPalette -->
<CodeSample Title="Color Palette"
             Description="Click a swatch to select a color. ShowHex displays the selected hex value."
             Code="@_colorCode">
    <div class="space-y-4">
        <StackColorPalette Label="Brand color" @bind-Value="_brandColor" ShowHex />
        <StackColorPalette Label="Accent color" @bind-Value="_accentColor" ShowHex
                      Colors="@(new[] { "#ef4444","#f97316","#eab308","#22c55e","#3b82f6","#8b5cf6","#ec4899" })" />
    </div>
</CodeSample>

<!-- PasswordInput -->
<CodeSample Title="Password Input"
             Description="Text input with a show/hide visibility toggle button."
             Code="@_passwordCode">
    <div class="w-full max-w-sm space-y-3">
        <StackPasswordInput Id="pwd-1" Placeholder="Password" @bind-Value="_password" />
        <StackPasswordInput Id="pwd-2" Placeholder="Disabled" Disabled />
        @if (!string.IsNullOrEmpty(_password))
        {
            <p class="text-sm text-muted-foreground">Value: <strong>@_password</strong></p>
        }
    </div>
</CodeSample>

<!-- CurrencyInput -->
<CodeSample Title="Currency Input"
             Description="Numeric input formatted with a currency symbol and thousands separators, with optional stepper buttons and min/max clamping."
             Code="@_currencyCode">
    <div class="w-full max-w-xs space-y-4">
        <div>
            <StackLabel For="cur-price">Price (USD)</StackLabel>
            <StackCurrencyInput Id="cur-price" @bind-Value="_currencyPrice" Min="0" Max="9999" Step="1" />
        </div>
        <div>
            <StackLabel For="cur-eur">Amount (EUR, no stepper)</StackLabel>
            <StackCurrencyInput Id="cur-eur" @bind-Value="_currencyAmount" CurrencySymbol="€" DecimalPlaces="2" ShowStepper="false" />
        </div>
        <p class="text-sm text-muted-foreground">Price: <strong>@_currencyPrice</strong></p>
    </div>
</CodeSample>

<!-- EnumInput -->
<CodeSample Title="Enum Input"
             Description="Binds directly to a C# enum. Mode=&quot;Select&quot; renders a dropdown, Mode=&quot;Radio&quot; renders a radio group. Option labels honor [Display(Name = ...)]."
             Code="@_enumCode">
    <div class="w-full max-w-sm space-y-6">
        <div>
            <StackLabel>Status (Select)</StackLabel>
            <StackEnumInput TEnum="DemoStatus" @bind-Value="_status" />
            <p class="text-sm text-muted-foreground mt-1">Selected: <strong>@_status</strong></p>
        </div>
        <div>
            <StackLabel>Status (Radio)</StackLabel>
            <StackEnumInput TEnum="DemoStatus" Mode="Radio" @bind-Value="_statusRadio" />
            <p class="text-sm text-muted-foreground mt-1">Selected: <strong>@_statusRadio</strong></p>
        </div>
    </div>
</CodeSample>

<!-- Validation -->
<CodeSample Title="Validation"
             Description="EditForm + DataAnnotationsValidator, with StackValidationSummary for form-level errors and StackValidationMessage for per-field errors."
             Code="@_validationCode">
    <EditForm Model="_signupModel" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" class="w-full max-w-sm space-y-4">
        <DataAnnotationsValidator />
        <StackValidationSummary />

        <div class="space-y-1.5">
            <label class="text-sm font-medium" for="signup-name">Full name</label>
            <StackInput Id="signup-name" @bind-Value="_signupModel.FullName" Placeholder="Jane Doe" />
            <StackValidationMessage For="@(() => _signupModel.FullName)" />
        </div>

        <div class="space-y-1.5">
            <label class="text-sm font-medium" for="signup-email">Email</label>
            <StackInput Id="signup-email" Type="email" @bind-Value="_signupModel.Email" Placeholder="jane@example.com" />
            <StackValidationMessage For="@(() => _signupModel.Email)" />
        </div>

        <div class="space-y-1.5">
            <label class="text-sm font-medium" for="signup-age">Age</label>
            <StackNumericInput Id="signup-age" @bind-Value="_signupModel.Age" Min="1" Max="120" Step="1" />
            <StackValidationMessage For="@(() => _signupModel.Age)" />
        </div>

        <StackButton Type="submit">Create account</StackButton>

        @if (_signupSubmitted)
        {
            <p class="text-sm text-green-600 dark:text-green-400">Account created for <strong>@_signupModel.FullName</strong>.</p>
        }
    </EditForm>
</CodeSample>

@code {
    private string? _name;
    private string? _email;
    private string? _floatName;
    private string? _floatEmail;
    private string? _floatPass;
    private double? _quantity = 1;
    private double? _price = 9.99;
    private string? _otp;
    private string? _pin;
    private string? _maskedPhone;
    private string? _maskedDate;
    private string? _maskedCard;
    private string? _ffUsername;
    private string? _ffEmail;
    private string? _ffEmailError;
    private bool _ffDisabled;
    private string? _selectedFramework;
    private IList<string>? _selectedFrameworks;

    // ── MultiSelect data ─────────────────────────────────────────────────────
    private IList<string> _selCountries = new List<string>();
    private IList<TechOption> _selTech = new List<TechOption>();
    private IList<TeamMember> _selMembers = new List<TeamMember>();

    private record TechOption(string Name, string Group, string Description);
    private record TeamMember(string Name, string Role, string Initials, string AvatarColor);

    private readonly List<string> _countries =
    [
        "Australia", "Brazil", "Canada", "China", "France",
        "Germany", "India", "Japan", "Mexico", "Nigeria",
        "South Korea", "Spain", "United Kingdom", "United States", "Vietnam",
    ];

    private readonly List<TechOption> _techOptions =
    [
        new("React",      "Frontend",  "UI library by Meta"),
        new("Vue",        "Frontend",  "Progressive JS framework"),
        new("Angular",    "Frontend",  "Full-featured SPA framework"),
        new("Svelte",     "Frontend",  "Compiler-based framework"),
        new("Blazor",     "Frontend",  ".NET web UI framework"),
        new("Node.js",    "Backend",   "JS runtime on V8"),
        new("ASP.NET",    "Backend",   "Cross-platform web framework"),
        new("Django",     "Backend",   "Python web framework"),
        new("FastAPI",    "Backend",   "Modern Python API framework"),
        new("PostgreSQL", "Database",  "Advanced open-source RDBMS"),
        new("MongoDB",    "Database",  "Document-oriented NoSQL DB"),
        new("Redis",      "Database",  "In-memory data structure store"),
        new("Docker",     "DevOps",    "Container platform"),
        new("Kubernetes", "DevOps",    "Container orchestration"),
        new("GitHub CI",  "DevOps",    "GitHub Actions CI/CD"),
    ];

    private readonly List<TeamMember> _teamMembers =
    [
        new("Alice Chen",    "Engineering Lead",    "AC", "#3b82f6"),
        new("Bob Martinez",  "Senior Developer",    "BM", "#22c55e"),
        new("Carol Smith",   "UX Designer",         "CS", "#a855f7"),
        new("Dave Johnson",  "Product Manager",     "DJ", "#f97316"),
        new("Eve Williams",  "QA Engineer",         "EW", "#ec4899"),
        new("Frank Lee",     "DevOps Engineer",     "FL", "#14b8a6"),
        new("Grace Park",    "Data Scientist",      "GP", "#eab308"),
        new("Henry Brown",   "Security Engineer",   "HB", "#ef4444"),
    ];

    private string? _phone;
    private string _dialCode = "+91";

    private DateTime? _selectedMonthYear;

    private string? _brandColor = "#3b82f6";
    private string? _accentColor = "#8b5cf6";
    private string? _nativeColor;
    private string? _nativeFramework;
    private string? _nativeCountry;
    private readonly List<string> _frameworks = ["Blazor WASM", "Blazor Server", "MAUI Blazor", "Blazor United", ".NET 10"];

    private void ValidateEmail()
        => _ffEmailError = !string.IsNullOrEmpty(_ffEmail) && !_ffEmail.Contains('@')
            ? "Please enter a valid email address."
            : null;
    private string? _message;
    private string? _framework;
    private bool _notifications = true;
    private bool _darkMode;
    private double _volume = 60;
    private double _brightness = 80;
    private string? _plan = "pro";

    private const string _inputCode = """
        <StackInput Placeholder="Your name" @bind-Value="_name" />
        <StackInput Placeholder="Email" Type="email" @bind-Value="_email" />
        <StackInput Placeholder="Disabled" Disabled />
        """;

    private const string _textareaCode = """
        <StackTextarea Placeholder="Write a message..." @bind-Value="_message" Rows="4" />
        """;

    private const string _selectCode = """
        <StackSelect @bind-Value="_framework" Placeholder="Choose a framework">
            <option value="blazor">Blazor</option>
            <option value="maui">MAUI Blazor</option>
        </StackSelect>
        """;

    private const string _switchCode = """
        <StackSwitch Id="sw-notif" @bind-Checked="_notifications" Label="Enable notifications" />
        <StackSwitch Id="sw-dark"  @bind-Checked="_darkMode"      Label="Dark mode preview" />
        """;

    private const string _sliderCode = """
        <StackSlider @bind-Value="_volume" Min="0" Max="100" Step="5" />
        """;

