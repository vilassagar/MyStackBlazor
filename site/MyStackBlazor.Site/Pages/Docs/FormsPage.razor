    // ── Validation demo ─────────────────────────────────────────────────────
    private readonly SignupModel _signupModel = new();
    private bool _signupSubmitted;

    private void HandleValidSubmit() => _signupSubmitted = true;
    private void HandleInvalidSubmit() => _signupSubmitted = false;

    private sealed class SignupModel
    {
        [Required(ErrorMessage = "Full name is required.")]
        [StringLength(50, ErrorMessage = "Name must be 50 characters or fewer.")]
        public string? FullName { get; set; }

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? Email { get; set; }

        [Range(1, 120, ErrorMessage = "Age must be between 1 and 120.")]
        public double? Age { get; set; }
    }

    private const string _validationCode = """
        <EditForm Model="_signupModel" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <StackValidationSummary />

            <StackInput @bind-Value="_signupModel.FullName" Placeholder="Jane Doe" />
            <StackValidationMessage For="@(() => _signupModel.FullName)" />

            <StackInput Type="email" @bind-Value="_signupModel.Email" />
            <StackValidationMessage For="@(() => _signupModel.Email)" />

            <StackButton Type="submit">Create account</StackButton>
        </EditForm>

        public class SignupModel
        {
            [Required] public string? FullName { get; set; }
            [Required, EmailAddress] public string? Email { get; set; }
            [Range(1, 120)] public double? Age { get; set; }
        }
        """;
