@namespace MyStackBlazor.Site.Shared
@inject IJSRuntime JS

<div class="rounded-lg border bg-card mb-6 @Class">
    <div class="px-6 py-5">
        <h3 class="font-semibold mb-0.5">@Title</h3>
        @if (!string.IsNullOrEmpty(Description))
        {
            <p class="text-sm text-muted-foreground mb-4">@Description</p>
        }
        <div class="demo-row mt-3">
            @ChildContent
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Code))
    {
        <details class="border-t rounded-b-lg overflow-hidden" open="@CodeOpenByDefault">
            <summary class="px-6 py-2 flex items-center justify-between text-xs text-muted-foreground cursor-pointer hover:text-foreground select-none">
                <span>Code</span>
                <button type="button"
                        class="rounded-md border px-2 py-1 text-xs hover:bg-accent hover:text-accent-foreground transition-colors"
                        @onclick="CopyCodeAsync" @onclick:stopPropagation="true">
                    @(_copied ? "Copied!" : "Copy")
                </button>
            </summary>
            <pre class="bg-muted/50 px-6 py-4 text-xs overflow-x-auto m-0"><code>@Code</code></pre>
        </details>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool CodeOpenByDefault { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _copied;

    private async Task CopyCodeAsync()
    {
        if (string.IsNullOrEmpty(Code))
        {
            return;
        }

        _copied = await JS.InvokeAsync<bool>("MyStackBlazorSite.copyText", Code);
        StateHasChanged();

        if (_copied)
        {
            await Task.Delay(1500);
            _copied = false;
            StateHasChanged();
        }
    }
}
